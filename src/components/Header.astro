---
---
<header class="bg-white shadow-sm sticky top-0 z-[100]">
  <div class="max-w-[1400px] mx-auto px-4 flex justify-between items-center h-20">
    <a href="/" class="flex items-center flex-shrink-0">
      <img src="/images/logo.webp" 
           alt="Leipzig Photovoltaik Logo" 
           class="h-12 w-auto"
           width="200"
           height="111"
           loading="eager" />
    </a>
    
    <nav class="hidden md:flex space-x-4 lg:space-x-6 xl:space-x-8 items-center text-sm lg:text-base">
      <a href="/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Home</a>
      <a href="/solaranlage-leipzig/" class="text-[var(--senec-turquoise)] font-bold hover:text-[var(--senec-blue)] transition-colors">Solaranlage Leipzig</a>
      <a href="/privat/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Privat</a>
      
      <!-- Gewerbe Dropdown -->
      <div class="relative group">
        <a href="/gewerbe/" class="flex items-center text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">
          Gewerbe
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div class="absolute left-0 mt-2 w-56 bg-white rounded-md shadow-lg py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform z-50">
          <a href="/gewerbe/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Übersicht</a>
          <a href="/gewerbe-photovoltaik-leipzig/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Gewerbe PV Leipzig</a>
          <a href="/solarpark-betreuung/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Solarpark Betreuung</a>
        </div>
      </div>
      
      <!-- Service Dropdown -->
      <div class="relative group">
        <a href="/service/" class="flex items-center text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">
          Service
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div class="absolute left-0 mt-2 w-56 bg-white rounded-md shadow-lg py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform z-50">
          <a href="/service/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Übersicht</a>
          <a href="/pv-wartung-leipzig/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">PV Wartung Leipzig</a>
          <a href="/pv-reinigung-leipzig/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">PV Reinigung Leipzig</a>
        </div>
      </div>
      
      <a href="/wallbox/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Wallbox</a>
      <a href="/stromspeicher/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Stromspeicher</a>
      
      <!-- Ratgeber Dropdown -->
      <div class="relative group">
        <button class="flex items-center text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors focus:outline-none">
          Ratgeber
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute left-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform z-50">
          <a href="/ratgeber/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Übersicht</a>
          <a href="/ratgeber/kosten/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Kosten</a>
          <a href="/ratgeber/foerderung/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Förderung</a>
          <a href="/ratgeber/wirtschaftlichkeit/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[var(--senec-turquoise)]">Wirtschaftlichkeit</a>
        </div>
      </div>

      <a href="/faq/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">FAQ</a>
      <a href="/blog/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Blog</a>
      <a href="/standorte/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Standorte</a>
      <a href="/referenzen/" class="text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] transition-colors">Referenzen</a>
    </nav>
    
    <div class="hidden lg:block flex-shrink-0">
      <a href="/kontakt/" class="btn-primary whitespace-nowrap">
        Angebot anfordern
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-[var(--senec-blue)] focus:outline-none" aria-label="Menü öffnen">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 py-4 px-6 space-y-3 max-h-[calc(var(--vh)*80)] overflow-y-auto">
    <a href="/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Home</a>
    <a href="/solaranlage-leipzig/" class="block text-center text-lg text-[var(--senec-turquoise)] font-bold hover:text-[var(--senec-blue)] py-2 bg-gray-50 rounded-lg">Solaranlage Leipzig</a>
    <a href="/privat/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Privat</a>
    
    <!-- Gewerbe Mobile -->
    <div class="border-t border-gray-100 pt-2 mt-2">
      <p class="text-sm font-bold text-gray-400 uppercase mb-2 text-center">Gewerbe</p>
      <a href="/gewerbe/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Übersicht</a>
      <a href="/gewerbe-photovoltaik-leipzig/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Gewerbe PV Leipzig</a>
      <a href="/solarpark-betreuung/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Solarpark Betreuung</a>
    </div>
    
    <!-- Service Mobile -->
    <div class="border-t border-gray-100 pt-2 mt-2">
      <p class="text-sm font-bold text-gray-400 uppercase mb-2 text-center">Service</p>
      <a href="/service/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Übersicht</a>
      <a href="/pv-wartung-leipzig/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">PV Wartung Leipzig</a>
      <a href="/pv-reinigung-leipzig/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">PV Reinigung Leipzig</a>
    </div>
    
    <a href="/wallbox/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Wallbox</a>
    <a href="/stromspeicher/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Stromspeicher</a>
    
    <div class="border-t border-gray-100 pt-2 mt-2">
      <p class="text-sm font-bold text-gray-400 uppercase mb-2 text-center">Ratgeber</p>
      <a href="/ratgeber/kosten/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Kosten</a>
      <a href="/ratgeber/foerderung/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Förderung</a>
      <a href="/ratgeber/wirtschaftlichkeit/" class="block py-2 text-center text-lg text-[var(--senec-blue)] hover:text-[var(--senec-turquoise)]">Wirtschaftlichkeit</a>
    </div>
    <a href="/faq/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">FAQ</a>
    <a href="/blog/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Blog</a>
    <a href="/standorte/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Standorte</a>
    <a href="/referenzen/" class="block text-center text-lg text-[var(--senec-blue)] font-medium hover:text-[var(--senec-turquoise)] py-2">Referenzen</a>
    <a href="/kontakt/" class="btn-primary text-center mt-4">Angebot anfordern</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
