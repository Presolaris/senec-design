---
import '../styles/global.css';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
}

const { 
	title, 
	description = "Ihr Experte für Photovoltaik, Stromspeicher und Wallboxen in Leipzig und Umgebung.",
	image = "/images/photovoltaik-leipzig-solar-experte-og.jpg",
	type = "website"
} = Astro.props;

// Canonical URL für og:url
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://leipzig-photovoltaik.de");
const ogImageURL = new URL(image, Astro.site || "https://leipzig-photovoltaik.de");
---

<!doctype html>
<html lang="de" class="scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		
		<!-- Favicons -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		
		<!-- OpenGraph Tags für Social Media -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content="Presolaris - Photovoltaik Leipzig" />
		
		<!-- Twitter Card Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		
		<!-- Preconnect für externe Ressourcen -->
		<link rel="preconnect" href="https://quldnodtstkyroctqjbs.supabase.co" crossorigin />
		<link rel="dns-prefetch" href="https://quldnodtstkyroctqjbs.supabase.co" />
		
		<!-- Preload LCP Image -->
		<link rel="preload" as="image" href="/images/hero-home.webp" fetchpriority="high" />
		
		<!-- System Fonts - keine externen Anfragen, kein CLS -->
		
		<!-- Google Analytics & Google Cloud API Key entfernt für Performance (97/100 Mobile) -->
		<script>
			// Echte Viewport-Höhe für Mobile-Browser (iOS Safari, Chrome Android)
			function setVH() {
				const vh = window.innerHeight * 0.01;
				document.documentElement.style.setProperty('--vh', `${vh}px`);
			}
			setVH();
			window.addEventListener('resize', setVH);
			window.addEventListener('orientationchange', setVH);
		</script>
		
		<!-- CTA Tracking Script -->
		<script>
			import { initCTATracking } from '../lib/ctaTracking';
			initCTATracking();
		</script>
	</head>
	<body class="font-sans antialiased text-gray-900 bg-white overflow-x-hidden">
		<slot />
		<ExitIntentPopup />
		<CookieBanner />
	</body>
</html>
