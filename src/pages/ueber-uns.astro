      "name": "Markkleeberg"
    },
    {
      "@type": "City",
      "name": "Dresden"
    },
    {
      "@type": "City",
      "name": "Erfurt"
    }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  ],
  "priceRange": "€€-€€€€",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "127",
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "https://www.facebook.com/photovoltaikleipzig",
    "https://www.instagram.com/photovoltaikleipzig"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Solaranlagen & Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Photovoltaikanlage für Einfamilienhäuser",
          "description": "Komplettlösung für Ihr Eigenheim: Beratung, Planung, Installation und Inbetriebnahme."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Photovoltaikanlage für Gewerbe & Industrie",
          "description": "Maßgeschneiderte PV-Lösungen für Unternehmen."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Stromspeicher-Installation",
          "description": "Moderne Batteriespeicher von BYD, Huawei und RCT Power."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Wallbox-Installation",
          "description": "Laden Sie Ihr Elektroauto zuhause mit eigenem Solarstrom."
        }
      }
    ]
  }
};

// Dienstleistungen
const services = [
  {
    title: "Photovoltaikanlage für Einfamilienhäuser",
    description: "Komplettlösung für Ihr Eigenheim: Beratung, Planung, Installation und Inbetriebnahme. Senken Sie Ihre Stromkosten um bis zu 80%.",
    icon: "🏠"
  },
  {
    title: "Photovoltaikanlage für Gewerbe & Industrie",
    description: "Maßgeschneiderte PV-Lösungen für Unternehmen. Große Dachflächen optimal nutzen und Betriebskosten nachhaltig reduzieren.",
    icon: "🏭"
  },
  {
    title: "Solarpark / Freiflächenanlage",
    description: "Planung und Realisierung von Solarparks. Profitieren Sie von attraktiven Renditen durch Direktvermarktung oder Eigenverbrauch.",
    icon: "🌾"
  },
  {
    title: "Batteriespeicher-Installation",
    description: "Moderne Stromspeicher von BYD, Huawei und RCT Power. Maximieren Sie Ihren Eigenverbrauch und werden Sie unabhängig.",
    icon: "🔋"
  },
  {
    title: "Wallbox-Installation",
    description: "Laden Sie Ihr Elektroauto zuhause mit eigenem Solarstrom. Wir installieren Wallboxen aller führenden Hersteller.",
    icon: "🚗"
  },
  {
    title: "Kostenlose Erstberatung",
    description: "Unverbindliche Beratung vor Ort oder telefonisch. Wir analysieren Ihr Dach und erstellen ein individuelles Angebot.",
    icon: "📋"
  }
];

// FAQs
const faqs = [
  {
    question: "Was kostet eine Solaranlage bei Photovoltaik Leipzig?",
    answer: "Die Kosten hängen von Dachgröße und Ihrem Strombedarf ab. Wir bieten Komplettlösungen für jedes Budget – günstiger als Sie denken! Vereinbaren Sie eine kostenlose Beratung für ein individuelles Angebot."
  },
  {
    question: "Bietet Photovoltaik Leipzig auch Stromspeicher an?",
    answer: "Ja, wir installieren moderne Batteriespeicher aller führenden Hersteller wie BYD, Huawei und RCT Power. So nutzen Sie Ihren Solarstrom auch nachts und erreichen bis zu 80% Eigenverbrauch."
  },
  {
    question: "Wie lange dauert die Installation einer Solaranlage?",
    answer: "Die reine Montage dauert meist nur 1-3 Tage. Von der Beratung bis zur Inbetriebnahme vergehen in der Regel 4-8 Wochen – schneller als bei vielen Mitbewerbern."
  },
  {
    question: "Installiert Photovoltaik Leipzig auch Wallboxen?",
    answer: "Ja, wir bieten Wallboxen und Ladestationen für Elektroautos an – ideal in Kombination mit Ihrer Solaranlage. Laden Sie Ihr E-Auto mit eigenem Solarstrom!"
  },
  {
    question: "In welchen Regionen ist Photovoltaik Leipzig tätig?",
    answer: "Wir sind in Leipzig und der gesamten Region tätig: Halle, Delitzsch, Markkleeberg, Dresden, Erfurt und weitere Standorte in Sachsen und Thüringen. Kurze Wege, schneller Service."
  },
  {
    question: "Gibt es Fördermöglichkeiten für Solaranlagen?",
    answer: "Ja, es gibt attraktive Förderprogramme von Bund und Land. Wir beraten Sie kostenlos zu allen aktuellen Fördermöglichkeiten und übernehmen die Antragstellung für Sie."
  },
  {
    question: "Kann ich mit einer Solaranlage wirklich Geld sparen?",
    answer: "Absolut! Mit einer Photovoltaikanlage senken Sie Ihre Stromkosten um bis zu 80%. Die Investition amortisiert sich in der Regel nach 8-12 Jahren – danach produzieren Sie quasi kostenlosen Strom für 20+ Jahre."
  },
  {
    question: "Warum sollte ich Photovoltaik Leipzig wählen?",
    answer: "Über 2.400 zufriedene Kunden, mehr als 10 Jahre Erfahrung, zertifizierte Fachkräfte und persönliche Betreuung vor Ort. Wir sind Ihr regionaler Partner – keine anonyme Hotline, sondern echte Menschen."
  }
];

// Standorte
const locations = [
  { name: "Leipzig", url: "/standorte/leipzig/" },
  { name: "Halle (Saale)", url: "/standorte/halle/" },
  { name: "Delitzsch", url: "/standorte/photovoltaik-delitzsch/" },
  { name: "Markkleeberg", url: "/standorte/photovoltaik-markkleeberg/" },
  { name: "Dresden", url: "/standorte/dresden/" },
  { name: "Erfurt", url: "/standorte/erfurt/" }
];
---

<Layout title={pageTitle} description={pageDescription} image="/images/og/photovoltaik-anbieter-leipzig-standort.jpg">
  <Header />
  
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white py-20 lg:py-28">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
            Ihr zertifizierter <span class="text-yellow-400">Solarexperte</span> in Leipzig
          </h1>
          <p class="text-xl md:text-2xl text-blue-100 mb-8 max-w-3xl mx-auto">
            Kostenlose Beratung – Professionelle Planung – Fachgerechte Umsetzung
          </p>
          <p class="text-lg text-blue-200 mb-10">
            Seit über einem Jahrzehnt für Sie vor Ort. Über <strong class="text-white">2.400 zufriedene Kunden</strong> vertrauen uns bereits.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/kontakt/" class="inline-flex items-center justify-center px-8 py-4 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold rounded-lg transition-all transform hover:scale-105 shadow-lg">
              Kostenlose Beratung anfordern
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <a href="tel:+4934112345678" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg border-2 border-white/30 transition-all">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              Jetzt anrufen
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Badges -->
    <section class="bg-white py-8 border-b">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-blue-600">2.400+</div>
            <div class="text-sm text-gray-600">Zufriedene Kunden</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-blue-600">10+</div>
            <div class="text-sm text-gray-600">Jahre Erfahrung</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-yellow-500">4.9 ★</div>
            <div class="text-sm text-gray-600">Google Bewertung</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-green-600">80%</div>
            <div class="text-sm text-gray-600">Stromkosten sparen</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Kurzbeschreibung -->
    <section class="py-16 lg:py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-center mb-8 text-gray-900">
            Photovoltaik Leipzig – Ihr Partner für Solarenergie
          </h2>
          <div class="bg-white rounded-2xl shadow-lg p-8 md:p-10">
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              <strong>Photovoltaik Leipzig</strong> ist Ihr zertifizierter Solarexperte in der Region. Seit über einem Jahrzehnt bieten wir <strong>kostenlose Beratung</strong>, professionelle Planung und fachgerechte Umsetzung von Solaranlagen für Privat, Gewerbe und Solarparks.
            </p>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              Unser erfahrenes Team begleitet Sie von der ersten Beratung bis zur fertigen Anlage – <strong>alles aus einer Hand</strong>. Über 2.400 zufriedene Kunden vertrauen uns bereits.
            </p>
            <p class="text-xl text-blue-600 font-semibold text-center">
              Günstiger als Sie denken – Fordern Sie jetzt Ihr unverbindliches Angebot an!
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dienstleistungen -->
    <section class="py-16 lg:py-20 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">
          Unsere Dienstleistungen
        </h2>
        <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
          Von der Beratung bis zur Inbetriebnahme – wir bieten Ihnen das komplette Leistungsspektrum
        </p>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {services.map((service) => (
            <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow border border-gray-100">
              <div class="text-4xl mb-4">{service.icon}</div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
              <p class="text-gray-600">{service.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 lg:py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">
          Häufig gestellte Fragen
        </h2>
        <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
          Antworten auf die wichtigsten Fragen rund um Photovoltaik in Leipzig
        </p>
        
        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((faq, index) => (
            <details class="bg-white rounded-xl shadow-sm border border-gray-100 group">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <h3 class="text-lg font-semibold text-gray-900 pr-4">{faq.question}</h3>
                <svg class="w-5 h-5 text-blue-600 transform group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-600 leading-relaxed">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Standorte -->
    <section class="py-16 lg:py-20 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">
          Unsere Standorte
        </h2>
        <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
          Wir sind in Leipzig und der gesamten Region für Sie da
        </p>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {locations.map((location) => (
            <a href={location.url} class="bg-gray-50 hover:bg-blue-50 rounded-xl p-4 text-center transition-colors border border-gray-100 hover:border-blue-200">
              <svg class="w-8 h-8 mx-auto mb-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="font-semibold text-gray-900">{location.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 lg:py-20 bg-gradient-to-br from-blue-600 to-blue-800 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            Bereit für Ihre eigene Solaranlage?
          </h2>
          <p class="text-xl text-blue-100 mb-8">
            Vereinbaren Sie jetzt Ihre kostenlose und unverbindliche Beratung. Wir analysieren Ihr Dach und erstellen ein individuelles Angebot – günstiger als Sie denken!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/kontakt/" class="inline-flex items-center justify-center px-8 py-4 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold rounded-lg transition-all transform hover:scale-105 shadow-lg">
              Kostenlose Beratung anfordern
            </a>
            <a href="tel:+4934112345678" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg border-2 border-white/30 transition-all">
              0341 - 123 456 78
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
