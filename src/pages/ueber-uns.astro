---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Über Uns | Photovoltaik Leipzig - Ihr zertifizierter Solarexperte";
const pageDescription = "Photovoltaik Leipzig ist Ihr zertifizierter Solarexperte seit über einem Jahrzehnt. Kostenlose Beratung, professionelle Planung und fachgerechte Umsetzung. Über 2.400 zufriedene Kunden.";

// FAQ Schema für strukturierte Daten
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet eine Solaranlage bei Photovoltaik Leipzig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten hängen von Dachgröße und Ihrem Strombedarf ab. Wir bieten Komplettlösungen für jedes Budget – günstiger als Sie denken! Vereinbaren Sie eine kostenlose Beratung für ein individuelles Angebot."
      }
    },
    {
      "@type": "Question",
      "name": "Bietet Photovoltaik Leipzig auch Stromspeicher an?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, wir installieren moderne Batteriespeicher aller führenden Hersteller wie BYD, Huawei und RCT Power. So nutzen Sie Ihren Solarstrom auch nachts und erreichen bis zu 80% Eigenverbrauch."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Installation einer Solaranlage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die reine Montage dauert meist nur 1-3 Tage. Von der Beratung bis zur Inbetriebnahme vergehen in der Regel 4-8 Wochen – schneller als bei vielen Mitbewerbern."
      }
    },
    {
      "@type": "Question",
      "name": "Installiert Photovoltaik Leipzig auch Wallboxen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, wir bieten Wallboxen und Ladestationen für Elektroautos an – ideal in Kombination mit Ihrer Solaranlage. Laden Sie Ihr E-Auto mit eigenem Solarstrom!"
      }
    },
    {
      "@type": "Question",
      "name": "In welchen Regionen ist Photovoltaik Leipzig tätig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir sind in Leipzig und der gesamten Region tätig: Halle, Delitzsch, Markkleeberg, Dresden, Erfurt und weitere Standorte in Sachsen und Thüringen. Kurze Wege, schneller Service."
      }
    },
    {
      "@type": "Question",
      "name": "Gibt es Fördermöglichkeiten für Solaranlagen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, es gibt attraktive Förderprogramme von Bund und Land. Wir beraten Sie kostenlos zu allen aktuellen Fördermöglichkeiten und übernehmen die Antragstellung für Sie."
      }
    },
    {
      "@type": "Question",
      "name": "Kann ich mit einer Solaranlage wirklich Geld sparen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolut! Mit einer Photovoltaikanlage senken Sie Ihre Stromkosten um bis zu 80%. Die Investition amortisiert sich in der Regel nach 8-12 Jahren – danach produzieren Sie quasi kostenlosen Strom für 20+ Jahre."
      }
    },
    {
      "@type": "Question",
      "name": "Warum sollte ich Photovoltaik Leipzig wählen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Über 2.400 zufriedene Kunden, mehr als 10 Jahre Erfahrung, zertifizierte Fachkräfte und persönliche Betreuung vor Ort. Wir sind Ihr regionaler Partner – keine anonyme Hotline, sondern echte Menschen."
      }
    }
  ]
};

// LocalBusiness Schema
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://leipzig-photovoltaik.de/#organization",
  "name": "Photovoltaik Leipzig | Solaranlagen & Stromspeicher",
  "alternateName": "Photovoltaik Leipzig",
  "description": "Ihr zertifizierter Solarexperte in Leipzig. Seit über einem Jahrzehnt bieten wir kostenlose Beratung, professionelle Planung und fachgerechte Umsetzung von Solaranlagen für Privat, Gewerbe und Solarparks.",
  "url": "https://leipzig-photovoltaik.de/",
  "telephone": "+49 341 12345678",
  "email": "info@leipzig-photovoltaik.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Musterstraße 1",
    "addressLocality": "Leipzig",
    "postalCode": "04109",
    "addressRegion": "Sachsen",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 51.3397,
    "longitude": 12.3731
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Leipzig"
    },
    {
      "@type": "City",
      "name": "Halle (Saale)"
    },
    {
      "@type": "City",
