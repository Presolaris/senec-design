---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Gewerbe', href: '/gewerbe' },
  { label: 'Gewerbe Photovoltaik Leipzig' }
];

const pageTitle = "Gewerbe Photovoltaik Leipzig | PV-Anlagen für Unternehmen & Industrie";
const pageDescription = "Gewerbe Photovoltaik Leipzig ✓ Solaranlage für Unternehmen ✓ Industrie PV-Anlagen ✓ Bis 40% Rendite ✓ 6-8 Jahre Amortisation ✓ Kostenlose Beratung → Jetzt anfragen!";
---

<Layout title={pageTitle} description={pageDescription}>
  <LocalBusinessSchema />
  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-gray-900 text-white overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/gewerbe-hero.jpg" alt="Gewerbe Photovoltaik Leipzig - Große PV-Anlage auf Industriehalle" class="w-full h-full object-cover opacity-40" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent"></div>
      </div>
      
      <div class="relative z-10 py-24 md:py-32">
        <div class="container-custom mx-auto">
          <div class="max-w-3xl">
            <span class="text-[var(--senec-yellow)] font-bold tracking-wider uppercase mb-4 block">Ihr Partner in Leipzig</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Gewerbe Photovoltaik Leipzig – <br/>
              <span class="text-[var(--senec-turquoise)]">Solaranlage für Ihr Unternehmen</span>
            </h1>
            <p class="text-xl text-gray-300 mb-8 leading-relaxed">
              Senken Sie Ihre Stromkosten um bis zu 70% mit einer maßgeschneiderten <strong>Gewerbe-Solaranlage in Leipzig</strong>. 
              Als regionaler Fachbetrieb planen und installieren wir PV-Anlagen für Industrie, Handel und Landwirtschaft.
            </p>
            
            <div class="flex flex-wrap gap-4 mb-8">
              <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-[var(--senec-yellow)] font-bold">2.400+</span>
                <span class="text-gray-300 text-sm ml-1">Anlagen</span>
              </div>
              <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-[var(--senec-yellow)] font-bold">4,9★</span>
                <span class="text-gray-300 text-sm ml-1">Bewertung</span>
              </div>
              <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-[var(--senec-yellow)] font-bold">15+</span>
                <span class="text-gray-300 text-sm ml-1">Jahre</span>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#kontakt" class="btn-primary text-center">Kostenlose Beratung</a>
              <a href="#vorteile" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-gray-900 text-center">Vorteile</a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="relative z-10 py-6 bg-[#0D1D37] border-t border-gray-700">
        <div class="container-custom mx-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-[var(--senec-yellow)] mb-1">6-8 Jahre</div>
              <div class="text-gray-400 text-sm">Amortisation</div>
            </div>
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-[var(--senec-turquoise)] mb-1">bis 40%</div>
              <div class="text-gray-400 text-sm">Rendite</div>
            </div>
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-white mb-1">25+ Jahre</div>
              <div class="text-gray-400 text-sm">Garantie</div>
            </div>
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-[var(--senec-yellow)] mb-1">0% MwSt.</div>
              <div class="text-gray-400 text-sm">auf PV</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Vorteile Section -->
    <section id="vorteile" class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-4">Warum Gewerbe Photovoltaik in Leipzig?</h2>
          <p class="text-gray-600 text-lg">Leipzig bietet ideale Voraussetzungen: Über 1.600 Sonnenstunden pro Jahr und attraktive Förderprogramme.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--senec-blue)]/10 text-[var(--senec-blue)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Stromkosten senken</h3>
            <p class="text-gray-600">Produzieren Sie Strom für 8-10 Cent/kWh statt 30+ Cent vom Versorger. Bei 100.000 kWh sparen Sie über 20.000€/Jahr.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--senec-turquoise)]/10 text-[var(--senec-turquoise)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Unabhängigkeit</h3>
            <p class="text-gray-600">Machen Sie sich unabhängig von steigenden Strompreisen. Mit Speicher erreichen Sie bis zu 80% Autarkie.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--senec-yellow)]/10 text-[var(--senec-yellow)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Steuervorteile</h3>
            <p class="text-gray-600">Nutzen Sie Sonderabschreibungen, Investitionsabzugsbetrag und 0% MwSt. auf PV-Anlagen.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--senec-blue)]/10 text-[var(--senec-blue)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Nachhaltigkeit</h3>
            <p class="text-gray-600">Verbessern Sie Ihre CO₂-Bilanz und erfüllen Sie ESG-Kriterien für Kunden und Partner.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--senec-turquoise)]/10 text-[var(--senec-turquoise)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Wertsteigerung</h3>
            <p class="text-gray-600">Eine PV-Anlage steigert den Wert Ihrer Immobilie bei Verkauf oder Vermietung.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--senec-yellow)]/10 text-[var(--senec-yellow)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">E-Mobilität</h3>
            <p class="text-gray-600">Laden Sie Firmenfahrzeuge mit eigenem Solarstrom. Wallboxen für Mitarbeiter inklusive.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Branchen -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-12 text-center">Gewerbe-Photovoltaik für jede Branche</h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--senec-blue)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--senec-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Produktion</h3>
            <p class="text-sm text-gray-600">Große Dachflächen</p>
          </div>

          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--senec-turquoise)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--senec-turquoise)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Handel</h3>
            <p class="text-sm text-gray-600">Lagerhallen, Märkte</p>
          </div>

          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--senec-yellow)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--senec-yellow)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Landwirtschaft</h3>
            <p class="text-sm text-gray-600">Scheunen, Ställe</p>
          </div>

          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--senec-blue)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--senec-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Büro</h3>
            <p class="text-sm text-gray-600">Dienstleistung</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Rechenbeispiel -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-6">Rechenbeispiel: 100 kWp Anlage</h2>
            <p class="text-gray-600 mb-8">Eine typische Gewerbe-Photovoltaikanlage in Leipzig mit 100 kWp auf einer Lagerhalle.</p>
            
            <div class="space-y-4">
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="text-gray-600">Anlagenleistung</span>
                <span class="font-bold text-[var(--senec-blue)]">100 kWp</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="text-gray-600">Jahresertrag</span>
                <span class="font-bold text-[var(--senec-blue)]">~95.000 kWh</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="text-gray-600">Eigenverbrauch</span>
                <span class="font-bold text-[var(--senec-blue)]">70%</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="text-gray-600">Jährliche Ersparnis</span>
                <span class="font-bold text-[var(--senec-turquoise)]">~18.000 €</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="text-gray-600">Investition (netto)</span>
                <span class="font-bold text-[var(--senec-blue)]">~110.000 €</span>
              </div>
              <div class="flex justify-between items-center py-3 bg-[var(--senec-blue)]/5 px-4 rounded-lg">
                <span class="font-bold text-[var(--senec-blue)]">Amortisation</span>
                <span class="font-bold text-[var(--senec-turquoise)] text-xl">~6 Jahre</span>
              </div>
            </div>
          </div>
          
          <div class="bg-gray-50 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-6">Ihre Vorteile</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700"><strong>0% MwSt.</strong> auf Kauf und Installation</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700"><strong>Sonderabschreibung</strong> 20% im ersten Jahr</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700"><strong>KfW-Förderung</strong> für Speicher und Wallboxen</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700"><strong>25 Jahre Garantie</strong> auf Module</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="kontakt" class="py-24 bg-[#0D1D37]">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto text-center text-white">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Kostenlose Potenzialanalyse</h2>
          <p class="text-lg text-gray-300 mb-10">Senden Sie uns Ihre Eckdaten für eine erste Wirtschaftlichkeitsberechnung.</p>
          
          <form class="max-w-xl mx-auto space-y-4 text-left" action="https://web3forms.com/api/submit" method="POST">
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
            <input type="hidden" name="subject" value="Gewerbe-PV Anfrage Leipzig" />
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Firmenname *</label>
                <input type="text" name="company" required class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--senec-turquoise)] outline-none" placeholder="Muster GmbH" />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Ansprechpartner *</label>
                <input type="text" name="contact" required class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--senec-turquoise)] outline-none" placeholder="Max Mustermann" />
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">E-Mail *</label>
                <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--senec-turquoise)] outline-none" placeholder="info@firma.de" />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Telefon</label>
                <input type="tel" name="phone" class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--senec-turquoise)] outline-none" placeholder="0341 1234567" />
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Dachfläche (ca. m²)</label>
                <input type="text" name="roof_size" class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--senec-turquoise)] outline-none" placeholder="z.B. 1.000 m²" />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Jahresverbrauch (kWh)</label>
                <input type="text" name="consumption" class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--senec-turquoise)] outline-none" placeholder="z.B. 80.000 kWh" />
              </div>
            </div>
            
            <button type="submit" class="w-full btn-primary py-4 text-lg">Potenzialanalyse anfordern</button>
            <p class="text-xs text-gray-400 text-center">Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline">Datenschutzerklärung</a> zu.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- Interne Verlinkung -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-2xl font-bold text-[var(--senec-blue)] mb-8 text-center">Weitere Services</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/pv-wartung-leipzig" class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow group">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2 group-hover:text-[var(--senec-turquoise)]">PV Wartung Leipzig →</h3>
            <p class="text-sm text-gray-600">Professionelle Wartung für Ihre Gewerbe-Anlage</p>
          </a>
          <a href="/pv-reinigung-leipzig" class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow group">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2 group-hover:text-[var(--senec-turquoise)]">PV Reinigung Leipzig →</h3>
