            <button type="submit" class="w-full btn-primary py-4 text-lg">Potenzialanalyse anfordern</button>
            <p class="text-xs text-gray-400 text-center">Mit dem Absenden stimmen Sie unserer <a href="/datenschutz/" class="underline">Datenschutzerklärung</a> zu.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- Interne Verlinkung -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-8 text-center">Weitere Services</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/pv-wartung-leipzig/" class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow group">
