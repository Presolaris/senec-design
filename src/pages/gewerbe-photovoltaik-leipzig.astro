              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Telefon</label>
                <input type="tel" name="phone" class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--primary-turquoise)] outline-none" placeholder="0341 1234567" />
