<script>
  // Wirtschaftlichkeitsrechner Logik
  const dachflaecheInput = document.getElementById('dachflaeche') as HTMLInputElement;
  const stromverbrauchInput = document.getElementById('stromverbrauch') as HTMLInputElement;
  const strompreisInput = document.getElementById('strompreis') as HTMLInputElement;
  const eigenverbrauchInput = document.getElementById('eigenverbrauch') as HTMLInputElement;

  const dachflaecheValue = document.getElementById('dachflaeche-value');
  const stromverbrauchValue = document.getElementById('stromverbrauch-value');
  const strompreisValue = document.getElementById('strompreis-value');
  const eigenverbrauchValue = document.getElementById('eigenverbrauch-value');

  const resultAnlagengroesse = document.getElementById('result-anlagengroesse');
  const resultJahresertrag = document.getElementById('result-jahresertrag');
  const resultErsparnis = document.getElementById('result-ersparnis');
  const resultInvestition = document.getElementById('result-investition');
  const resultAmortisation = document.getElementById('result-amortisation');
  const result20Jahre = document.getElementById('result-20jahre');

  function formatNumber(num: number): string {
    return num.toLocaleString('de-DE');
  }

  function berechneWirtschaftlichkeit() {
    const dachflaeche = parseInt(dachflaecheInput.value);
    const stromverbrauch = parseInt(stromverbrauchInput.value);
    const strompreis = parseInt(strompreisInput.value);
    const eigenverbrauchQuote = parseInt(eigenverbrauchInput.value) / 100;

    // Update Anzeige-Werte
    if (dachflaecheValue) dachflaecheValue.textContent = formatNumber(dachflaeche) + ' m²';
    if (stromverbrauchValue) stromverbrauchValue.textContent = formatNumber(stromverbrauch) + ' kWh';
    if (strompreisValue) strompreisValue.textContent = strompreis + ' Ct/kWh';
    if (eigenverbrauchValue) eigenverbrauchValue.textContent = (eigenverbrauchQuote * 100) + '%';

    // Berechnungen
    // Ca. 10m² pro kWp, aber max. sinnvolle Größe basierend auf Verbrauch
    const maxKwpNachFlaeche = Math.floor(dachflaeche / 10);
    const optimalKwpNachVerbrauch = Math.ceil(stromverbrauch / 950); // 950 kWh/kWp in Leipzig
    const anlagengroesse = Math.min(maxKwpNachFlaeche, optimalKwpNachVerbrauch * 1.2); // 20% Puffer

    const jahresertrag = Math.round(anlagengroesse * 950);
    const eigenverbrauchKwh = Math.round(jahresertrag * eigenverbrauchQuote);
    const einspeisungKwh = jahresertrag - eigenverbrauchKwh;

    // Ersparnis durch Eigenverbrauch (Strompreis - Gestehungskosten ca. 8 Cent)
    const ersparnisEigenverbrauch = eigenverbrauchKwh * (strompreis - 8) / 100;
    // Einnahmen durch Einspeisung (ca. 8 Cent/kWh)
    const einnahmenEinspeisung = einspeisungKwh * 0.08;
    const jaehrlicheErsparnis = Math.round(ersparnisEigenverbrauch + einnahmenEinspeisung);

    // Investition (ca. 1.100€/kWp für Gewerbeanlagen)
    const investition = Math.round(anlagengroesse * 1100);

    // Amortisation
    const amortisation = investition / jaehrlicheErsparnis;

    // 20 Jahre Ersparnis (mit 2% Strompreissteigerung)
    let gesamtersparnis20Jahre = 0;
    for (let i = 0; i < 20; i++) {
      gesamtersparnis20Jahre += jaehrlicheErsparnis * Math.pow(1.02, i);
    }

    // Update Ergebnisse
    if (resultAnlagengroesse) resultAnlagengroesse.textContent = Math.round(anlagengroesse) + ' kWp';
    if (resultJahresertrag) resultJahresertrag.textContent = formatNumber(jahresertrag) + ' kWh';
    if (resultErsparnis) resultErsparnis.textContent = formatNumber(jaehrlicheErsparnis) + ' €';
    if (resultInvestition) resultInvestition.textContent = formatNumber(investition) + ' €';
    if (resultAmortisation) resultAmortisation.textContent = amortisation.toFixed(1) + ' Jahre';
    if (result20Jahre) result20Jahre.textContent = formatNumber(Math.round(gesamtersparnis20Jahre)) + ' €';
  }

  // Event Listener
  dachflaecheInput?.addEventListener('input', berechneWirtschaftlichkeit);
  stromverbrauchInput?.addEventListener('input', berechneWirtschaftlichkeit);
  strompreisInput?.addEventListener('input', berechneWirtschaftlichkeit);
  eigenverbrauchInput?.addEventListener('input', berechneWirtschaftlichkeit);

  // Initial berechnen
  berechneWirtschaftlichkeit();

  // ========== ERWEITERTES RECHNER-TRACKING ==========
  
  // Track Rechner-Aufruf (Scroll in Sichtbereich)
  const rechnerSection = document.getElementById('rechner');
  let rechnerViewed = false;
  
  const rechnerObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !rechnerViewed) {
        rechnerViewed = true;
        // Google Analytics Event
        if (typeof gtag !== 'undefined') {
          gtag('event', 'rechner_view', {
            'event_category': 'Wirtschaftlichkeitsrechner',
            'event_label': 'Gewerbe PV Rechner',
            'page_location': window.location.href
          });
        }
        console.log('[Tracking] Rechner in Sichtbereich');
      }
    });
  }, { threshold: 0.5 });
  
  if (rechnerSection) rechnerObserver.observe(rechnerSection);

  // Track Slider-Interaktionen (mit Debounce)
  let sliderTimeout: ReturnType<typeof setTimeout>;
  let interactionCount = 0;
  
  function trackSliderInteraction(sliderName: string, value: string) {
    interactionCount++;
    
    clearTimeout(sliderTimeout);
    sliderTimeout = setTimeout(() => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'rechner_slider_change', {
          'event_category': 'Wirtschaftlichkeitsrechner',
          'event_label': sliderName,
          'value': value,
          'interaction_count': interactionCount
        });
      }
      console.log(`[Tracking] Slider: ${sliderName} = ${value}`);
    }, 1000); // Debounce 1 Sekunde
  }

  dachflaecheInput?.addEventListener('change', () => {
    trackSliderInteraction('Dachfläche', dachflaecheInput.value + ' m²');
  });
  
  stromverbrauchInput?.addEventListener('change', () => {
    trackSliderInteraction('Stromverbrauch', stromverbrauchInput.value + ' kWh');
  });
  
  strompreisInput?.addEventListener('change', () => {
    trackSliderInteraction('Strompreis', strompreisInput.value + ' Ct/kWh');
  });
  
  eigenverbrauchInput?.addEventListener('change', () => {
    trackSliderInteraction('Eigenverbrauch', eigenverbrauchInput.value + '%');
  });

  // Track Berechnung-Abschluss (alle Slider wurden mindestens einmal bewegt)
  const slidersUsed = new Set<string>();
  let calculationCompleted = false;
  
  function checkCalculationComplete() {
    if (slidersUsed.size >= 2 && !calculationCompleted) {
      calculationCompleted = true;
      
      // Erfasse finale Werte
      const finalValues = {
        dachflaeche: dachflaecheInput?.value,
        stromverbrauch: stromverbrauchInput?.value,
        strompreis: strompreisInput?.value,
        eigenverbrauch: eigenverbrauchInput?.value,
        ergebnis_anlagengroesse: resultAnlagengroesse?.textContent,
        ergebnis_ersparnis: resultErsparnis?.textContent,
        ergebnis_amortisation: resultAmortisation?.textContent
      };
      
      if (typeof gtag !== 'undefined') {
        gtag('event', 'rechner_calculation_complete', {
          'event_category': 'Wirtschaftlichkeitsrechner',
          'event_label': 'Gewerbe PV Berechnung abgeschlossen',
          ...finalValues
        });
      }
      console.log('[Tracking] Berechnung abgeschlossen:', finalValues);
    }
  }

  dachflaecheInput?.addEventListener('change', () => {
    slidersUsed.add('dachflaeche');
    checkCalculationComplete();
  });
  
  stromverbrauchInput?.addEventListener('change', () => {
    slidersUsed.add('stromverbrauch');
    checkCalculationComplete();
  });
  
  strompreisInput?.addEventListener('change', () => {
    slidersUsed.add('strompreis');
    checkCalculationComplete();
  });
  
  eigenverbrauchInput?.addEventListener('change', () => {
    slidersUsed.add('eigenverbrauch');
    checkCalculationComplete();
  });

  // Track CTA-Klick nach Rechner-Nutzung
  const ctaButton = document.querySelector('a[href="#kontakt"]');
  ctaButton?.addEventListener('click', () => {
    if (interactionCount > 0) {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'rechner_cta_click', {
          'event_category': 'Wirtschaftlichkeitsrechner',
          'event_label': 'Angebot anfordern nach Rechner',
          'interaction_count': interactionCount,
          'calculation_completed': calculationCompleted
        });
      }
      console.log('[Tracking] CTA nach Rechner-Nutzung geklickt');
    }
  });
</script>

