---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Gewerbe', href: '/gewerbe' },
  { label: 'Gewerbe Photovoltaik Leipzig' }
];

const pageTitle = "Gewerbe Photovoltaik Leipzig | PV-Anlagen";
const pageDescription = "Gewerbe Photovoltaik Leipzig ✓ Solaranlage für Unternehmen ✓ Bis 40% Rendite ✓ 6-8 Jahre Amortisation → Jetzt anfragen!";
---

<Layout title={pageTitle} description={pageDescription}>
  <LocalBusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"position": 2, "name": "Gewerbe Photovoltaik Leipzig", "item": "https://leipzig-photovoltaik.de/gewerbe-photovoltaik-leipzig/"}]})}/>
<Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-gray-900 text-white overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/gewerbe-hero.jpg" alt="Gewerbe Photovoltaik Leipzig - Große PV-Anlage auf Industriehalle" class="w-full h-full object-cover opacity-40" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent"></div>
      </div>
      
      <div class="relative z-10 py-24 md:py-32">
        <div class="container-custom mx-auto">
          <div class="max-w-3xl">
            <span class="text-[var(--primary-yellow)] font-bold tracking-wider uppercase mb-4 block">Ihr Partner in Leipzig</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Gewerbe Photovoltaik Leipzig – <br/>
              <span class="text-[var(--primary-turquoise)]">Solaranlage für Ihr Unternehmen</span>
            </h1>
            <p class="text-xl text-gray-300 mb-8 leading-relaxed">
              Bis zu 70% weniger Stromkosten – das ist mit einer <strong>Gewerbe-Solaranlage in Leipzig</strong> möglich. Wir sind vor Ort und kennen die Region. Ob Produktionshalle, Lagergebäude oder Landwirtschaft: Wir planen und bauen Ihre PV-Anlage.
            </p>
            
            <div class="flex flex-wrap gap-4 mb-8">
              <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-[var(--primary-yellow)] font-bold">2.400+</span>
                <span class="text-gray-300 text-sm ml-1">Anlagen</span>
              </div>
              <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-[var(--primary-yellow)] font-bold">4,9★</span>
                <span class="text-gray-300 text-sm ml-1">Bewertung</span>
              </div>
              <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-[var(--primary-yellow)] font-bold">15+</span>
                <span class="text-gray-300 text-sm ml-1">Jahre</span>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#rechner" class="btn-primary text-center">Wirtschaftlichkeit berechnen</a>
              <a href="#vorteile" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-gray-900 text-center">Vorteile</a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="relative z-10 py-6 bg-white border-t border-gray-200">
        <div class="container-custom mx-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-gray-900 mb-1">6-8 Jahre</div>
              <div class="text-gray-600 text-sm">Amortisation</div>
            </div>
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-gray-900 mb-1">bis 40%</div>
              <div class="text-gray-600 text-sm">Rendite</div>
            </div>
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-gray-900 mb-1">25+ Jahre</div>
              <div class="text-gray-600 text-sm">Garantie</div>
            </div>
            <div class="p-4">
              <div class="text-2xl md:text-3xl font-bold text-gray-900 mb-1">0% MwSt.</div>
              <div class="text-gray-600 text-sm">auf PV</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wirtschaftlichkeitsrechner -->
    <section id="rechner" class="py-20 bg-gradient-to-br from-[#0D1D37] to-[#1a3a5c]">
      <div class="container-custom mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Wirtschaftlichkeitsrechner für Gewerbe-PV</h2>
          <p class="text-gray-300 text-lg">Wie viel können Sie sparen? Finden Sie es in wenigen Sekunden heraus.</p>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2">
              <!-- Eingabe-Bereich -->
              <div class="p-8 bg-gray-50">
                <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-6">Ihre Angaben</h3>
                
                <div class="space-y-6">
                  <!-- Dachfläche -->
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">
                      Verfügbare Dachfläche
                      <span class="font-normal text-gray-500">(m²)</span>
                    </label>
                    <div class="relative">
                      <input 
                        type="range" 
                        id="dachflaeche" 
                        min="200" 
                        max="10000" 
                        value="1000" 
                        step="100"
                        class="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[var(--primary-turquoise)]"
                      />
                      <div class="flex justify-between text-xs text-gray-500 mt-1">
                        <span>200 m²</span>
                        <span id="dachflaeche-value" class="text-lg font-bold text-[var(--primary-blue)]">1.000 m²</span>
                        <span>10.000 m²</span>
                      </div>
                    </div>
                  </div>

                  <!-- Stromverbrauch -->
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">
                      Jährlicher Stromverbrauch
                      <span class="font-normal text-gray-500">(kWh)</span>
                    </label>
                    <div class="relative">
                      <input 
                        type="range" 
                        id="stromverbrauch" 
                        min="10000" 
                        max="500000" 
                        value="80000" 
                        step="5000"
                        class="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[var(--primary-turquoise)]"
                      />
                      <div class="flex justify-between text-xs text-gray-500 mt-1">
                        <span>10.000 kWh</span>
                        <span id="stromverbrauch-value" class="text-lg font-bold text-[var(--primary-blue)]">80.000 kWh</span>
                        <span>500.000 kWh</span>
                      </div>
                    </div>
                  </div>

                  <!-- Strompreis -->
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">
                      Aktueller Strompreis
                      <span class="font-normal text-gray-500">(Cent/kWh)</span>
                    </label>
                    <div class="relative">
                      <input 
                        type="range" 
                        id="strompreis" 
                        min="20" 
                        max="50" 
                        value="32" 
                        step="1"
                        class="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[var(--primary-turquoise)]"
                      />
                      <div class="flex justify-between text-xs text-gray-500 mt-1">
                        <span>20 Ct</span>
                        <span id="strompreis-value" class="text-lg font-bold text-[var(--primary-blue)]">32 Ct/kWh</span>
                        <span>50 Ct</span>
                      </div>
                    </div>
                  </div>

                  <!-- Eigenverbrauchsquote -->
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">
                      Erwarteter Eigenverbrauch
                      <span class="font-normal text-gray-500">(%)</span>
                    </label>
                    <div class="relative">
                      <input 
                        type="range" 
                        id="eigenverbrauch" 
                        min="30" 
                        max="90" 
                        value="70" 
                        step="5"
                        class="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[var(--primary-turquoise)]"
                      />
                      <div class="flex justify-between text-xs text-gray-500 mt-1">
                        <span>30%</span>
                        <span id="eigenverbrauch-value" class="text-lg font-bold text-[var(--primary-blue)]">70%</span>
                        <span>90%</span>
                      </div>
                    </div>
                  </div>
                </div>

                <p class="text-xs text-gray-500 mt-6">
                  * Berechnungen basieren auf Durchschnittswerten für Leipzig (950 kWh/kWp). 
                  Die tatsächlichen Werte können je nach Ausrichtung und Verschattung abweichen.
                </p>
              </div>

              <!-- Ergebnis-Bereich -->
              <div class="p-8 bg-[#0D1D37] text-white">
                <h3 class="text-xl font-bold mb-6">Ihr Einsparpotenzial</h3>
                
                <div class="space-y-4">
                  <!-- Anlagengröße -->
                  <div class="bg-white/10 rounded-xl p-4">
                    <div class="flex justify-between items-center">
                      <span class="text-gray-300">Empfohlene Anlagengröße</span>
                      <span id="result-anlagengroesse" class="text-2xl font-bold text-[var(--primary-yellow)]">100 kWp</span>
                    </div>
                  </div>

                  <!-- Jahresertrag -->
                  <div class="bg-white/10 rounded-xl p-4">
                    <div class="flex justify-between items-center">
                      <span class="text-gray-300">Erwarteter Jahresertrag</span>
                      <span id="result-jahresertrag" class="text-2xl font-bold text-white">95.000 kWh</span>
                    </div>
                  </div>

                  <!-- Jährliche Ersparnis -->
                  <div class="bg-white/10 rounded-xl p-4 border-2 border-[var(--primary-turquoise)]">
                    <div class="flex justify-between items-center">
                      <span class="text-gray-300">Jährliche Ersparnis</span>
                      <span id="result-ersparnis" class="text-3xl font-bold text-[var(--primary-turquoise)]">21.280 €</span>
                    </div>
                  </div>

                  <!-- Investition -->
                  <div class="bg-white/10 rounded-xl p-4">
                    <div class="flex justify-between items-center">
                      <span class="text-gray-300">Geschätzte Investition</span>
                      <span id="result-investition" class="text-2xl font-bold text-white">110.000 €</span>
                    </div>
                  </div>

                  <!-- Amortisation -->
                  <div class="bg-[var(--primary-yellow)] rounded-xl p-4">
                    <div class="flex justify-between items-center">
                      <span class="text-[var(--primary-blue)] font-bold">Amortisation</span>
                      <span id="result-amortisation" class="text-3xl font-bold text-[var(--primary-blue)]">5,2 Jahre</span>
                    </div>
                  </div>

                  <!-- 20 Jahre Ersparnis -->
                  <div class="bg-white/5 rounded-xl p-4 mt-6">
                    <div class="text-center">
                      <span class="text-gray-400 text-sm block mb-1">Gesamtersparnis über 20 Jahre</span>
                      <span id="result-20jahre" class="text-4xl font-bold text-[var(--primary-turquoise)]">425.600 €</span>
                    </div>
                  </div>
                </div>

                <a href="#kontakt" class="btn-primary w-full mt-6 text-center block">
                  Kostenloses Angebot anfordern
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Vorteile Section -->
    <section id="vorteile" class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-4">Warum Gewerbe Photovoltaik in Leipzig?</h2>
          <p class="text-gray-600 text-lg">Leipzig bietet ideale Voraussetzungen: Über 1.600 Sonnenstunden pro Jahr und attraktive Förderprogramme.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Stromkosten senken</h3>
            <p class="text-gray-600">Produzieren Sie Strom für 8-10 Cent/kWh statt 30+ Cent vom Versorger. Bei 100.000 kWh sparen Sie über 20.000€/Jahr.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-turquoise)]/10 text-[var(--primary-turquoise)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Unabhängigkeit</h3>
            <p class="text-gray-600">Machen Sie sich unabhängig von steigenden Strompreisen. Mit Speicher erreichen Sie bis zu 80% Autarkie.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-yellow)]/10 text-[var(--primary-yellow)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Steuervorteile</h3>
            <p class="text-gray-600">Sonderabschreibungen, Investitionsabzugsbetrag, 0% MwSt. – das Finanzamt unterstützt Ihre Investition.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Nachhaltigkeit</h3>
            <p class="text-gray-600">Ihre CO₂-Bilanz wird besser, ESG-Kriterien erfüllen Sie nebenbei. Kunden und Partner schätzen das.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-turquoise)]/10 text-[var(--primary-turquoise)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Wertsteigerung</h3>
            <p class="text-gray-600">Ihre Immobilie wird wertvoller – bei Verkauf oder Vermietung zahlt sich die PV-Anlage doppelt aus.</p>
          </div>

          <div class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-yellow)]/10 text-[var(--primary-yellow)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">E-Mobilität</h3>
            <p class="text-gray-600">Firmenfahrzeuge mit eigenem Strom laden? Klar. Wallboxen für Mitarbeiter gibt's auf Wunsch dazu.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Branchen -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-12 text-center">Gewerbe-Photovoltaik für jede Branche</h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--primary-blue)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--primary-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Produktion</h3>
            <p class="text-sm text-gray-600">Große Dachflächen</p>
          </div>

          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--primary-turquoise)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--primary-turquoise)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Handel</h3>
            <p class="text-sm text-gray-600">Lagerhallen, Märkte</p>
          </div>

          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--primary-yellow)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--primary-yellow)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Landwirtschaft</h3>
            <p class="text-sm text-gray-600">Scheunen, Ställe</p>
          </div>

          <div class="bg-white rounded-xl p-6 shadow-sm text-center">
            <div class="w-16 h-16 bg-[var(--primary-blue)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[var(--primary-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Büro</h3>
            <p class="text-sm text-gray-600">Dienstleistung</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="kontakt" class="py-24 bg-[#0D1D37]">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto text-center text-white">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Kostenlose Potenzialanalyse</h2>
          <p class="text-lg text-gray-300 mb-10">Schicken Sie uns ein paar Eckdaten – wir rechnen für Sie durch, was möglich ist.</p>
          
          <form class="max-w-xl mx-auto space-y-4 text-left" action="https://web3forms.com/api/submit" method="POST">
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
            <input type="hidden" name="subject" value="Gewerbe-PV Anfrage Leipzig" />
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-gray-300 mb-2">Firmenname *</label>
                <input type="text" name="company" required class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:ring-2 focus:ring-[var(--primary-turquoise)] outline-none" placeholder="Muster GmbH" />
              </div>
              <div>
