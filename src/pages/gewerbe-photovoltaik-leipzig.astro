            <p class="text-sm text-gray-600">Professionelle Wartung für Ihre Gewerbe-Anlage</p>
          </a>
          <a href="/pv-reinigung-leipzig/" class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow group">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2 group-hover:text-[var(--primary-turquoise)]">PV Reinigung Leipzig →</h3>
            <p class="text-sm text-gray-600">Schonende Reinigung für maximalen Ertrag</p>
          </a>
          <a href="/solarpark-betreuung/" class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow group">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2 group-hover:text-[var(--primary-turquoise)]">Solarpark Betreuung →</h3>
