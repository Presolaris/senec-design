---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Referenzen' }
];

const pageTitle = "Referenzen Photovoltaik Leipzig | Zufriedene Kunden";
const pageDescription = "Schauen Sie sich unsere realisierten Solar-Projekte in Leipzig und Umgebung an. Echte Anlagen, echte Ergebnisse.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <section class="bg-[#0D1D37] text-white py-20">
      <div class="container-custom mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Unsere Projekte</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Über 500 realisierte Anlagen in Leipzig und Mitteldeutschland sprechen für sich. 
          Hier finden Sie eine Auswahl unserer Arbeiten.
        </p>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        
        <!-- Filter (Visual only for now) -->
        <div class="flex justify-center gap-4 mb-12 flex-wrap">
          <button class="px-6 py-2 bg-[var(--senec-blue)] text-white rounded-full font-medium shadow-md">Alle</button>
          <button class="px-6 py-2 bg-white text-gray-600 hover:bg-gray-100 rounded-full font-medium border border-gray-200 transition-colors">Privathäuser</button>
          <button class="px-6 py-2 bg-white text-gray-600 hover:bg-gray-100 rounded-full font-medium border border-gray-200 transition-colors">Gewerbe</button>
          <button class="px-6 py-2 bg-white text-gray-600 hover:bg-gray-100 rounded-full font-medium border border-gray-200 transition-colors">Speicher</button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <!-- Project 1 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="eager" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/YTAePnxnNebcoZfQ.webp" alt="Einfamilienhaus Leipzig-Gohlis" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--senec-yellow)] text-[var(--senec-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-2">Einfamilienhaus in Gohlis</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: März 2024</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">9,8 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">5 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

          <!-- Project 2 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="eager" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/HBaVUifNKEXnopIx.webp" alt="Doppelhaus Markkleeberg" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--senec-yellow)] text-[var(--senec-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-2">Neubau in Markkleeberg</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: November 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">12,4 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">10 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

          <!-- Project 3 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/LYjByusQjAHOsESm.webp" alt="Gewerbehalle Plagwitz" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--senec-turquoise)] text-white text-xs font-bold px-3 py-1 rounded uppercase">Gewerbe</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-2">Lagerhalle in Plagwitz</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: August 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">85 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">Ohne</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

           <!-- Project 4 -->
           <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/FOWtAblnRJRRYqph.webp" alt="Mehrfamilienhaus Connewitz" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--senec-yellow)] text-[var(--senec-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-2">Sanierung in Connewitz</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: Juni 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">7,6 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">2.5 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

          <!-- Project 5 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/PaJCWXASeojGhFQA.webp" alt="Bürogebäude Zentrum" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--senec-turquoise)] text-white text-xs font-bold px-3 py-1 rounded uppercase">Gewerbe</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-2">Bürokomplex Zentrum-Süd</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: Mai 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">42 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">22 kW</span>
                  Wallboxen
                </div>
              </div>
            </div>
          </div>

          <!-- Project 6 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/LSLAJtJycoUeLxmh.webp" alt="Einfamilienhaus Taucha" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--senec-yellow)] text-[var(--senec-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-2">Neubau in Taucha</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: April 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">15 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--senec-blue)]">10 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Interne Links -->
    <section class="py-12 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-2xl font-bold text-[var(--senec-blue)] mb-8 text-center">Unsere Leistungen</h2>
        <div class="grid md:grid-cols-4 gap-6">
          <a href="/privat" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Privatkunden</h3>
            <p class="text-gray-600 text-sm">PV-Anlagen für Eigenheime</p>
          </a>
          <a href="/gewerbe" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Gewerbekunden</h3>
            <p class="text-gray-600 text-sm">Großanlagen für Unternehmen</p>
          </a>
          <a href="/stromspeicher" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Stromspeicher</h3>
            <p class="text-gray-600 text-sm">Solarstrom rund um die Uhr</p>
          </a>
          <a href="/kontakt" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Kontakt</h3>
            <p class="text-gray-600 text-sm">Kostenlose Beratung anfordern</p>
          </a>
        </div>
      </div>
    </section>

    <!-- SEO Textblock -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--senec-blue)] mb-6">Photovoltaik-Referenzen aus Leipzig und Umgebung</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Unsere Referenzprojekte zeigen die Vielfalt unserer Arbeit: Von der kompakten 5-kWp-Anlage auf dem Einfamilienhaus bis zur 100-kWp-Großanlage auf Gewerbehallen realisieren wir Photovoltaik-Projekte jeder Größenordnung. Jedes Projekt wird individuell geplant und auf die Bedürfnisse unserer Kunden zugeschnitten.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Seit unserer Gründung haben wir über 2.400 Photovoltaikanlagen in Leipzig und der Region installiert. Unsere Kunden schätzen die professionelle Beratung, die saubere Montage und den zuverlässigen Service. Das bestätigt auch unsere durchschnittliche Bewertung von 4,9 Sternen bei Google.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Möchten Sie sich selbst von unserer Arbeit überzeugen? Gerne vermitteln wir Ihnen den Kontakt zu Referenzkunden in Ihrer Nähe. Oder vereinbaren Sie direkt einen Beratungstermin – wir zeigen Ihnen, wie auch Ihr Dach zum Kraftwerk wird.
          </p>
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>
