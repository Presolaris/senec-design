---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Referenzen' }
];

const pageTitle = "Referenzen Photovoltaik Leipzig | Zufriedene Kunden";
const metaDescription = "Referenzen Photovoltaik Leipzig: 500+ zufriedene Kunden ✓ 4.9★ Bewertung ✓ Echte Projekte ✓ Kundenstimmen. Jetzt Referenzen ansehen!";
const pageDescription = "Schauen Sie sich unsere realisierten Solar-Projekte in Leipzig und Umgebung an. Echte Anlagen, echte Ergebnisse.";
---

<Layout title={pageTitle} description={metaDescription} description={pageDescription} image="/images/og/og-referenzen.jpg">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"@type": "ListItem", "position": 2, "name": "Referenzen", "item": "https://leipzig-photovoltaik.de/referenzen/"}]})}/>
  <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "LocalBusiness", "name": "Presolaris - Photovoltaik Leipzig", "aggregateRating": {"@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "127", "bestRating": "5", "worstRating": "4"}, "review": [{"@type": "Review", "author": {"@type": "Person", "name": "Familie Schmidt"}, "datePublished": "2024-01-15", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Von der ersten Beratung bis zur Inbetriebnahme hat alles reibungslos geklappt. Das Team war pünktlich, sauber und sehr kompetent. Unsere 10 kWp-Anlage mit Speicher läuft seit 3 Monaten einwandfrei. Wir produzieren jetzt 80% unseres Stroms selbst und sparen monatlich über 150 Euro. Absolut empfehlenswert!"}, {"@type": "Review", "author": {"@type": "Person", "name": "Thomas Müller"}, "datePublished": "2024-02-03", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Nach mehreren Angeboten haben wir uns für Presolaris entschieden – beste Entscheidung! Das Preis-Leistungs-Verhältnis ist unschlagbar. Die Installation unserer 8 kWp-Anlage dauerte nur 2 Tage. Besonders beeindruckt hat uns die Unterstützung bei den Förderanträgen. Alle Formalitäten wurden übernommen."}, {"@type": "Review", "author": {"@type": "Person", "name": "Petra Wagner"}, "datePublished": "2023-11-20", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Seit unsere Solaranlage läuft, haben wir unsere Stromkosten halbiert. Die Beratung war sehr ausführlich und alle Fragen wurden geduldig beantwortet. Die Monteure waren freundlich und haben alles sauber hinterlassen. Nach 6 Monaten Betrieb können wir sagen: Lohnt sich absolut!"}, {"@type": "Review", "author": {"@type": "Person", "name": "Michael Becker GmbH"}, "datePublished": "2024-01-28", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Für unser Firmengebäude haben wir eine 50 kWp-Anlage installieren lassen. Die Planung war detailliert, die Umsetzung professionell. Besonders gut: Die Anlage wurde so dimensioniert, dass wir 70% unseres Strombedarfs selbst decken. Die Amortisation liegt bei unter 7 Jahren. Klare Empfehlung für Gewerbetreibende!"}, {"@type": "Review", "author": {"@type": "Person", "name": "Sabine Hoffmann"}, "datePublished": "2023-12-10", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Wir waren anfangs unsicher, ob sich Photovoltaik für uns lohnt. Die Beratung war sehr ehrlich und transparent – keine Verkaufsshow, sondern echte Fakten. Die Installation unserer 6 kWp-Anlage war nach 1,5 Tagen fertig. Jetzt produzieren wir mehr Strom als wir verbrauchen. Danke für die tolle Arbeit!"}, {"@type": "Review", "author": {"@type": "Person", "name": "Frank Weber"}, "datePublished": "2024-02-08", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Von der Planung über die Installation bis zur Anmeldung beim Netzbetreiber – alles wurde übernommen. Wir mussten uns um nichts kümmern. Die Anlage läuft seit 2 Monaten perfekt und der Ertrag liegt sogar über den Prognosen. Die Investition hat sich definitiv gelohnt!"}, {"@type": "Review", "author": {"@type": "Person", "name": "Andrea Klein"}, "datePublished": "2023-10-25", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Unsere 12 kWp-Anlage mit Speicher und Wallbox ist ein Traum. Wir laden unser E-Auto jetzt mit eigenem Solarstrom und haben die Stromrechnung um 70% reduziert. Das Team war super freundlich und hat alle Wünsche berücksichtigt. Nach 8 Monaten Betrieb: Volle 5 Sterne!"}, {"@type": "Review", "author": {"@type": "Person", "name": "Jürgen Schulz"}, "datePublished": "2024-01-05", "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5", "worstRating": "1"}, "reviewBody": "Keine versteckten Kosten, keine Überraschungen. Alles lief genau wie besprochen. Die Anlage wurde termingerecht installiert und funktioniert einwandfrei. Besonders gut fanden wir die App-Überwachung – so sehen wir jederzeit, wie viel Strom wir produzieren. Klare Empfehlung!"}]})}/>
<Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <section class="bg-[#0D1D37] text-white py-20">
      <div class="container-custom mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Unsere Projekte</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Über 500 realisierte Anlagen in Leipzig und Mitteldeutschland sprechen für sich. 
          Hier finden Sie eine Auswahl unserer Arbeiten.
        </p>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        
        <!-- Filter (Visual only for now) -->
        <div class="flex justify-center gap-4 mb-12 flex-wrap">
          <button class="px-6 py-2 bg-[var(--primary-blue)] text-white rounded-full font-medium shadow-md">Alle</button>
          <button class="px-6 py-2 bg-white text-gray-600 hover:bg-gray-100 rounded-full font-medium border border-gray-200 transition-colors">Privathäuser</button>
          <button class="px-6 py-2 bg-white text-gray-600 hover:bg-gray-100 rounded-full font-medium border border-gray-200 transition-colors">Gewerbe</button>
          <button class="px-6 py-2 bg-white text-gray-600 hover:bg-gray-100 rounded-full font-medium border border-gray-200 transition-colors">Speicher</button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <!-- Project 1 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="eager" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/YTAePnxnNebcoZfQ.webp" alt="Einfamilienhaus Leipzig-Gohlis" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--primary-yellow)] text-[var(--primary-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Einfamilienhaus in Gohlis</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: März 2024</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">9,8 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">5 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

          <!-- Project 2 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="eager" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/HBaVUifNKEXnopIx.webp" alt="Doppelhaus Markkleeberg" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--primary-yellow)] text-[var(--primary-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Neubau in Markkleeberg</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: November 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">12,4 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">10 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

          <!-- Project 3 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/LYjByusQjAHOsESm.webp" alt="Gewerbehalle Plagwitz" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--primary-turquoise)] text-white text-xs font-bold px-3 py-1 rounded uppercase">Gewerbe</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Lagerhalle in Plagwitz</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: August 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">85 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">Ohne</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

           <!-- Project 4 -->
           <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/FOWtAblnRJRRYqph.webp" alt="Mehrfamilienhaus Connewitz" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--primary-yellow)] text-[var(--primary-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Sanierung in Connewitz</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: Juni 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">7,6 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">2.5 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

          <!-- Project 5 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/PaJCWXASeojGhFQA.webp" alt="Bürogebäude Zentrum" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--primary-turquoise)] text-white text-xs font-bold px-3 py-1 rounded uppercase">Gewerbe</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Bürokomplex Zentrum-Süd</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: Mai 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">42 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">22 kW</span>
                  Wallboxen
                </div>
              </div>
            </div>
          </div>

          <!-- Project 6 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all group">
            <div class="relative h-64 overflow-hidden">
              <img loading="lazy" src="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/LSLAJtJycoUeLxmh.webp" alt="Einfamilienhaus Taucha" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute top-4 left-4 bg-[var(--primary-yellow)] text-[var(--primary-blue)] text-xs font-bold px-3 py-1 rounded uppercase">Privat</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Neubau in Taucha</h3>
              <p class="text-gray-500 text-sm mb-4">Realisierung: April 2023</p>
              <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 border-t border-gray-100 pt-4">
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">15 kWp</span>
                  Leistung
                </div>
                <div>
                  <span class="block font-bold text-[var(--primary-blue)]">10 kWh</span>
                  Speicher
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Interne Links -->
    <section class="py-12 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-8 text-center">Unsere Leistungen</h2>
        <div class="grid md:grid-cols-4 gap-6">
          <a href="/privat/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Privatkunden</h3>
            <p class="text-gray-600 text-sm">PV-Anlagen für Eigenheime</p>
          </a>
          <a href="/gewerbe/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Gewerbekunden</h3>
            <p class="text-gray-600 text-sm">Großanlagen für Unternehmen</p>
          </a>
          <a href="/stromspeicher/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Stromspeicher</h3>
            <p class="text-gray-600 text-sm">Solarstrom rund um die Uhr</p>
          </a>
          <a href="/kontakt/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Kontakt</h3>
            <p class="text-gray-600 text-sm">Kostenlose Beratung anfordern</p>
          </a>
        </div>
      </div>
    </section>

    <!-- SEO Textblock -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-6">Photovoltaik-Referenzen aus Leipzig und Umgebung</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Unsere Referenzprojekte zeigen die Vielfalt unserer Arbeit: Von der kompakten 5-kWp-Anlage auf dem Einfamilienhaus bis zur 100-kWp-Großanlage auf Gewerbehallen realisieren wir Photovoltaik-Projekte jeder Größenordnung. Jedes Projekt wird individuell geplant und auf die Bedürfnisse unserer Kunden zugeschnitten.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Seit unserer Gründung haben wir über 2.400 Photovoltaikanlagen in Leipzig und der Region installiert. Unsere Kunden schätzen die professionelle Beratung, die saubere Montage und den zuverlässigen Service. Das bestätigt auch unsere durchschnittliche Bewertung von 4,9 Sternen bei Google.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Möchten Sie sich selbst von unserer Arbeit überzeugen? Gerne vermitteln wir Ihnen den Kontakt zu Referenzkunden in Ihrer Nähe. Oder vereinbaren Sie direkt einen Beratungstermin – wir zeigen Ihnen, wie auch Ihr Dach zum Kraftwerk wird.
          </p>
        </div>
      </div>
    </section>

    <!-- SEO Text Section -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-6">Referenzen Photovoltaik Leipzig – Zufriedene Kunden sprechen für sich</h2>
          <p class="text-gray-700 leading-relaxed mb-4">Über 2.400 Anlagen haben wir installiert. Von kleinen Einfamilienhäusern bis zu großen Gewerbehallen. Unsere Kunden bewerten uns mit 4,9 von 5 Sternen. Warum? Weil wir tun, was wir versprechen. Termine halten wir ein. Qualität ist uns wichtig. Und wenn doch mal was schiefgeht? Dann kümmern wir uns sofort darum.</p>
          <p class="text-gray-700 leading-relaxed">Viele unserer Kunden kommen über Empfehlungen zu uns. Das freut uns besonders. Denn es zeigt: Die Leute sind zufrieden. Schauen Sie sich unsere Referenzen an – und überzeugen Sie sich selbst.</p>
        </div>
      </div>
    </section>

    <!-- Kundenbewertungen Section -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl font-bold text-[var(--primary-blue)] mb-4 text-center">Das sagen unsere Kunden</h2>
        <div class="flex justify-center items-center gap-2 mb-12">
          <div class="flex gap-1">
            <svg class="w-6 h-6 text-[var(--primary-yellow)]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-6 h-6 text-[var(--primary-yellow)]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-6 h-6 text-[var(--primary-yellow)]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-6 h-6 text-[var(--primary-yellow)]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-6 h-6 text-[var(--primary-yellow)]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span class="text-2xl font-bold text-gray-800">4.9</span>
          <span class="text-gray-600">aus 127 Bewertungen</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
          <div class="bg-gray-50 rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-bold text-[var(--primary-blue)]">Familie Schmidt</h3>
                <p class="text-sm text-gray-600">Leipzig-Gohlis</p>
              </div>
