---
// SEO Keyword Tracking Dashboard
// Option 6: Hybrid-Lösung (GSC + Manuell + KI)
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>SEO Dashboard | Leipzig Photovoltaik</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .trend-up { color: #10b981; }
    .trend-down { color: #ef4444; }
    .trend-stable { color: #6b7280; }
    .trend-new { color: #3b82f6; }
    .priority-high { background: #fef2f2; border-color: #ef4444; }
    .priority-medium { background: #fffbeb; border-color: #f59e0b; }
    .priority-low { background: #f0fdf4; border-color: #22c55e; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  
  <!-- Login Screen -->
  <div id="loginScreen" class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-lg p-8 w-full max-w-md">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">🔍 SEO Dashboard</h1>
        <p class="text-gray-500 mt-2">Keyword Tracking & Optimierung</p>
      </div>
      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Passwort</label>
          <input type="password" id="password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Passwort eingeben" required>
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg font-medium hover:bg-blue-700 transition">
          Anmelden
        </button>
        <p id="loginError" class="text-red-500 text-sm text-center hidden">Falsches Passwort</p>
      </form>
    </div>
  </div>

  <!-- Dashboard -->
  <div id="dashboard" class="hidden">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900">🔍 SEO Keyword Tracking</h1>
            <p class="text-sm text-gray-500">leipzig-photovoltaik.de</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/admin" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm">
              ← Leads
            </a>
            <a href="/analytics" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm">
              📊 Analytics
            </a>
            <button onclick="showGuide()" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg hover:bg-green-200 transition text-sm">
              📖 Anleitung
            </button>
            <button onclick="logout()" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition text-sm">
              Abmelden
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Gesamt Keywords</p>
          <p id="statTotal" class="text-2xl sm:text-3xl font-bold text-gray-900 mt-1">0</p>
        </div>
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Top 10 Rankings</p>
          <p id="statTop10" class="text-2xl sm:text-3xl font-bold text-green-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Verbessert ↑</p>
          <p id="statUp" class="text-2xl sm:text-3xl font-bold text-emerald-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Verschlechtert ↓</p>
          <p id="statDown" class="text-2xl sm:text-3xl font-bold text-red-600 mt-1">0</p>
        </div>
      </div>

      <!-- Tabs -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
        <div class="border-b border-gray-200">
          <nav class="flex overflow-x-auto">
            <button onclick="showTab('keywords')" id="tabKeywords" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-blue-600 border-b-2 border-blue-600 whitespace-nowrap">
              📋 Keywords
            </button>
            <button onclick="showTab('rankings')" id="tabRankings" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap">
              📈 Ranking-Verlauf
            </button>
            <button onclick="showTab('optimize')" id="tabOptimize" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap">
              🤖 KI-Optimierung
            </button>
            <button onclick="showTab('bulkcheck')" id="tabBulkcheck" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap">
              🔄 Bulk-Check
            </button>
          </nav>
        </div>

        <!-- Tab: Keywords -->
        <div id="contentKeywords" class="p-4 sm:p-6">
          <!-- Filters -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Kategorie</label>
              <select id="filterCategory" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Kategorien</option>
                <option value="standort">Standort</option>
                <option value="service">Service</option>
                <option value="produkt">Produkt</option>
                <option value="ratgeber">Ratgeber</option>
                <option value="blog">Blog</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Priorität</label>
              <select id="filterPriority" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Prioritäten</option>
                <option value="high">Hoch</option>
                <option value="medium">Mittel</option>
                <option value="low">Niedrig</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Trend</label>
              <select id="filterTrend" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Trends</option>
                <option value="up">↑ Gestiegen</option>
                <option value="down">↓ Gefallen</option>
                <option value="stable">→ Stabil</option>
                <option value="new">🆕 Neu</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Suche</label>
              <input type="text" id="filterSearch" oninput="filterKeywords()" placeholder="Keyword suchen..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
          </div>

          <!-- Keywords Table -->
          <div class="overflow-x-auto">
            <table class="w-full min-w-[800px]">
              <thead>
                <tr class="bg-gray-50 text-left">
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase">Keyword</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase">URL</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Ranking</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Trend</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Suchvolumen</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Priorität</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Aktionen</th>
                </tr>
              </thead>
              <tbody id="keywordsTable" class="divide-y divide-gray-200">
                <!-- Dynamisch befüllt -->
              </tbody>
            </table>
          </div>

          <!-- Add Keyword Button -->
          <div class="mt-6 flex justify-end">
            <button onclick="showAddKeywordModal()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-sm font-medium">
              + Keyword hinzufügen
            </button>
          </div>
        </div>

        <!-- Tab: Ranking-Verlauf -->
        <div id="contentRankings" class="p-4 sm:p-6 hidden">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Keyword auswählen:</label>
            <select id="rankingKeywordSelect" onchange="loadRankingHistory()" class="w-full max-w-md px-3 py-2 border border-gray-300 rounded-lg">
              <option value="">-- Keyword wählen --</option>
            </select>
          </div>
          <div class="bg-gray-50 rounded-lg p-4" style="height: 400px;">
            <canvas id="rankingChart"></canvas>
          </div>
          <div id="rankingDetails" class="mt-4 text-sm text-gray-600"></div>
        </div>

        <!-- Tab: KI-Optimierung -->
        <div id="contentOptimize" class="p-4 sm:p-6 hidden">
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">🤖 KI-basierte SEO-Analyse</h3>
            <p class="text-sm text-gray-600 mb-4">Wähle ein Keyword aus, um eine detaillierte Analyse und Optimierungsempfehlungen zu erhalten.</p>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <select id="optimizeKeywordSelect" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg">
                <option value="">-- Keyword wählen --</option>
              </select>
              <button onclick="runAIAnalysis()" class="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition font-medium">
                🔍 Analysieren
              </button>
            </div>
          </div>

          <!-- Analysis Results -->
          <div id="analysisResults" class="hidden">
            <div class="bg-gradient-to-r from-purple-50 to-blue-50 rounded-xl p-6 mb-6">
              <h4 class="font-semibold text-gray-900 mb-4">📊 On-Page-SEO-Analyse</h4>
              <div id="onPageAnalysis" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Dynamisch befüllt -->
              </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
              <h4 class="font-semibold text-gray-900 mb-4">💡 Optimierungsempfehlungen</h4>
              <div id="recommendations" class="space-y-4">
                <!-- Dynamisch befüllt -->
              </div>
            </div>

            <div class="bg-gray-900 rounded-xl p-6">
              <div class="flex items-center justify-between mb-4">
                <h4 class="font-semibold text-white">🚀 Autooptimize-Prompt</h4>
                <button onclick="copyAutooptimizePrompt()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm">
                  📋 Kopieren
                </button>
              </div>
              <pre id="autooptimizePrompt" class="text-green-400 text-sm whitespace-pre-wrap overflow-x-auto"></pre>
            </div>
          </div>

          <!-- Pending Recommendations -->
          <div class="mt-8">
            <h4 class="font-semibold text-gray-900 mb-4">📋 Offene Empfehlungen</h4>
            <div id="pendingRecommendations" class="space-y-3">
              <p class="text-gray-500 text-sm">Keine offenen Empfehlungen vorhanden.</p>
            </div>
          </div>
        </div>

        <!-- Tab: Bulk-Check -->
        <div id="contentBulkcheck" class="p-4 sm:p-6 hidden">
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">🔄 Bulk Ranking-Check</h3>
            <p class="text-sm text-gray-600 mb-4">Prüfe mehrere Keywords auf einmal. Das System öffnet Google-Suchen, du trägst die gefundenen Positionen ein.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Keywords to Check -->
            <div class="bg-gray-50 rounded-xl p-4">
              <h4 class="font-medium text-gray-900 mb-3">Keywords ohne aktuelles Ranking:</h4>
              <div id="bulkCheckList" class="space-y-2 max-h-96 overflow-y-auto">
                <!-- Dynamisch befüllt -->
              </div>
              <button onclick="startBulkCheck()" class="mt-4 w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                🔍 Ausgewählte Keywords prüfen
              </button>
            </div>

            <!-- Quick Entry -->
            <div class="bg-white border border-gray-200 rounded-xl p-4">
              <h4 class="font-medium text-gray-900 mb-3">Schnelleingabe:</h4>
              <div id="quickEntryForm" class="space-y-3">
                <p class="text-gray-500 text-sm">Wähle links Keywords aus und klicke "Prüfen".</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Add Keyword Modal -->
  <div id="addKeywordModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg">
      <div class="p-6 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Neues Keyword hinzufügen</h3>
      </div>
      <form id="addKeywordForm" class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Keyword *</label>
          <input type="text" id="newKeyword" required class="w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="z.B. Photovoltaik Leipzig">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Ziel-URL *</label>
          <input type="text" id="newTargetUrl" required class="w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="z.B. /standorte/leipzig">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Kategorie</label>
            <select id="newCategory" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
              <option value="standort">Standort</option>
              <option value="service">Service</option>
              <option value="produkt">Produkt</option>
              <option value="ratgeber">Ratgeber</option>
              <option value="blog">Blog</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Priorität</label>
            <select id="newPriority" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
              <option value="high">Hoch</option>
              <option value="medium" selected>Mittel</option>
              <option value="low">Niedrig</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Suchvolumen (ca.)</label>
            <input type="number" id="newSearchVolume" class="w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="z.B. 500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Aktuelles Ranking</label>
            <input type="number" id="newCurrentRank" min="1" max="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="1-100">
          </div>
        </div>
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closeAddKeywordModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">
            Abbrechen
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
            Speichern
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Update Ranking Modal -->
  <div id="updateRankingModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
      <div class="p-6 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Ranking aktualisieren</h3>
        <p id="updateKeywordName" class="text-sm text-gray-500 mt-1"></p>
      </div>
      <form id="updateRankingForm" class="p-6 space-y-4">
        <input type="hidden" id="updateKeywordId">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Neue Position (1-100)</label>
          <input type="number" id="updateRank" min="1" max="100" required class="w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="z.B. 5">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Suchmaschine</label>
          <select id="updateSearchEngine" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
            <option value="google">Google</option>
            <option value="bing">Bing</option>
            <option value="chatgpt">ChatGPT</option>
            <option value="perplexity">Perplexity</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Gerät</label>
          <select id="updateDevice" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
            <option value="desktop">Desktop</option>
            <option value="mobile">Mobile</option>
          </select>
        </div>
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closeUpdateRankingModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">
            Abbrechen
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
            Speichern
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Guide Modal -->
  <div id="guideModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-3xl my-8">
      <div class="p-6 border-b border-gray-200 flex justify-between items-center sticky top-0 bg-white rounded-t-xl">
        <h3 class="text-lg font-semibold text-gray-900">📖 SEO-Dashboard Anleitung</h3>
        <button onclick="closeGuide()" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="p-6 space-y-6 max-h-[70vh] overflow-y-auto">
        
        <!-- Intervall-Übersicht -->
        <div class="bg-blue-50 rounded-xl p-4">
          <h4 class="font-semibold text-blue-900 mb-3">⏰ Wann mache ich was?</h4>
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-blue-700">
                <th class="pb-2">Intervall</th>
                <th class="pb-2">Aufgabe</th>
                <th class="pb-2">Dauer</th>
              </tr>
            </thead>
            <tbody class="text-blue-800">
              <tr class="border-t border-blue-200">
                <td class="py-2 font-medium">Täglich</td>
                <td>Dashboard kurz checken (optional)</td>
                <td>2 Min</td>
              </tr>
              <tr class="border-t border-blue-200">
                <td class="py-2 font-medium">Wöchentlich</td>
                <td>Top 5 Keywords manuell prüfen</td>
                <td>10 Min</td>
              </tr>
              <tr class="border-t border-blue-200">
                <td class="py-2 font-medium">Monatlich</td>
                <td>KI-Analyse für 3-5 Keywords durchführen</td>
                <td>30 Min</td>
              </tr>
              <tr class="border-t border-blue-200">
                <td class="py-2 font-medium">Quartalsweise</td>
                <td>Alle Keywords prüfen, neue hinzufügen</td>
                <td>1 Std</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Schritt 1 -->
        <div>
          <h4 class="font-semibold text-gray-900 mb-2">1️⃣ Ranking manuell prüfen</h4>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600">
            <li>Öffne <strong>Google im Inkognito-Modus</strong> (Strg+Shift+N)</li>
            <li>Gib das Keyword ein (z.B. "Photovoltaik Leipzig")</li>
            <li>Suche deine Seite (leipzig-photovoltaik.de)</li>
            <li>Zähle die Position (1 = erstes Ergebnis)</li>
            <li>Klicke im Dashboard auf "📝" und trage die Position ein</li>
          </ol>
          <div class="mt-3 p-3 bg-yellow-50 rounded-lg text-sm text-yellow-800">
            💡 <strong>Tipp:</strong> Nutze Strg+F und suche nach "leipzig-photovoltaik" um deine Seite schneller zu finden.
          </div>
        </div>

        <!-- Schritt 2 -->
        <div>
          <h4 class="font-semibold text-gray-900 mb-2">2️⃣ KI-Optimierung nutzen</h4>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600">
            <li>Gehe zum Tab "🤖 KI-Optimierung"</li>
            <li>Wähle ein Keyword aus der Liste</li>
            <li>Klicke auf "🔍 Analysieren"</li>
            <li>Lies die Empfehlungen durch</li>
            <li>Kopiere den "Autooptimize-Prompt"</li>
            <li>Füge ihn in ChatGPT/Claude ein für konkrete Umsetzung</li>
          </ol>
        </div>

        <!-- Schritt 3 -->
        <div>
          <h4 class="font-semibold text-gray-900 mb-2">3️⃣ Bulk-Check durchführen</h4>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600">
            <li>Gehe zum Tab "🔄 Bulk-Check"</li>
            <li>Wähle Keywords ohne aktuelles Ranking</li>
            <li>Klicke "Ausgewählte Keywords prüfen"</li>
            <li>Google öffnet sich für jedes Keyword</li>
            <li>Trage die gefundenen Positionen ein</li>
          </ol>
        </div>

        <!-- Trend-Erklärung -->
        <div>
