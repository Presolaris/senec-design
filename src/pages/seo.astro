    function updateStats() {
      const total = allKeywords.length;
      const top10 = allKeywords.filter(k => k.position && k.position <= 10).length;
      const page2 = allKeywords.filter(k => k.position && k.position > 10 && k.position <= 20).length;
      const page3 = allKeywords.filter(k => k.position && k.position > 20).length;
      
      document.getElementById('statTotal').textContent = total;
      document.getElementById('statTop10').textContent = top10;
      document.getElementById('statPage2').textContent = page2;
      document.getElementById('statPage3').textContent = page3;
    }

    function displayKeywords() {
      const tbody = document.getElementById('keywordsTable');
      tbody.innerHTML = filteredKeywords.map(k => `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <div class="font-medium text-gray-900">${k.keyword}</div>
            <div class="text-xs text-gray-500">${k.category}</div>
          </td>
          <td class="px-4 py-3">
            <a href="https://leipzig-photovoltaik.de${k.target_url}" target="_blank" class="text-blue-600 hover:underline text-sm">
              ${k.target_url}
            </a>
          </td>
          <td class="px-4 py-3 text-center">
            <span class="font-bold ${getPositionColor(k.position, k.source)}">
              ${k.position ? k.position.toFixed(1) : (k.source === 'potential' ? '⚠️ Kein Ranking' : '-')}
            </span>
          </td>
          <td class="px-4 py-3 text-center text-sm ${k.clicks > 0 ? 'text-green-600 font-medium' : 'text-gray-400'}">
            ${k.clicks || 0}
          </td>
          <td class="px-4 py-3 text-center text-sm text-gray-600">
            ${k.impressions ? k.impressions.toLocaleString() : (k.searchVolume ? `~${k.searchVolume}` : '-')}
          </td>
          <td class="px-4 py-3 text-center text-sm ${k.ctr > 1 ? 'text-green-600' : 'text-gray-500'}">
            ${k.ctr ? k.ctr.toFixed(2) + '%' : '-'}
          </td>
          <td class="px-4 py-3 text-center">
            ${k.source === 'gsc' ? '<span class="gsc-badge">GSC</span>' : 
              k.source === 'potential' ? '<span class="inline-block px-2 py-0.5 bg-purple-100 text-purple-700 rounded text-[10px] font-medium">🚀 Potenzial</span>' : 
              '<span class="text-xs text-gray-400">Ziel</span>'}
          </td>
          <td class="px-4 py-3 text-center">
            <button onclick="openGoogleSearch('${encodeURIComponent(k.keyword)}')" class="p-1 text-gray-400 hover:text-green-600" title="In Google suchen">
              🔍
            </button>
          </td>
        </tr>
      `).join('');
    }

    function getPositionColor(position, source) {
      if (!position) return source === 'potential' ? 'text-purple-600' : 'text-gray-400';
      if (position <= 10) return 'text-green-600';
      if (position <= 20) return 'text-yellow-600';
      return 'text-red-600';
    }

    function filterKeywords() {
      const category = document.getElementById('filterCategory').value;
      const position = document.getElementById('filterPosition').value;
      const source = document.getElementById('filterSource').value;
      const search = document.getElementById('filterSearch').value.toLowerCase();
      
      filteredKeywords = allKeywords.filter(k => {
        if (category && k.category !== category) return false;
        if (source && k.source !== source) return false;
        if (search && !k.keyword.toLowerCase().includes(search)) return false;
        if (position === 'top10' && (!k.position || k.position > 10)) return false;
        if (position === 'page2' && (!k.position || k.position <= 10 || k.position > 20)) return false;
        if (position === 'page3' && (!k.position || k.position <= 20)) return false;
        return true;
      });
      
      displayKeywords();
    }

    function populateKeywordSelects() {
      const gscKeywords = allKeywords.filter(k => k.source === 'gsc');
      const options = gscKeywords.map(k => `<option value="${k.id}">${k.keyword} (Pos. ${k.position?.toFixed(1) || '-'})</option>`).join('');
      
      const rankingSelect = document.getElementById('rankingKeywordSelect');
      if (rankingSelect) {
        rankingSelect.innerHTML = '<option value="">-- Keyword wählen --</option>' + options;
      }
    }

    function populateBulkCheckList() {
      const container = document.getElementById('bulkCheckList');
      const gscKeywords = allKeywords.filter(k => k.source === 'gsc').slice(0, 20);
      
      container.innerHTML = gscKeywords.map(k => `
        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 cursor-pointer" onclick="openGoogleSearch('${encodeURIComponent(k.keyword)}')">
          <div>
            <span class="font-medium text-gray-900">${k.keyword}</span>
            <span class="ml-2 text-xs ${getPositionColor(k.position)}">Position: ${k.position?.toFixed(1) || '-'}</span>
          </div>
          <span class="text-blue-600">🔍 Prüfen</span>
        </div>
      `).join('');
    }

    function populateQuickWins() {
      // Seite 2 Keywords (Position 11-20)
      const page2Keywords = allKeywords.filter(k => k.position && k.position > 10 && k.position <= 20);
      const page2Container = document.getElementById('quickWinsPage2');
      page2Container.innerHTML = page2Keywords.slice(0, 5).map(k => `
        <div class="flex items-center justify-between p-2 bg-white rounded">
          <span class="text-sm">${k.keyword}</span>
          <span class="text-xs font-medium text-yellow-700">Position ${k.position.toFixed(1)}</span>
        </div>
      `).join('');
      
      // Keywords mit hohen Impressionen aber 0 Klicks
      const noClicksKeywords = allKeywords.filter(k => k.impressions > 100 && k.clicks === 0);
      const noClicksContainer = document.getElementById('quickWinsNoClicks');
      noClicksContainer.innerHTML = noClicksKeywords.slice(0, 5).map(k => `
        <div class="flex items-center justify-between p-2 bg-white rounded">
          <span class="text-sm">${k.keyword}</span>
          <span class="text-xs font-medium text-red-700">${k.impressions} Impressionen, 0 Klicks</span>
        </div>
      `).join('');
    }

    function openGoogleSearch(keyword) {
      window.open(`https://www.google.de/search?q=${keyword}`, '_blank');
    }

    function showTab(tabName) {
      // Hide all tabs
      document.querySelectorAll('[id^="content"]').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
        el.classList.add('text-gray-500');
      });
      
      // Show selected tab
      document.getElementById('content' + tabName.charAt(0).toUpperCase() + tabName.slice(1)).classList.remove('hidden');
      document.getElementById('tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1)).classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
      document.getElementById('tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1)).classList.remove('text-gray-500');
    }

    function loadRankingHistory() {
      const keywordId = document.getElementById('rankingKeywordSelect').value;
      if (!keywordId) return;
      
      const keyword = allKeywords.find(k => k.id === keywordId);
      if (!keyword) return;
      
      // Demo-Daten für Ranking-Verlauf
      const ctx = document.getElementById('rankingChart').getContext('2d');
      
      if (rankingChart) {
        rankingChart.destroy();
      }
      
      rankingChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Nov', 'Dez', 'Jan', 'Feb'],
          datasets: [{
            label: 'Position',
            data: [keyword.position ? keyword.position + 5 : 50, keyword.position ? keyword.position + 3 : 40, keyword.position ? keyword.position + 1 : 30, keyword.position || 25],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              reverse: true,
              min: 1,
              max: 100,
              title: {
                display: true,
                text: 'Position (niedriger = besser)'
              }
            }
          }
        }
      });
      
      document.getElementById('rankingDetails').innerHTML = `
        <p><strong>Keyword:</strong> ${keyword.keyword}</p>
        <p><strong>Aktuelle Position:</strong> ${keyword.position?.toFixed(1) || 'Nicht gerankt'}</p>
        <p><strong>Klicks (3 Monate):</strong> ${keyword.clicks}</p>
        <p><strong>Impressionen:</strong> ${keyword.impressions?.toLocaleString()}</p>
      `;
    }

    function showGuide() {
      document.getElementById('guideModal').classList.remove('hidden');
    }

    function closeGuide() {
      document.getElementById('guideModal').classList.add('hidden');
    }
  </script>
</body>
