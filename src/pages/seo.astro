      document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
      document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.remove('text-gray-500');
      
      document.getElementById('contentKeywords').classList.add('hidden');
      document.getElementById('contentRankings').classList.add('hidden');
      document.getElementById('contentOptimize').classList.add('hidden');
      document.getElementById('contentBulkcheck').classList.add('hidden');
      document.getElementById('content' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.remove('hidden');
