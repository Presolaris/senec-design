    function updateStats() {
      const total = allKeywords.length;
      const top10 = allKeywords.filter(k => k.current_rank && k.current_rank <= 10).length;
      const up = allKeywords.filter(k => k.trend === 'up').length;
      const down = allKeywords.filter(k => k.trend === 'down').length;
      
      document.getElementById('statTotal').textContent = total;
      document.getElementById('statTop10').textContent = top10;
      document.getElementById('statUp').textContent = up;
      document.getElementById('statDown').textContent = down;
    }

    function displayKeywords() {
      const tbody = document.getElementById('keywordsTable');
      tbody.innerHTML = filteredKeywords.map(k => `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <div class="font-medium text-gray-900">${k.keyword}</div>
