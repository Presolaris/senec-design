---
// SEO Keyword Tracking Dashboard
// Option 6: Hybrid-Lösung (GSC + Manuell + KI)
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>SEO Dashboard | Leipzig Photovoltaik</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .trend-up { color: #10b981; }
    .trend-down { color: #ef4444; }
    .trend-stable { color: #6b7280; }
    .trend-new { color: #3b82f6; }
    .priority-high { background: #fef2f2; border-color: #ef4444; }
    .priority-medium { background: #fffbeb; border-color: #f59e0b; }
    .priority-low { background: #f0fdf4; border-color: #22c55e; }
    .gsc-badge { background: linear-gradient(135deg, #4285f4, #34a853); color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  
  <!-- Login Screen -->
  <div id="loginScreen" class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-lg p-8 w-full max-w-md">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">🔍 SEO Dashboard</h1>
        <p class="text-gray-500 mt-2">Keyword Tracking & Optimierung</p>
      </div>
      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Passwort</label>
          <input type="password" id="password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Passwort eingeben" required>
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg font-medium hover:bg-blue-700 transition">
          Anmelden
        </button>
        <p id="loginError" class="text-red-500 text-sm text-center hidden">Falsches Passwort</p>
      </form>
    </div>
  </div>

  <!-- Dashboard -->
  <div id="dashboard" class="hidden">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900">🔍 SEO Keyword Tracking</h1>
            <p class="text-sm text-gray-500">leipzig-photovoltaik.de <span class="gsc-badge ml-2">GSC Daten</span></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/admin/" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm">
              ← Leads
            </a>
            <a href="/analytics/" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm">
              📊 Analytics
            </a>
            <button onclick="showGuide()" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg hover:bg-green-200 transition text-sm">
              📖 Anleitung
            </button>
            <button onclick="logout()" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition text-sm">
              Abmelden
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
      <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"position": 2, "name": "Seo", "item": "https://leipzig-photovoltaik.de/seo/"}]})}/>
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      
      <!-- GSC Summary Banner -->
      <div class="bg-gradient-to-r from-blue-600 to-green-500 rounded-xl p-4 sm:p-6 mb-6 text-white">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold">📊 Google Search Console Daten</h2>
            <p class="text-sm opacity-90">Letzte Aktualisierung: 02.02.2026 | Zeitraum: 3 Monate</p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div>
              <p class="text-2xl font-bold">87</p>
              <p class="text-xs opacity-80">Klicks</p>
            </div>
            <div>
              <p class="text-2xl font-bold">10.257</p>
              <p class="text-xs opacity-80">Impressionen</p>
            </div>
            <div>
              <p class="text-2xl font-bold">0,8%</p>
              <p class="text-xs opacity-80">CTR</p>
            </div>
            <div>
              <p class="text-2xl font-bold">18</p>
              <p class="text-xs opacity-80">Ø Position</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Gesamt Keywords</p>
          <p id="statTotal" class="text-2xl sm:text-3xl font-bold text-gray-900 mt-1">0</p>
        </div>
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Top 10 Rankings</p>
          <p id="statTop10" class="text-2xl sm:text-3xl font-bold text-green-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Seite 2 (11-20)</p>
          <p id="statPage2" class="text-2xl sm:text-3xl font-bold text-yellow-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-xl p-4 sm:p-6 shadow-sm border border-gray-100">
          <p class="text-xs sm:text-sm text-gray-500">Seite 3+ (21+)</p>
          <p id="statPage3" class="text-2xl sm:text-3xl font-bold text-red-600 mt-1">0</p>
        </div>
      </div>

      <!-- Tabs -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
        <div class="border-b border-gray-200">
          <nav class="flex overflow-x-auto">
            <button onclick="showTab('keywords')" id="tabKeywords" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-blue-600 border-b-2 border-blue-600 whitespace-nowrap">
              📋 Keywords (GSC)
            </button>
            <button onclick="showTab('rankings')" id="tabRankings" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap">
              📈 Ranking-Verlauf
            </button>
            <button onclick="showTab('optimize')" id="tabOptimize" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap">
              🎯 Optimierung
            </button>
            <button onclick="showTab('bulkcheck')" id="tabBulkcheck" class="tab-btn px-4 sm:px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap">
              🔄 Bulk-Check
            </button>
          </nav>
        </div>

        <!-- Tab: Keywords -->
        <div id="contentKeywords" class="p-4 sm:p-6">
          <!-- Filters -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Kategorie</label>
              <select id="filterCategory" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Kategorien</option>
                <option value="standort">Standort</option>
                <option value="service">Service</option>
                <option value="produkt">Produkt</option>
                <option value="ratgeber">Ratgeber</option>
                <option value="brand">Brand</option>
                <option value="gewerbe">🏭 Gewerbe/Solarpark</option>
                <option value="wartung">🔧 Wartung/Reinigung</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Position</label>
              <select id="filterPosition" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Positionen</option>
                <option value="top10">Top 10</option>
                <option value="page2">Seite 2 (11-20)</option>
                <option value="page3">Seite 3+ (21+)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Datenquelle</label>
              <select id="filterSource" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle</option>
                <option value="gsc">GSC Daten</option>
                <option value="target">Ziel-Keywords</option>
                <option value="potential">🚀 Optimierungspotenzial</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Suche</label>
              <input type="text" id="filterSearch" oninput="filterKeywords()" placeholder="Keyword suchen..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
          </div>

          <!-- Keywords Table -->
          <div class="overflow-x-auto">
            <table class="w-full min-w-[900px]">
              <thead>
                <tr class="bg-gray-50 text-left">
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase">Keyword</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase">URL</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Position</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Klicks</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Impressionen</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">CTR</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Quelle</th>
                  <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase text-center">Aktionen</th>
                </tr>
              </thead>
              <tbody id="keywordsTable" class="divide-y divide-gray-200">
                <!-- Dynamisch befüllt -->
              </tbody>
            </table>
          </div>

          <!-- Legend -->
          <div class="mt-6 p-4 bg-gray-50 rounded-lg">
            <h4 class="text-sm font-medium text-gray-700 mb-2">Legende:</h4>
            <div class="flex flex-wrap gap-4 text-xs">
              <span><span class="inline-block w-3 h-3 bg-green-500 rounded mr-1"></span> Top 10 (Seite 1)</span>
              <span><span class="inline-block w-3 h-3 bg-yellow-500 rounded mr-1"></span> Position 11-20 (Seite 2)</span>
              <span><span class="inline-block w-3 h-3 bg-red-500 rounded mr-1"></span> Position 21+ (Seite 3+)</span>
              <span><span class="inline-block w-3 h-3 bg-purple-500 rounded mr-1"></span> Kein Ranking (Optimierungspotenzial)</span>
            </div>
            <div class="flex flex-wrap gap-4 text-xs mt-2">
              <span><span class="gsc-badge">GSC</span> = Echte Google Search Console Daten</span>
              <span><span class="inline-block px-2 py-0.5 bg-purple-100 text-purple-700 rounded text-[10px] mr-1">🚀</span> = Optimierungspotenzial (kein GSC-Ranking)</span>
              <span><span class="inline-block px-2 py-0.5 bg-gray-200 text-gray-600 rounded text-[10px] mr-1">Ziel</span> = Ziel-Keywords</span>
            </div>
          </div>
        </div>

        <!-- Tab: Ranking-Verlauf -->
        <div id="contentRankings" class="p-4 sm:p-6 hidden">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Keyword auswählen:</label>
            <select id="rankingKeywordSelect" onchange="loadRankingHistory()" class="w-full max-w-md px-3 py-2 border border-gray-300 rounded-lg">
              <option value="">-- Keyword wählen --</option>
            </select>
          </div>
          <div class="bg-gray-50 rounded-lg p-4" style="height: 400px;">
            <canvas id="rankingChart"></canvas>
          </div>
          <div id="rankingDetails" class="mt-4 text-sm text-gray-600"></div>
        </div>

        <!-- Tab: Optimierung -->
        <div id="contentOptimize" class="p-4 sm:p-6 hidden">
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">🎯 Quick-Win Optimierungen</h3>
            <p class="text-sm text-gray-600 mb-4">Keywords mit hohem Potenzial für schnelle Verbesserungen</p>
          </div>
          
          <!-- Quick Wins -->
          <div class="grid gap-4 mb-6">
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
              <h4 class="font-semibold text-yellow-800 mb-2">⚡ Seite 2 → Seite 1 (Hohes Potenzial)</h4>
              <p class="text-sm text-yellow-700 mb-3">Diese Keywords sind auf Position 11-20 und könnten mit kleinen Optimierungen auf Seite 1 kommen:</p>
              <div id="quickWinsPage2" class="space-y-2"></div>
            </div>
            
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
              <h4 class="font-semibold text-red-800 mb-2">🎯 Hohe Impressionen, keine Klicks</h4>
              <p class="text-sm text-red-700 mb-3">Diese Keywords werden oft angezeigt aber nicht geklickt - Meta-Titel/Description optimieren:</p>
              <div id="quickWinsNoClicks" class="space-y-2"></div>
            </div>
          </div>
          
          <!-- NEUER BEREICH: Optimierungspotenzial ohne Ranking -->
          <div class="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-6">
            <h4 class="font-semibold text-purple-800 mb-2">🚀 Optimierungspotenzial: Keywords ohne GSC-Ranking</h4>
            <p class="text-sm text-purple-700 mb-3">Diese wichtigen Keywords haben aktuell <strong>keine Impressionen</strong> in der Google Search Console. Hier besteht großes Potenzial für neue Landingpages:</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div class="bg-white rounded-lg p-3 border border-purple-100">
                <h5 class="font-medium text-purple-900 mb-2">🏭 Gewerbe & Solarpark</h5>
                <ul class="text-sm text-purple-700 space-y-1">
                  <li>• <strong>gewerbe photovoltaik leipzig</strong> - Suchvolumen: ~250/Monat</li>
                  <li>• <strong>solarpark wartung</strong> - Suchvolumen: ~350/Monat</li>
                  <li>• <strong>solarpark betreuung</strong> - Suchvolumen: ~200/Monat</li>
                </ul>
                <p class="text-xs text-purple-500 mt-2">→ Empfehlung: Eigene Gewerbe-Landingpage erstellen</p>
              </div>
              <div class="bg-white rounded-lg p-3 border border-purple-100">
                <h5 class="font-medium text-purple-900 mb-2">🔧 Wartung & Reinigung</h5>
                <ul class="text-sm text-purple-700 space-y-1">
                  <li>• <strong>pv wartung leipzig</strong> - Suchvolumen: ~120/Monat</li>
                  <li>• <strong>pv reinigung leipzig</strong> - Suchvolumen: ~150/Monat</li>
                  <li>• <strong>photovoltaik reinigung</strong> - Suchvolumen: ~300/Monat</li>
                </ul>
                <p class="text-xs text-purple-500 mt-2">→ Empfehlung: Service-Seite für Wartung/Reinigung optimieren</p>
              </div>
            </div>
            <div class="mt-3 p-2 bg-purple-100 rounded text-xs text-purple-800">
              <strong>⚠️ Wichtig:</strong> Diese Keywords haben 0 Impressionen in GSC - die Website rankt aktuell nicht dafür. Neue Inhalte erforderlich!
            </div>
          </div>

          <!-- Recommendations -->
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="font-semibold text-blue-800 mb-2">💡 Empfehlungen</h4>
            <ul class="text-sm text-blue-700 space-y-2">
              <li>• <strong>"solaranlage leipzig"</strong> (Position 21.1): Haupt-Keyword auf Startseite stärker optimieren</li>
              <li>• <strong>"photovoltaik leipzig"</strong> (Position 10.5): Knapp an Top 10 - mehr interne Links setzen</li>
              <li>• <strong>"solar leipzig"</strong> (Position 20.4): Eigene Landingpage erstellen</li>
              <li>• Meta-Descriptions für Keywords mit 0 Klicks überarbeiten</li>
              <li>• <strong class="text-purple-700">NEUE LANDINGPAGES:</strong> Gewerbe, Solarpark-Wartung, PV-Reinigung</li>
            </ul>
          </div>
        </div>

        <!-- Tab: Bulk-Check -->
        <div id="contentBulkcheck" class="p-4 sm:p-6 hidden">
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">🔄 Manueller Ranking-Check</h3>
            <p class="text-sm text-gray-600">Klicke auf ein Keyword um es in Google zu überprüfen und das Ranking manuell zu aktualisieren.</p>
          </div>
          <div id="bulkCheckList" class="grid gap-2"></div>
        </div>
      </div>

    </main>
  </div>

  <!-- Guide Modal -->
  <div id="guideModal" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">📖 SEO Dashboard Anleitung</h2>
      </div>
      <div class="p-6 space-y-6">
        
        <!-- GSC Info -->
        <div class="bg-blue-50 rounded-xl p-4">
          <h4 class="font-semibold text-blue-900 mb-2">📊 Google Search Console Daten</h4>
          <p class="text-sm text-blue-700">
            Dieses Dashboard zeigt <strong>echte Daten</strong> aus der Google Search Console. 
            Die Positionen, Klicks und Impressionen stammen direkt von Google und werden regelmäßig aktualisiert.
          </p>
        </div>

        <!-- Positions -->
        <div class="bg-gray-50 rounded-xl p-4">
          <h4 class="font-semibold text-gray-900 mb-3">📍 Position verstehen</h4>
          <div class="space-y-2 text-sm">
            <div class="p-2 bg-green-50 rounded border-l-4 border-green-500">
              <strong>Position 1-10:</strong> Seite 1 bei Google - sehr gut!
            </div>
            <div class="p-2 bg-yellow-50 rounded border-l-4 border-yellow-500">
              <strong>Position 11-20:</strong> Seite 2 - mit Optimierung auf Seite 1 bringbar
            </div>
            <div class="p-2 bg-red-50 rounded border-l-4 border-red-500">
              <strong>Position 21+:</strong> Seite 3+ - mehr Arbeit nötig
            </div>
          </div>
        </div>

        <!-- CTR -->
        <div class="bg-gray-50 rounded-xl p-4">
          <h4 class="font-semibold text-gray-900 mb-3">📈 CTR (Click-Through-Rate)</h4>
          <p class="text-sm text-gray-600">
            Die CTR zeigt, wie oft ein Suchergebnis angeklickt wird. Eine niedrige CTR bei hohen Impressionen 
            bedeutet, dass der Meta-Titel und die Description optimiert werden sollten.
          </p>
        </div>

      </div>
      <div class="p-6 border-t border-gray-200 bg-gray-50 rounded-b-xl">
        <button onclick="closeGuide()" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
          Verstanden, los geht's!
        </button>
      </div>
    </div>
  </div>

  <script>
    const PASSWORD = 'leipzig2026';
    let allKeywords = [];
    let filteredKeywords = [];
    let rankingChart = null;

    // Login
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const pwd = document.getElementById('password').value;
      if (pwd === PASSWORD) {
        sessionStorage.setItem('seo_auth', 'true');
        showDashboard();
      } else {
        document.getElementById('loginError').classList.remove('hidden');
      }
    });

    // Check auth on load
    if (sessionStorage.getItem('seo_auth') === 'true') {
      showDashboard();
    }

    function showDashboard() {
      document.getElementById('loginScreen').classList.add('hidden');
      document.getElementById('dashboard').classList.remove('hidden');
      loadKeywords();
    }

    function logout() {
      sessionStorage.removeItem('seo_auth');
      location.reload();
    }

    // Load Keywords
    function loadKeywords() {
      allKeywords = getGSCKeywords();
      filteredKeywords = [...allKeywords];
      updateStats();
      displayKeywords();
      populateKeywordSelects();
      populateBulkCheckList();
      populateQuickWins();
    }

    function getGSCKeywords() {
      // ECHTE DATEN aus Google Search Console - Stand: 02.02.2026
      // Zeitraum: Letzte 3 Monate
      // Quelle: https://search.google.com/search-console/performance/search-analytics?resource_id=https://leipzig-photovoltaik.de/
      return [
        // TOP 10 GSC Keywords (sortiert nach Impressionen)
        { id: '1', keyword: 'photovoltaik leipzig', target_url: '/', position: 10.5, clicks: 14, impressions: 2157, ctr: 0.65, source: 'gsc', category: 'standort', priority: 'high' },
        { id: '2', keyword: 'solaranlage leipzig', target_url: '/', position: 21.1, clicks: 0, impressions: 814, ctr: 0, source: 'gsc', category: 'standort', priority: 'high' },
        { id: '3', keyword: 'pv anlage leipzig', target_url: '/', position: 11.5, clicks: 2, impressions: 445, ctr: 0.45, source: 'gsc', category: 'standort', priority: 'high' },
        { id: '4', keyword: 'solar leipzig', target_url: '/', position: 20.4, clicks: 0, impressions: 419, ctr: 0, source: 'gsc', category: 'standort', priority: 'high' },
        { id: '5', keyword: 'solaranlagen leipzig', target_url: '/', position: 18.2, clicks: 0, impressions: 347, ctr: 0, source: 'gsc', category: 'standort', priority: 'high' },
        { id: '6', keyword: 'pv leipzig', target_url: '/', position: 3.7, clicks: 2, impressions: 262, ctr: 0.76, source: 'gsc', category: 'standort', priority: 'high' },
        { id: '7', keyword: 'photovoltaikversicherung leipzig', target_url: '/', position: 20.6, clicks: 0, impressions: 193, ctr: 0, source: 'gsc', category: 'service', priority: 'medium' },
