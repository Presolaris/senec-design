    // Ranking History Chart
    async function loadRankingHistory() {
      const keywordId = document.getElementById('rankingKeywordSelect').value;
      if (!keywordId) return;
      
      const keyword = allKeywords.find(k => k.id === keywordId);
      
      // Demo data for chart
      const labels = [];
      const data = [];
      const today = new Date();
      
      for (let i = 30; i >= 0; i--) {
        const date = new Date(today);
        date.setDate(date.getDate() - i);
        labels.push(date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' }));
        // Simulate ranking data
        const baseRank = keyword.current_rank || 20;
        data.push(Math.max(1, baseRank + Math.floor(Math.random() * 10) - 5));
      }
      
      if (rankingChart) {
        rankingChart.destroy();
      }
      
      const ctx = document.getElementById('rankingChart').getContext('2d');
      rankingChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: keyword.keyword,
            data: data,
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              reverse: true,
              min: 1,
              max: 50,
              title: { display: true, text: 'Position' }
            }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
      
      document.getElementById('rankingDetails').innerHTML = `
        <p><strong>Keyword:</strong> ${keyword.keyword}</p>
        <p><strong>Aktuelles Ranking:</strong> Position ${keyword.current_rank || 'unbekannt'}</p>
        <p><strong>Ziel-URL:</strong> <a href="https://leipzig-photovoltaik.de${keyword.target_url}" target="_blank" class="text-blue-600 hover:underline">${keyword.target_url}</a></p>
      `;
    }

    // AI Analysis
    async function runAIAnalysis() {
      const keywordId = document.getElementById('optimizeKeywordSelect').value;
      if (!keywordId) {
        alert('Bitte wähle ein Keyword aus.');
        return;
      }
      
      const keyword = allKeywords.find(k => k.id === keywordId);
      
      // Show loading
      document.getElementById('analysisResults').classList.remove('hidden');
      document.getElementById('onPageAnalysis').innerHTML = '<p class="text-gray-500">Analyse läuft...</p>';
      
      // Simulate AI analysis
      setTimeout(() => {
        const analysis = generateOnPageAnalysis(keyword);
        displayAnalysisResults(keyword, analysis);
      }, 1500);
    }

    function generateOnPageAnalysis(keyword) {
      return {
        title: {
          status: Math.random() > 0.3 ? 'ok' : 'warning',
          value: `${keyword.keyword} | Leipzig Photovoltaik`,
          recommendation: 'Keyword am Anfang des Titels platzieren'
        },
        meta: {
          status: Math.random() > 0.5 ? 'ok' : 'warning',
          value: '145 Zeichen',
          recommendation: 'Meta-Description auf 150-160 Zeichen erweitern'
        },
        h1: {
          status: Math.random() > 0.4 ? 'ok' : 'error',
          value: keyword.keyword.includes('Leipzig') ? 'Enthält Keyword' : 'Keyword fehlt',
          recommendation: 'H1 sollte das exakte Keyword enthalten'
        },
        content: {
          status: Math.random() > 0.5 ? 'ok' : 'warning',
          value: '~1200 Wörter',
          recommendation: 'Content auf mindestens 1500 Wörter erweitern'
        },
        internalLinks: {
          status: 'ok',
          value: '5 interne Links',
          recommendation: 'Gut! Weitere relevante Seiten verlinken'
        },
        images: {
          status: Math.random() > 0.6 ? 'ok' : 'warning',
          value: '3 Bilder',
          recommendation: 'Alt-Tags mit Keyword versehen'
        }
      };
    }

    function displayAnalysisResults(keyword, analysis) {
      const statusIcon = (status) => {
        if (status === 'ok') return '✅';
        if (status === 'warning') return '⚠️';
        return '❌';
      };
      
      document.getElementById('onPageAnalysis').innerHTML = `
        <div class="bg-white rounded-lg p-3">
          <div class="flex items-center gap-2 mb-1">
            <span>${statusIcon(analysis.title.status)}</span>
            <span class="font-medium">Title-Tag</span>
          </div>
          <p class="text-sm text-gray-600">${analysis.title.value}</p>
        </div>
        <div class="bg-white rounded-lg p-3">
          <div class="flex items-center gap-2 mb-1">
            <span>${statusIcon(analysis.meta.status)}</span>
            <span class="font-medium">Meta-Description</span>
          </div>
          <p class="text-sm text-gray-600">${analysis.meta.value}</p>
        </div>
        <div class="bg-white rounded-lg p-3">
          <div class="flex items-center gap-2 mb-1">
            <span>${statusIcon(analysis.h1.status)}</span>
            <span class="font-medium">H1-Tag</span>
          </div>
          <p class="text-sm text-gray-600">${analysis.h1.value}</p>
        </div>
        <div class="bg-white rounded-lg p-3">
          <div class="flex items-center gap-2 mb-1">
            <span>${statusIcon(analysis.content.status)}</span>
            <span class="font-medium">Content-Länge</span>
          </div>
          <p class="text-sm text-gray-600">${analysis.content.value}</p>
        </div>
        <div class="bg-white rounded-lg p-3">
          <div class="flex items-center gap-2 mb-1">
            <span>${statusIcon(analysis.internalLinks.status)}</span>
            <span class="font-medium">Interne Links</span>
          </div>
          <p class="text-sm text-gray-600">${analysis.internalLinks.value}</p>
        </div>
        <div class="bg-white rounded-lg p-3">
          <div class="flex items-center gap-2 mb-1">
            <span>${statusIcon(analysis.images.status)}</span>
            <span class="font-medium">Bilder</span>
          </div>
          <p class="text-sm text-gray-600">${analysis.images.value}</p>
        </div>
      `;
      
      // Recommendations
      const recommendations = [];
      if (analysis.title.status !== 'ok') recommendations.push({ type: 'on_page', priority: 'high', text: analysis.title.recommendation });
      if (analysis.meta.status !== 'ok') recommendations.push({ type: 'on_page', priority: 'medium', text: analysis.meta.recommendation });
      if (analysis.h1.status !== 'ok') recommendations.push({ type: 'on_page', priority: 'high', text: analysis.h1.recommendation });
      if (analysis.content.status !== 'ok') recommendations.push({ type: 'content', priority: 'medium', text: analysis.content.recommendation });
      if (analysis.images.status !== 'ok') recommendations.push({ type: 'on_page', priority: 'low', text: analysis.images.recommendation });
      
      document.getElementById('recommendations').innerHTML = recommendations.map(r => `
        <div class="p-3 rounded-lg border-l-4 ${r.priority === 'high' ? 'priority-high border-red-500' : r.priority === 'medium' ? 'priority-medium border-yellow-500' : 'priority-low border-green-500'}">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-medium uppercase ${r.priority === 'high' ? 'text-red-600' : r.priority === 'medium' ? 'text-yellow-600' : 'text-green-600'}">${r.priority === 'high' ? 'Hoch' : r.priority === 'medium' ? 'Mittel' : 'Niedrig'}</span>
            <span class="text-xs text-gray-500">${r.type}</span>
          </div>
          <p class="text-sm text-gray-800">${r.text}</p>
        </div>
      `).join('') || '<p class="text-green-600">Alle Checks bestanden! 🎉</p>';
      
      // Autooptimize Prompt
      const prompt = generateAutooptimizePrompt(keyword, analysis, recommendations);
      document.getElementById('autooptimizePrompt').textContent = prompt;
    }

    function generateAutooptimizePrompt(keyword, analysis, recommendations) {
      return `AUTOOPTIMIZE PROMPT für "${keyword.keyword}"
=====================================

ZIEL: Optimiere die Seite ${keyword.target_url} für das Keyword "${keyword.keyword}"

AKTUELLE SITUATION:
- Aktuelles Ranking: Position ${keyword.current_rank || 'unbekannt'}
- Suchvolumen: ${keyword.search_volume} Suchanfragen/Monat
- Ziel-URL: https://leipzig-photovoltaik.de${keyword.target_url}

ANALYSE-ERGEBNISSE:
- Title-Tag: ${analysis.title.status === 'ok' ? '✅ OK' : '⚠️ Optimierungsbedarf'}
- Meta-Description: ${analysis.meta.status === 'ok' ? '✅ OK' : '⚠️ Optimierungsbedarf'}
- H1-Tag: ${analysis.h1.status === 'ok' ? '✅ OK' : '❌ Kritisch'}
- Content-Länge: ${analysis.content.value}
- Interne Links: ${analysis.internalLinks.value}

KONKRETE AUFGABEN:
${recommendations.map((r, i) => `${i + 1}. [${r.priority.toUpperCase()}] ${r.text}`).join('\n')}

UMSETZUNG:
1. Öffne die Datei: src/pages${keyword.target_url}.astro
2. Führe die oben genannten Optimierungen durch
3. Achte auf natürliche Keyword-Integration (keine Überoptimierung)
4. Teste die Seite nach den Änderungen

ERFOLGSKRITERIEN:
- Keyword "${keyword.keyword}" im Title (erste 60 Zeichen)
- Keyword in H1-Tag (exakt oder Variation)
- Keyword in ersten 100 Wörtern des Contents
- Mindestens 3 interne Links zu relevanten Seiten
- Alt-Tags der Bilder mit Keyword-Variationen`;
    }

    function copyAutooptimizePrompt() {
      const prompt = document.getElementById('autooptimizePrompt').textContent;
      navigator.clipboard.writeText(prompt).then(() => {
        alert('Prompt in Zwischenablage kopiert!');
      });
    }

    // Bulk Check
    function populateBulkCheckList() {
      const keywordsToCheck = allKeywords.filter(k => !k.current_rank || k.trend === 'new');
      
      document.getElementById('bulkCheckList').innerHTML = keywordsToCheck.map(k => `
        <label class="flex items-center gap-2 p-2 bg-white rounded hover:bg-gray-100 cursor-pointer">
          <input type="checkbox" class="bulk-check-item rounded" value="${k.id}" data-keyword="${k.keyword}">
          <span class="text-sm">${k.keyword}</span>
        </label>
      `).join('') || '<p class="text-gray-500 text-sm">Alle Keywords haben aktuelle Rankings.</p>';
    }

    function startBulkCheck() {
      const checked = document.querySelectorAll('.bulk-check-item:checked');
      if (checked.length === 0) {
        alert('Bitte wähle mindestens ein Keyword aus.');
        return;
      }
      
      const keywords = Array.from(checked).map(cb => ({
        id: cb.value,
        keyword: cb.dataset.keyword
      }));
      
      // Open Google searches
      keywords.forEach((k, i) => {
        setTimeout(() => {
          window.open(`https://www.google.de/search?q=${encodeURIComponent(k.keyword)}`, '_blank');
        }, i * 500);
      });
      
      // Show quick entry form
      document.getElementById('quickEntryForm').innerHTML = keywords.map(k => `
        <div class="flex items-center gap-2">
          <span class="text-sm flex-1">${k.keyword}</span>
          <input type="number" min="1" max="100" placeholder="Pos." class="w-20 px-2 py-1 border rounded text-sm" id="bulkRank_${k.id}">
          <button onclick="saveBulkRank('${k.id}')" class="px-2 py-1 bg-blue-600 text-white rounded text-xs">OK</button>
        </div>
      `).join('');
    }

    async function saveBulkRank(keywordId) {
      const rank = document.getElementById(`bulkRank_${keywordId}`).value;
      if (!rank) return;
      
      // Update in Supabase (or demo)
      const keyword = allKeywords.find(k => k.id === keywordId);
      if (keyword) {
        keyword.previous_rank_7d = keyword.current_rank;
        keyword.current_rank = parseInt(rank);
        keyword.trend = keyword.previous_rank_7d ? (rank < keyword.previous_rank_7d ? 'up' : rank > keyword.previous_rank_7d ? 'down' : 'stable') : 'new';
      }
      
      updateStats();
      displayKeywords();
      alert(`Ranking für "${keyword.keyword}" gespeichert: Position ${rank}`);
    }

    // Modals
    function showAddKeywordModal() {
      document.getElementById('addKeywordModal').classList.remove('hidden');
    }

    function closeAddKeywordModal() {
      document.getElementById('addKeywordModal').classList.add('hidden');
      document.getElementById('addKeywordForm').reset();
    }

    document.getElementById('addKeywordForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const newKeyword = {
        id: Date.now().toString(),
        keyword: document.getElementById('newKeyword').value,
        target_url: document.getElementById('newTargetUrl').value,
        category: document.getElementById('newCategory').value,
        priority: document.getElementById('newPriority').value,
        search_volume: parseInt(document.getElementById('newSearchVolume').value) || 0,
        current_rank: parseInt(document.getElementById('newCurrentRank').value) || null,
        trend: 'new'
      };
      
      allKeywords.push(newKeyword);
      filteredKeywords = [...allKeywords];
      updateStats();
      displayKeywords();
      populateKeywordSelects();
      populateBulkCheckList();
      closeAddKeywordModal();
      
      alert(`Keyword "${newKeyword.keyword}" hinzugefügt!`);
    });

    function openUpdateRankingModal(keywordId, keywordName) {
      document.getElementById('updateKeywordId').value = keywordId;
      document.getElementById('updateKeywordName').textContent = keywordName;
      document.getElementById('updateRankingModal').classList.remove('hidden');
    }

    function closeUpdateRankingModal() {
      document.getElementById('updateRankingModal').classList.add('hidden');
      document.getElementById('updateRankingForm').reset();
    }

    document.getElementById('updateRankingForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const keywordId = document.getElementById('updateKeywordId').value;
      const newRank = parseInt(document.getElementById('updateRank').value);
      
      const keyword = allKeywords.find(k => k.id === keywordId);
      if (keyword) {
        keyword.previous_rank_7d = keyword.current_rank;
        keyword.current_rank = newRank;
        keyword.trend = keyword.previous_rank_7d ? (newRank < keyword.previous_rank_7d ? 'up' : newRank > keyword.previous_rank_7d ? 'down' : 'stable') : 'new';
      }
      
      updateStats();
      displayKeywords();
      closeUpdateRankingModal();
      
      alert(`Ranking aktualisiert: Position ${newRank}`);
    });

    function openGoogleSearch(keyword) {
      window.open(`https://www.google.de/search?q=${keyword}`, '_blank');
    }

    // Guide
    function showGuide() {
      document.getElementById('guideModal').classList.remove('hidden');
    }

    function closeGuide() {
      document.getElementById('guideModal').classList.add('hidden');
    }
  </script>
</body>
</html>
