            ${k.search_volume ? k.search_volume.toLocaleString() : '-'}
          </td>
          <td class="px-4 py-3 text-center">
            <span class="px-2 py-1 rounded-full text-xs font-medium ${getPriorityClass(k.priority)}">
              ${k.priority === 'high' ? 'Hoch' : k.priority === 'medium' ? 'Mittel' : 'Niedrig'}
            </span>
          </td>
          <td class="px-4 py-3 text-center">
            <div class="flex justify-center gap-2">
              <button onclick="openUpdateRankingModal('${k.id}', '${k.keyword}')" class="p-1 text-gray-400 hover:text-blue-600" title="Ranking aktualisieren">
