---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Service', href: '/service' },
  { label: 'Solarpark Betreuung' }
];

const pageTitle = "Solarpark Betreuung Leipzig | Betriebsführung";
const pageDescription = "Solarpark Betreuung Leipzig ✓ Betriebsführung ✓ Monitoring ✓ Wartung → Jetzt anfragen!";
---

<Layout title={pageTitle} description={pageDescription}>
  <LocalBusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"@type": "ListItem", "position": 2, "name": "Solarpark Betreuung", "item": "https://leipzig-photovoltaik.de/solarpark-betreuung/"}]})}/>
<Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-[#0D1D37] text-white py-20 md:py-28 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/solarpark-hero.jpg" alt="Solarpark Betreuung - Große Freiflächenanlage in Sachsen" class="w-full h-full object-cover opacity-30" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#0D1D37]/95 to-[#0D1D37]/70"></div>
      </div>
      
      <div class="container-custom mx-auto relative z-10">
        <div class="max-w-3xl">
          <span class="text-[var(--primary-yellow)] font-bold tracking-wider uppercase mb-4 block">Professionelle Betriebsführung</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            Solarpark Betreuung – <br/>
            <span class="text-[var(--primary-turquoise)]">Betriebsführung für Freiflächenanlagen</span>
          </h1>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Ein Solarpark ist eine große Investition – und die soll sich lohnen. Mit unserer <strong>technischen Betriebsführung</strong> holen Sie das Maximum raus. Wir überwachen, warten und kümmern uns um alles in Leipzig, Sachsen und Mitteldeutschland.
          </p>
          
          <div class="flex flex-wrap gap-4 mb-8">
            <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
              <span class="text-[var(--primary-yellow)] font-bold">24/7</span>
              <span class="text-gray-300 text-sm ml-1">Monitoring</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
              <span class="text-[var(--primary-yellow)] font-bold">99,5%</span>
              <span class="text-gray-300 text-sm ml-1">Verfügbarkeit</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
              <span class="text-[var(--primary-yellow)] font-bold">15+</span>
              <span class="text-gray-300 text-sm ml-1">Jahre Erfahrung</span>
            </div>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#kontakt" class="btn-primary text-center">Beratung anfragen</a>
            <a href="#leistungen" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-gray-900 text-center">Leistungen</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Warum Betriebsführung -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-4">Warum professionelle Solarpark-Betreuung?</h2>
          <p class="text-gray-600 text-lg">20 Jahre und mehr – so lange soll Ihr Solarpark Geld verdienen. Damit das klappt, braucht er professionelle Betreuung.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-[var(--primary-blue)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[var(--primary-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Ertragsmaximierung</h3>
            <p class="text-sm text-gray-600">Bis zu 5% mehr Ertrag – das macht bei großen Anlagen richtig was aus</p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-[var(--primary-turquoise)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[var(--primary-turquoise)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Minimale Ausfallzeiten</h3>
            <p class="text-sm text-gray-600">Wenn was ist, wissen wir's sofort – und reagieren schnell</p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-[var(--primary-yellow)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[var(--primary-yellow)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Werterhalt</h3>
            <p class="text-sm text-gray-600">Wer regelmäßig wartet, erhält den Wert der Anlage</p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-[var(--primary-blue)]/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[var(--primary-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Dokumentation</h3>
            <p class="text-sm text-gray-600">Investoren und Banken wollen Zahlen – die liefern wir lückenlos</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Leistungen -->
    <section id="leistungen" class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-12 text-center">Unsere Betriebsführungsleistungen</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Leistung 1 -->
          <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">24/7 Monitoring</h3>
            <p class="text-gray-600 mb-4">Wir haben Ihre Anlage rund um die Uhr im Blick. Weicht was ab, schlagen wir sofort Alarm.</p>
            <ul class="text-sm text-gray-500 space-y-1">
              <li>• Echtzeit-Ertragsdaten</li>
              <li>• Fehlererkennung</li>
              <li>• Performance Ratio</li>
            </ul>
          </div>

          <!-- Leistung 2 -->
          <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-turquoise)]/10 text-[var(--primary-turquoise)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Technische Wartung</h3>
            <p class="text-gray-600 mb-4">Wir schauen regelmäßig nach dem Rechten und warten alles nach Herstellervorgaben – bevor was kaputtgeht.</p>
            <ul class="text-sm text-gray-500 space-y-1">
              <li>• Wechselrichter-Service</li>
              <li>• Modulprüfung</li>
              <li>• Kabelkontrolle</li>
            </ul>
          </div>

          <!-- Leistung 3 -->
          <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-yellow)]/10 text-[var(--primary-yellow)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Modulreinigung</h3>
            <p class="text-gray-600 mb-4">Saubere Module bringen mehr Ertrag. Wir reinigen mit Reinwasser – schonend und gründlich.</p>
            <ul class="text-sm text-gray-500 space-y-1">
              <li>• Großflächenreinigung</li>
              <li>• Ökologisch</li>
              <li>• Dokumentiert</li>
            </ul>
          </div>

          <!-- Leistung 4 -->
          <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Störungsmanagement</h3>
            <p class="text-gray-600 mb-4">Schnelle Reaktion bei Störungen mit eigenem Serviceteam und Ersatzteilbevorratung.</p>
            <ul class="text-sm text-gray-500 space-y-1">
              <li>• 4h Reaktionszeit</li>
              <li>• Ersatzteillager</li>
              <li>• Notdienst</li>
            </ul>
          </div>

          <!-- Leistung 5 -->
          <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-turquoise)]/10 text-[var(--primary-turquoise)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Reporting</h3>
            <p class="text-gray-600 mb-4">Monatliche und jährliche Berichte mit allen relevanten Kennzahlen für Investoren.</p>
            <ul class="text-sm text-gray-500 space-y-1">
              <li>• Ertragsberichte</li>
              <li>• Verfügbarkeitsanalyse</li>
              <li>• Benchmarking</li>
            </ul>
          </div>

          <!-- Leistung 6 -->
          <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-[var(--primary-yellow)]/10 text-[var(--primary-yellow)] rounded-xl flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-3">Grünflächenpflege</h3>
            <p class="text-gray-600 mb-4">Regelmäßige Pflege der Freiflächen zur Vermeidung von Verschattung und Schädlingsbefall.</p>
            <ul class="text-sm text-gray-500 space-y-1">
              <li>• Mäharbeiten</li>
              <li>• Zaunkontrollen</li>
              <li>• Entwässerung</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Einsatzgebiet -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-6">Unser Einsatzgebiet</h2>
            <p class="text-gray-600 mb-8">
              Wir betreuen Solarparks in Leipzig, ganz Sachsen und den angrenzenden Bundesländern. 
              Kurze Wege bedeuten schnelle Reaktionszeiten.
            </p>
            
            <div class="space-y-4">
              <div class="flex items-center">
                <svg class="w-6 h-6 text-[var(--primary-turquoise)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700"><strong>Leipzig</strong> und Umgebung (50 km)</span>
              </div>
              <div class="flex items-center">
                <svg class="w-6 h-6 text-[var(--primary-turquoise)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700"><strong>Sachsen</strong> (Dresden, Chemnitz, Zwickau)</span>
              </div>
              <div class="flex items-center">
                <svg class="w-6 h-6 text-[var(--primary-turquoise)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700"><strong>Sachsen-Anhalt</strong> (Halle, Dessau)</span>
              </div>
              <div class="flex items-center">
                <svg class="w-6 h-6 text-[var(--primary-turquoise)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700"><strong>Thüringen</strong> (Jena, Gera, Erfurt)</span>
              </div>
              <div class="flex items-center">
                <svg class="w-6 h-6 text-[var(--primary-turquoise)] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-gray-700"><strong>Brandenburg</strong> (Cottbus, Frankfurt/Oder)</span>
              </div>
            </div>
          </div>
          
          <div class="bg-gray-50 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-6">Anlagengrößen</h3>
            <div class="space-y-6">
              <div class="border-b border-gray-200 pb-4">
                <div class="flex justify-between items-center mb-2">
                  <span class="font-bold text-[var(--primary-blue)]">Kleine Solarparks</span>
                  <span class="text-[var(--primary-turquoise)] font-bold">100-500 kWp</span>
                </div>
                <p class="text-sm text-gray-500">Bürgerenergieanlagen, Landwirtschaft</p>
              </div>
              <div class="border-b border-gray-200 pb-4">
                <div class="flex justify-between items-center mb-2">
                  <span class="font-bold text-[var(--primary-blue)]">Mittlere Solarparks</span>
                  <span class="text-[var(--primary-turquoise)] font-bold">500 kWp - 5 MWp</span>
                </div>
                <p class="text-sm text-gray-500">Investorenanlagen, Kommunale Projekte</p>
              </div>
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="font-bold text-[var(--primary-blue)]">Große Solarparks</span>
                  <span class="text-[var(--primary-turquoise)] font-bold">5 MWp+</span>
                </div>
                <p class="text-sm text-gray-500">Utility-Scale, Energieversorger</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-12 text-center">Häufige Fragen zur Solarpark-Betreuung</h2>

        <div class="max-w-3xl mx-auto space-y-4">
          <details class="bg-white rounded-xl p-6 shadow-sm group">
            <summary class="font-bold text-[var(--primary-blue)] cursor-pointer list-none flex justify-between items-center">
              Was kostet die Betriebsführung eines Solarparks?
              <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-4 text-gray-600">Die Kosten richten sich nach Anlagengröße und Leistungsumfang. Typischerweise liegen sie bei 1-3% des Jahresertrags. Wir erstellen Ihnen ein individuelles Angebot.</p>
          </details>

          <details class="bg-white rounded-xl p-6 shadow-sm group">
            <summary class="font-bold text-[var(--primary-blue)] cursor-pointer list-none flex justify-between items-center">
              Übernehmen Sie auch bestehende Anlagen?
              <svg class="w-5 h-5 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
