---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Standorte', href: '/standorte' },
  { label: 'Stromspeicher Leipzig' }
];

const pageTitle = "Stromspeicher Leipzig | Batteriespeicher kaufen & installieren - Presolaris";
const pageDescription = "Stromspeicher Leipzig kaufen ➤ Bis 80% Eigenverbrauch ✓ Premium-Speicher ✓ Notstromfunktion ✓ Kostenlose Beratung ☎ 0341 98 99 03 91";
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Stromspeicher Leipzig - Batteriespeicher für Photovoltaik",
    "description": "Stromspeicher für Ihre Solaranlage in Leipzig - maximieren Sie Ihren Eigenverbrauch und werden Sie unabhängig vom Stromnetz.",
    "brand": {
      "@type": "Brand",
      "name": "Presolaris"
    },
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "5900",
      "highPrice": "15000",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "127"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Was kostet ein Stromspeicher in Leipzig?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ein Stromspeicher in Leipzig kostet je nach Kapazität zwischen 5.900€ und 15.000€. Ein 10 kWh Speicher für ein Einfamilienhaus liegt bei etwa 8.900€ inklusive Installation."
        }
      },
      {
        "@type": "Question",
        "name": "Lohnt sich ein Stromspeicher in Leipzig?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, ein Stromspeicher erhöht Ihren Eigenverbrauch von ca. 30% auf bis zu 80%. Bei steigenden Strompreisen und sinkenden Speicherkosten wird die Investition immer attraktiver."
        }
      },
      {
        "@type": "Question",
        "name": "Welche Speichergröße brauche ich?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Als Faustregel gilt: 1 kWh Speicherkapazität pro 1.000 kWh Jahresverbrauch. Ein durchschnittlicher 4-Personen-Haushalt benötigt etwa 8-10 kWh Speicherkapazität."
        }
      },
      {
        "@type": "Question",
        "name": "Kann ich einen Stromspeicher nachrüsten?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, ein Stromspeicher kann jederzeit zu einer bestehenden Solaranlage nachgerüstet werden. Wir prüfen die Kompatibilität und finden die optimale Lösung für Ihre Anlage."
        }
      }
    ]
  })} />

  <Header />
