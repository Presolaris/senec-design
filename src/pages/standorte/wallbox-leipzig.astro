              <li class="flex items-center text-gray-600">
                <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Keine Genehmigung nötig
              </li>
              <li class="flex items-center text-gray-600">
                <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                PV-Überschussladen
              </li>
            </ul>
            <a href="/kontakt" class="block w-full text-center py-3 px-6 border-2 border-[var(--senec-blue)] text-[var(--senec-blue)] font-semibold rounded-lg hover:bg-[var(--senec-blue)] hover:text-white transition-colors">
              Angebot anfordern
            </a>
          </div>
          
          <!-- 22 kW Wallbox -->
          <div class="bg-[var(--senec-blue)] rounded-2xl p-8 text-white relative shadow-2xl">
