---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Standorte', href: '/standorte' },
  { label: 'Wallbox Leipzig' }
];

const pageTitle = "Wallbox Leipzig | E-Auto Ladestation kaufen & installieren - Presolaris";
const pageDescription = "Wallbox Leipzig kaufen ➤ E-Auto mit Solarstrom laden ✓ 11 kW & 22 kW ✓ Förderung möglich ✓ Kostenlose Beratung ☎ 0341 98 99 03 91";
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Wallbox Leipzig - E-Auto Ladestation",
    "description": "Wallbox für Ihr E-Auto in Leipzig - laden Sie Ihr Elektrofahrzeug mit eigenem Solarstrom.",
    "brand": {
      "@type": "Brand",
      "name": "Presolaris"
    },
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "1200",
      "highPrice": "3500",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Was kostet eine Wallbox in Leipzig?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Eine Wallbox in Leipzig kostet zwischen 1.200€ und 3.500€ inklusive Installation. Eine 11 kW Wallbox liegt bei etwa 1.490€, eine 22 kW Wallbox bei etwa 1.890€."
        }
      },
      {
        "@type": "Question",
        "name": "Brauche ich eine Genehmigung für eine Wallbox?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Eine 11 kW Wallbox muss nur beim Netzbetreiber angemeldet werden. Für eine 22 kW Wallbox ist eine Genehmigung erforderlich. Wir kümmern uns um alle Formalitäten."
        }
      },
      {
        "@type": "Question",
        "name": "Kann ich mein E-Auto mit Solarstrom laden?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, mit einer intelligenten Wallbox und PV-Überschussladen können Sie Ihr E-Auto bevorzugt mit eigenem Solarstrom laden. So fahren Sie nahezu kostenlos und CO2-neutral."
        }
      },
      {
        "@type": "Question",
        "name": "Wie lange dauert die Installation einer Wallbox?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Die Installation einer Wallbox in Leipzig dauert in der Regel 2-4 Stunden. Inklusive Vor-Ort-Check und Anmeldung beim Netzbetreiber vergehen etwa 1-2 Wochen."
        }
      }
    ]
  })} />

  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-[var(--senec-blue)] text-white py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/hero-home.png" alt="Wallbox Leipzig - E-Auto Ladestation" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--senec-blue)] to-transparent"></div>
      </div>
      
      <div class="container-custom mx-auto relative z-10">
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            Wallbox Leipzig – <br/>
            <span class="text-[var(--senec-turquoise)]">E-Auto mit Solarstrom laden</span>
          </h1>
          <p class="text-xl text-gray-200 mb-8 leading-relaxed">
            Mit einer Wallbox in Leipzig laden Sie Ihr E-Auto bequem zu Hause – 
            am besten mit Ihrem eigenen Solarstrom. Schnell, günstig und umweltfreundlich.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--senec-turquoise)] text-[var(--senec-blue)] font-semibold rounded-lg hover:bg-white transition-all duration-300 shadow-lg hover:shadow-xl">
              Wallbox anfragen
            </a>
            <a href="tel:+4934198990391" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-[var(--senec-blue)] transition-all duration-300">
              0341 98 99 03 91
            </a>
          </div>
          
          <div class="mt-10 flex flex-wrap gap-6 text-sm">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>11 kW & 22 kW</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Förderung möglich</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Solarstrom-Integration</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Vorteile Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container-custom mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-4">
            Vorteile einer Wallbox in Leipzig
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Eine Wallbox macht das Laden Ihres E-Autos schneller, sicherer und günstiger – 
            besonders in Kombination mit einer Solaranlage.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center p-6 rounded-xl bg-gray-50 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-[var(--senec-turquoise)] rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">5x schneller laden</h3>
            <p class="text-gray-600">Mit 11 kW laden Sie bis zu 5x schneller als an der Haushaltssteckdose.</p>
          </div>
          
          <div class="text-center p-6 rounded-xl bg-gray-50 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-[var(--senec-turquoise)] rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Solarstrom nutzen</h3>
            <p class="text-gray-600">Laden Sie Ihr E-Auto mit Ihrem eigenen Solarstrom – kostenlos und CO₂-frei.</p>
          </div>
          
          <div class="text-center p-6 rounded-xl bg-gray-50 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-[var(--senec-turquoise)] rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Sicher laden</h3>
            <p class="text-gray-600">Wallboxen sind speziell für E-Auto-Ladung konzipiert – sicher und zuverlässig.</p>
          </div>
          
          <div class="text-center p-6 rounded-xl bg-gray-50 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-[var(--senec-turquoise)] rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Förderung nutzen</h3>
            <p class="text-gray-600">Profitieren Sie von staatlichen Förderungen für Ihre Wallbox in Leipzig.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Wallbox-Pakete Section -->
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-4">
            Wallbox Leipzig – Unsere Pakete
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Wählen Sie die passende Wallbox für Ihr E-Auto in Leipzig.
