        </div>        
        <!-- CTA Button nach FAQ -->
        <div class="text-center mt-12">
          <a href="/kontakt" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--senec-turquoise)] text-white font-semibold rounded-lg hover:bg-[var(--senec-blue)] transition-all duration-300 shadow-lg text-lg" data-cta-tracking data-cta-position="faq_section">
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Jetzt kostenlosen Beratungstermin vereinbaren
