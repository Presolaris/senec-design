---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Standorte', href: '/standorte' },
  { label: 'Photovoltaik Firma Leipzig' }
];

const pageTitle = "Photovoltaik Firma Leipzig | Presolaris - Ihr lokaler Fachbetrieb";
const pageDescription = "Photovoltaik Firma Leipzig ➤ Presolaris - Ihr lokaler Partner ✓ Über 500 Anlagen ✓ Komplettservice ✓ Kostenlose Beratung ☎ 0341 98 99 03 91";
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://leipzig-photovoltaik.de/standorte/photovoltaik-firma-leipzig#business",
    "name": "Presolaris - Photovoltaik Firma Leipzig",
    "image": "https://leipzig-photovoltaik.de/images/logo.webp",
    "description": "Photovoltaik Firma in Leipzig - Ihr lokaler Partner für Solaranlagen, Stromspeicher und Wallboxen.",
    "url": "https://leipzig-photovoltaik.de/standorte/photovoltaik-firma-leipzig",
    "telephone": "+49-341-98990391",
    "email": "info@leipzig-photovoltaik.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "An der Hebemarie 7",
      "addressLocality": "Leipzig",
      "postalCode": "04316",
      "addressRegion": "Sachsen",
      "addressCountry": "DE"
    },
    "priceRange": "€€€",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "127"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Warum eine lokale Photovoltaik Firma wählen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Eine lokale Photovoltaik Firma wie Presolaris in Leipzig bietet persönliche Beratung, schnellen Service vor Ort und kennt die regionalen Gegebenheiten. Bei Fragen oder Problemen sind wir schnell bei Ihnen."
        }
      },
      {
        "@type": "Question",
        "name": "Welche Leistungen bietet Presolaris als Photovoltaik Firma?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Wir bieten das komplette Spektrum: Beratung, Planung, Installation, Inbetriebnahme und Wartung von Photovoltaikanlagen, Stromspeichern und Wallboxen. Alles aus einer Hand."
        }
      },
      {
        "@type": "Question",
        "name": "Wie viele Anlagen hat Presolaris bereits installiert?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Als etablierte Photovoltaik Firma in Leipzig haben wir bereits über 500 Anlagen in der Region installiert. Unsere Erfahrung garantiert Qualität und zuverlässige Installation."
        }
      },
      {
        "@type": "Question",
        "name": "Bietet Presolaris auch Service nach der Installation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, wir bieten umfassenden After-Sales-Service: regelmäßige Wartung, Monitoring, schnelle Reparaturen und Erweiterungen Ihrer Anlage. Wir sind langfristig für Sie da."
        }
      }
    ]
  })} />

  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-[var(--senec-blue)] text-white py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img loading="lazy" src="/images/hero-home.png" alt="Photovoltaik Firma Leipzig - Presolaris Team" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--senec-blue)] to-transparent"></div>
      </div>
      
      <div class="container-custom mx-auto relative z-10">
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            Photovoltaik Firma Leipzig – <br/>
            <span class="text-[var(--senec-turquoise)]">Presolaris - Ihr lokaler Partner</span>
          </h1>
          <p class="text-xl text-gray-200 mb-8 leading-relaxed">
            Als etablierte Photovoltaik Firma in Leipzig bieten wir Ihnen Komplettlösungen 
            für Solaranlagen, Stromspeicher und Wallboxen – alles aus einer Hand.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/kontakt" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--senec-turquoise)] text-[var(--senec-blue)] font-semibold rounded-lg hover:bg-white transition-all duration-300 shadow-lg hover:shadow-xl">
              Kostenlose Beratung
            </a>
            <a href="tel:+4934198990391" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-[var(--senec-blue)] transition-all duration-300">
              0341 98 99 03 91
            </a>
          </div>
          
          <div class="mt-10 flex flex-wrap gap-6 text-sm">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Lokale Photovoltaik Firma</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>500+ Projekte</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-[var(--senec-turquoise)] mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>4.9★ Bewertung</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Über uns Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container-custom mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-6">
              Presolaris – Ihre Photovoltaik Firma in Leipzig
            </h2>
            <p class="text-gray-600 mb-6">
              Als lokale Photovoltaik Firma in Leipzig sind wir Ihr kompetenter Partner für alle 
              Fragen rund um Solarenergie. Unser erfahrenes Team berät Sie persönlich und 
              realisiert Ihr Projekt von der Planung bis zur Inbetriebnahme.
            </p>
            <p class="text-gray-600 mb-8">
              Mit über 500 erfolgreich installierten Anlagen in Leipzig und Umgebung haben wir 
              uns als zuverlässige Photovoltaik Firma etabliert. Unsere Kunden schätzen unsere 
              Fachkompetenz, faire Preise und den persönlichen Service.
            </p>
            
            <div class="grid grid-cols-2 gap-6">
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-3xl font-bold text-[var(--senec-turquoise)]">500+</div>
                <div class="text-gray-600 text-sm">Installierte Anlagen</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-3xl font-bold text-[var(--senec-turquoise)]">4.9★</div>
                <div class="text-gray-600 text-sm">Kundenbewertung</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-3xl font-bold text-[var(--senec-turquoise)]">10+</div>
                <div class="text-gray-600 text-sm">Jahre Erfahrung</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-xl">
                <div class="text-3xl font-bold text-[var(--senec-turquoise)]">50+</div>
                <div class="text-gray-600 text-sm">Mitarbeiter</div>
              </div>
            </div>
          </div>
          
          <div class="relative">
            <img loading="lazy" src="/images/hero-home.png" alt="Photovoltaik Firma Leipzig - Unser Team" class="rounded-2xl shadow-2xl" />
          </div>
        </div>
      </div>
    </section>

    <!-- Leistungen Section -->
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-4">
            Unsere Leistungen als Photovoltaik Firma
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Als Ihre Photovoltaik Firma in Leipzig bieten wir Ihnen das komplette Spektrum 
            an Solarlösungen für Privat und Gewerbe.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <a href="/privat" class="bg-white p-8 rounded-xl hover:shadow-xl transition-shadow group">
            <div class="w-12 h-12 bg-[var(--senec-turquoise)] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Photovoltaik für Privat</h3>
            <p class="text-gray-600">Solaranlagen für Einfamilienhäuser und Mehrfamilienhäuser in Leipzig.</p>
          </a>
          
          <a href="/gewerbe" class="bg-white p-8 rounded-xl hover:shadow-xl transition-shadow group">
            <div class="w-12 h-12 bg-[var(--senec-turquoise)] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Photovoltaik für Gewerbe</h3>
            <p class="text-gray-600">Große Solaranlagen für Unternehmen, Industrie und Landwirtschaft.</p>
          </a>
          
          <a href="/stromspeicher" class="bg-white p-8 rounded-xl hover:shadow-xl transition-shadow group">
            <div class="w-12 h-12 bg-[var(--senec-turquoise)] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Stromspeicher</h3>
            <p class="text-gray-600">Batteriespeicher für maximalen Eigenverbrauch und Unabhängigkeit.</p>
          </a>
          
          <a href="/wallbox" class="bg-white p-8 rounded-xl hover:shadow-xl transition-shadow group">
            <div class="w-12 h-12 bg-[var(--senec-turquoise)] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Wallboxen</h3>
            <p class="text-gray-600">Ladestationen für E-Autos – laden Sie mit eigenem Solarstrom.</p>
          </a>
          
          <a href="/service" class="bg-white p-8 rounded-xl hover:shadow-xl transition-shadow group">
            <div class="w-12 h-12 bg-[var(--senec-turquoise)] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Wartung & Service</h3>
            <p class="text-gray-600">Regelmäßige Wartung und schneller Service für Ihre Anlage.</p>
          </a>
          
          <a href="/heizung" class="bg-white p-8 rounded-xl hover:shadow-xl transition-shadow group">
            <div class="w-12 h-12 bg-[var(--senec-turquoise)] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[var(--senec-blue)] mb-2">Wärmepumpen</h3>
            <p class="text-gray-600">Heizen Sie mit Solarstrom – Wärmepumpen für maximale Effizienz.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
