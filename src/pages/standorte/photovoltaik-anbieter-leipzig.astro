---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Standorte', href: '/standorte' },
  { label: 'Photovoltaik Anbieter Leipzig' }
];

const pageTitle = "Photovoltaik Anbieter Leipzig | Ihr lokaler Fachbetrieb - Presolaris";
const pageDescription = "Photovoltaik Anbieter Leipzig gesucht? ➤ Presolaris - Ihr zertifizierter Fachbetrieb ✓ Über 500 Anlagen installiert ✓ Kostenlose Beratung ☎ 0341 98 99 03 91";
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://leipzig-photovoltaik.de/standorte/photovoltaik-anbieter-leipzig#business",
    "name": "Presolaris - Photovoltaik Anbieter Leipzig",
    "image": "https://leipzig-photovoltaik.de/images/logo.webp",
    "description": "Photovoltaik Anbieter in Leipzig - Ihr zertifizierter Fachbetrieb für Solaranlagen, Stromspeicher und Wallboxen.",
    "url": "https://leipzig-photovoltaik.de/standorte/photovoltaik-anbieter-leipzig",
    "telephone": "+49-341-98990391",
    "email": "info@leipzig-photovoltaik.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "An der Hebemarie 7",
      "addressLocality": "Leipzig",
      "postalCode": "04316",
      "addressRegion": "Sachsen",
      "addressCountry": "DE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 51.3396955,
      "longitude": 12.3730747
    },
    "areaServed": {
      "@type": "City",
      "name": "Leipzig"
    },
    "priceRange": "€€€",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "127"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wie finde ich den richtigen Photovoltaik Anbieter in Leipzig?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Achten Sie auf Zertifizierungen, Erfahrung (Anzahl installierter Anlagen), Kundenbewertungen und regionale Präsenz. Ein guter Photovoltaik Anbieter bietet kostenlose Vor-Ort-Beratung und transparente Angebote."
        }
      },
      {
        "@type": "Question",
        "name": "Was unterscheidet Presolaris von anderen Photovoltaik Anbietern?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Als zertifizierter SENEC-Partner bieten wir Premium-Qualität, über 500 installierte Anlagen in der Region, eigene Montage-Teams und langjährige Garantien. Wir sind Ihr lokaler Ansprechpartner in Leipzig."
        }
      },
      {
        "@type": "Question",
        "name": "Bietet Presolaris auch Wartung und Service an?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, als Full-Service Photovoltaik Anbieter in Leipzig bieten wir regelmäßige Wartung, schnellen Reparaturservice und Monitoring Ihrer Anlage. So garantieren wir maximale Erträge über die gesamte Lebensdauer."
        }
      },
      {
        "@type": "Question",
        "name": "Wie lange dauert es vom ersten Kontakt bis zur fertigen Anlage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Von der ersten Beratung bis zur Inbetriebnahme vergehen in der Regel 4-8 Wochen. Die eigentliche Installation dauert nur 1-3 Tage. Wir kümmern uns um alle Genehmigungen und die Anmeldung beim Netzbetreiber."
        }
      }
    ]
  })} />

  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-[var(--senec-blue)] text-white py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img loading="lazy" src="/images/hero-home.webp" alt="Photovoltaik Anbieter Leipzig - Solaranlage Installation" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--senec-blue)] to-transparent"></div>
      </div>
      
