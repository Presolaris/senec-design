        </div>
        
        <!-- CTA Button nach FAQ -->
        <div class="text-center mt-12">
          <a href="/kontakt/" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--primary-turquoise)] text-white font-semibold rounded-lg hover:bg-[var(--primary-blue)] transition-all duration-300 shadow-lg text-lg" data-cta-tracking data-cta-position="faq_section">
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Jetzt kostenlosen Beratungstermin vereinbaren
          </a>
          <p class="text-gray-600 text-sm mt-4">Unverbindlich • Kostenlos • Vor Ort in Leipzig</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-24 bg-[var(--primary-blue)] text-white">
      <div class="container-custom mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Ihr Solarteur in Leipzig berät Sie gerne
        </h2>
        <p class="text-xl text-gray-200 mb-8 max-w-2xl mx-auto">
          Kontaktieren Sie uns für eine kostenlose Beratung. Als erfahrener Solarteur 
          in Leipzig finden wir die optimale Lösung für Ihr Dach.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/kontakt/" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--primary-turquoise)] text-[var(--primary-blue)] font-semibold rounded-lg hover:bg-white transition-all duration-300 shadow-lg">
            Kostenlose Beratung anfragen
          </a>
          <a href="tel:+4934198990391" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-[var(--primary-blue)] transition-all duration-300">
            0341 98 99 03 91
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
