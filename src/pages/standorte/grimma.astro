---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Standorte', href: '/standorte' },
  { label: 'Grimma' }
];

const pageTitle = "Photovoltaik Grimma | Solaranlage";
const pageDescription = "Photovoltaik Grimma ➤ Solaranlage vom regionalen Fachbetrieb ✓ Bis 80% Stromkosten sparen ✓ Kostenlose Beratung ☎ 0341 98 99 03 91";
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://leipzig-photovoltaik.de/standorte/grimma#business",
    "name": "Presolaris - Photovoltaik Grimma",
    "image": "https://leipzig-photovoltaik.de/images/logo.webp",
    "description": "Photovoltaik-Fachbetrieb in Grimma für Solaranlagen, Stromspeicher und Wallboxen. Kostenlose Beratung und Installation aus einer Hand.",
    "url": "https://leipzig-photovoltaik.de/standorte/grimma",
    "telephone": "+49-341-98990391",
    "email": "info@leipzig-photovoltaik.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "An der Hebemärchte 1",
      "addressLocality": "Grimma",
      "postalCode": "04668",
      "addressRegion": "Sachsen",
      "addressCountry": "DE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 51.2344,
      "longitude": 12.7230
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Grimma"
      },
      {
        "@type": "Place",
        "name": "Höfgen"
      },
      {
        "@type": "Place",
        "name": "Nerchau"
      },
      {
        "@type": "Place",
        "name": "Großbothen"
      },
      {
        "@type": "Place",
        "name": "Muldental"
      }
    ],
    "priceRange": "€€€",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "18:00"
      }
    ]
  })} />
  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-[var(--senec-blue)] text-white py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img loading="lazy" src="/images/hero-home.webp" alt="Photovoltaik Grimma - Solaranlage Installation im Muldental" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--senec-blue)] to-transparent"></div>
      </div>
      
      <div class="container-custom mx-auto relative z-10">
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            Photovoltaik Grimma – <br/>
            <span class="text-[var(--senec-turquoise)]">Ihr Fachbetrieb im Muldental</span>
          </h1>
          <p class="text-xl text-gray-200 mb-8 leading-relaxed">
            Photovoltaik Grimma vom regionalen Fachbetrieb: Solaranlagen für Privat und Gewerbe im Muldental. 
            Von der Beratung bis zur Inbetriebnahme – alles aus einer Hand. Bis zu 80% Stromkosten sparen.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/#rechner" class="btn-accent text-center">
              Sparpotenzial berechnen
            </a>
            <a href="/kontakt/" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-[var(--senec-blue)] text-center">
              Kostenlose Beratung
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Warum Photovoltaik in Grimma Section -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
          Warum Photovoltaik in <span class="text-[var(--senec-turquoise)]">Grimma?</span>
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gray-50 p-8 rounded-2xl">
            <div class="text-4xl mb-4">☀️</div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Sonniges Muldental</h3>
            <p class="text-gray-700 leading-relaxed">
              Grimma im Muldental profitiert von optimalen Sonnenstunden und südlicher Ausrichtung. 
              Ideale Bedingungen für hohe Solarerträge.
            </p>
          </div>

          <div class="bg-gray-50 p-8 rounded-2xl">
            <div class="text-4xl mb-4">💰</div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Hohe Einsparungen</h3>
            <p class="text-gray-700 leading-relaxed">
              Mit Strompreisen von über 40 Cent/kWh lohnt sich Photovoltaik in Grimma besonders. 
              Produzieren Sie Ihren eigenen Strom für nur 8-12 Cent/kWh.
            </p>
          </div>

          <div class="bg-gray-50 p-8 rounded-2xl">
            <div class="text-4xl mb-4">🏡</div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">Historische Stadt</h3>
            <p class="text-gray-700 leading-relaxed">
              Auch für denkmalgeschützte Gebäude in der Altstadt bieten wir passende Lösungen. 
              Photovoltaik trifft auf Tradition.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Unsere Leistungen Section -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
          Unsere Leistungen in <span class="text-[var(--senec-turquoise)]">Grimma</span>
        </h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Photovoltaik für Privathaushalte</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Solaranlagen für Einfamilienhäuser und Reihenhäuser in Grimma. 
              Individuelle Planung für maximale Autarkie.
            </p>
            <a href="/privat/" class="text-[var(--senec-turquoise)] font-semibold hover:underline">Mehr erfahren →</a>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Gewerbe & Industrie</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Großanlagen für Unternehmen und Gewerbeflächen. 
              Senken Sie Ihre Energiekosten nachhaltig.
            </p>
            <a href="/gewerbe/" class="text-[var(--senec-turquoise)] font-semibold hover:underline">Mehr erfahren →</a>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Stromspeicher</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Erhöhen Sie Ihre Unabhängigkeit mit modernen Batteriespeichern. 
              Bis zu 80% Autarkie möglich.
            </p>
            <a href="/stromspeicher/" class="text-[var(--senec-turquoise)] font-semibold hover:underline">Mehr erfahren →</a>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Wallbox & E-Mobilität</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Laden Sie Ihr E-Auto mit eigenem Solarstrom. 
              Installation und Anmeldung beim Netzbetreiber inklusive.
            </p>
            <a href="/wallbox/" class="text-[var(--senec-turquoise)] font-semibold hover:underline">Mehr erfahren →</a>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Wartung & Service</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Regelmäßige Wartung und schneller Reparaturservice für Ihre Anlage. 
              Maximale Erträge garantiert.
            </p>
            <a href="/service/" class="text-[var(--senec-turquoise)] font-semibold hover:underline">Mehr erfahren →</a>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Beratung & Planung</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Kostenlose Vor-Ort-Beratung und detaillierte Wirtschaftlichkeitsberechnung. 
              Transparent und unverbindlich.
            </p>
            <a href="/kontakt/" class="text-[var(--senec-turquoise)] font-semibold hover:underline">Jetzt Termin vereinbaren →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Ortsteile Section -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
          Wir sind in ganz <span class="text-[var(--senec-turquoise)]">Grimma</span> für Sie da
        </h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
          <div class="bg-gray-50 p-6 rounded-xl">
            <h3 class="font-bold text-gray-900 mb-2">Grimma-Zentrum</h3>
            <p class="text-gray-700 text-sm">Photovoltaik für Altstadt und Wohngebiete</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-xl">
            <h3 class="font-bold text-gray-900 mb-2">Höfgen</h3>
            <p class="text-gray-700 text-sm">Solaranlagen für Einfamilienhäuser</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-xl">
            <h3 class="font-bold text-gray-900 mb-2">Nerchau</h3>
            <p class="text-gray-700 text-sm">PV-Anlagen für ländliche Gebiete</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-xl">
            <h3 class="font-bold text-gray-900 mb-2">Großbothen</h3>
            <p class="text-gray-700 text-sm">Photovoltaik für Landwirtschaft</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-xl">
            <h3 class="font-bold text-gray-900 mb-2">Muldental</h3>
            <p class="text-gray-700 text-sm">Solaranlagen für die gesamte Region</p>
          </div>
          <div class="bg-gray-50 p-6 rounded-xl">
            <h3 class="font-bold text-gray-900 mb-2">Landkreis Leipzig</h3>
            <p class="text-gray-700 text-sm">PV-Anlagen für alle Ortsteile</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-[var(--senec-turquoise)] text-white">
      <div class="container-custom mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Bereit für Ihre eigene Solaranlage in Grimma?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Lassen Sie sich jetzt kostenlos beraten und erfahren Sie, wie viel Sie mit Photovoltaik sparen können.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#rechner" class="btn-accent bg-white text-[var(--senec-turquoise)] hover:bg-gray-100 text-center">
            Sparpotenzial berechnen
          </a>
          <a href="/kontakt/" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-[var(--senec-turquoise)] text-center">
            Kostenlose Beratung
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
