---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Kontakt' }
];

const pageTitle = "Kontakt | Leipzig Photovoltaik-Design Leipzig";
const metaDescription = "Kontakt Photovoltaik Leipzig ✓ Kostenlose Beratung ✓ Vor-Ort-Termin ✓ Unverbindliches Angebot ✓ Schnelle Rückmeldung. Jetzt Kontakt aufnehmen!";
const pageDescription = "Ihr direkter Draht zu uns. Vereinbaren Sie jetzt Ihren kostenlosen Beratungstermin für Photovoltaik in Leipzig.";
---

<Layout title={pageTitle} description={metaDescription} description={pageDescription} image="/images/og/photovoltaik-leipzig-kontakt-beratung.jpg">
  <link rel="canonical" href="https://leipzig-photovoltaik.de/kontakt/" slot="head" />
  <!-- OpenGraph Tags -->
  <meta property="og:title" content="Kontakt - Photovoltaik Leipzig | Presolaris" slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content="https://leipzig-photovoltaik.de/kontakt/" slot="head" />
  <meta property="og:image" content="https://files.manuscdn.com/user_upload_by_module/session_file/106328554/AvVCLijVXIvFwFdr.jpg" slot="head" />
  <meta property="og:description" content="Kontakt Photovoltaik Leipzig: Kostenlose Beratung ✓ Angebot in 24h ✓ Vor-Ort-Termin ✓ Tel: 0341 2425 8830. Jetzt Kontakt aufnehmen!" slot="head" />
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"@type": "ListItem", "position": 2, "name": "Kontakt", "item": "https://leipzig-photovoltaik.de/kontakt/"}]})}/>
  <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Wie schnell erhalte ich ein Angebot?", "acceptedAnswer": {"@type": "Answer", "text": "Innerhalb von 24 Stunden nach Ihrer Anfrage erhalten Sie ein unverbindliches, individuelles Angebot per E-Mail. Bei dringenden Anfragen rufen wir Sie auch gerne direkt an."}}, {"@type": "Question", "name": "Ist die Beratung kostenlos?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, die Erstberatung, Vor-Ort-Besichtigung und Angebotserstellung sind komplett kostenlos und unverbindlich. Sie zahlen erst, wenn Sie sich für eine Installation entscheiden."}}, {"@type": "Question", "name": "Wie erreiche ich den Kundenservice?", "acceptedAnswer": {"@type": "Answer", "text": "Telefonisch unter +49-341-98990391 (Mo-Fr 8-18 Uhr), per E-Mail an info@leipzig-photovoltaik.de oder über unser Kontaktformular. Wir antworten innerhalb von 24 Stunden."}}, {"@type": "Question", "name": "Bieten Sie auch Wartung und Reparatur an?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, wir bieten Wartungsverträge, Störungsbehebung, Reparaturen und Anlagenerweiterungen an – auch für Anlagen, die wir nicht installiert haben. Kontaktieren Sie uns für ein individuelles Service-Angebot."}}]})}/>
<Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <section class="bg-[#0D1D37] text-white py-16 md:py-24">
      <div class="container-custom mx-auto text-center max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Lassen Sie uns sprechen.</h1>
        <p class="text-xl text-gray-300 leading-relaxed">
          Sie haben Fragen oder möchten ein Angebot? Wir sind für Sie da. 
          Persönlich, kompetent und direkt in Ihrer Nähe.
        </p>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          
          <!-- Contact Info -->
          <div>
            <h2 class="text-3xl font-bold text-[var(--primary-blue)] mb-8">Unsere Kontaktdaten</h2>
            
            <div class="space-y-8">
              <div class="flex items-start">
                <div class="w-12 h-12 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="ml-6">
                  <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Anschrift</h3>
                  <p class="text-gray-600 leading-relaxed">
                    Presolaris UG (haftungsbeschränkt)<br/>
                    An der Hebemärchte 1<br/>
                    04316 Leipzig
                  </p>
                </div>
              </div>

              <div class="flex items-start">
                <div class="w-12 h-12 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="ml-6">
                  <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">Telefon</h3>
                  <p class="text-gray-600 leading-relaxed mb-2">
                    <a href="tel:+493419899391" class="hover:text-[var(--primary-turquoise)] transition-colors">+49 341 98 99 03 91</a>
                  </p>
                  <p class="text-sm text-gray-500">
                    Mo - Fr: 08:00 - 18:00 Uhr
                  </p>
                </div>
              </div>

              <div class="flex items-start">
                <div class="w-12 h-12 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="ml-6">
                  <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-2">E-Mail</h3>
                  <p class="text-gray-600 leading-relaxed">
                    <a href="mailto:kontakt@leipzig-photovoltaik.de" class="hover:text-[var(--primary-turquoise)] transition-colors">kontakt@leipzig-photovoltaik.de</a>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Form -->
          <div class="bg-gray-50 p-8 md:p-10 rounded-2xl border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-6">Nachricht senden</h2>
            
            <!-- Success Message -->
            <div id="success-message" class="hidden mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
              <div class="flex items-center text-green-800">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="font-medium">Vielen Dank! Ihre Nachricht wurde erfolgreich versendet.</span>
              </div>
            </div>

            <!-- Error Message -->
            <div id="error-message" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
              <div class="flex items-center text-red-800">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span class="font-medium">Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.</span>
              </div>
            </div>
            
            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
              <!-- Web3Forms Access Key -->
              <input type="hidden" name="access_key" value="431d34db-0d21-4978-a355-31b6fbaaec6e">
              
              <!-- Redirect URL after submission -->
              <input type="hidden" name="redirect" value="false">
              
              <!-- Email configuration -->
              <input type="hidden" name="email" value="kontakt@leipzig-photovoltaik.de">
              <input type="hidden" name="subject" value="Neue Kontaktanfrage von leipzig-photovoltaik.de">
              
              <!-- Honeypot for spam protection -->
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-bold text-gray-900 mb-2">Vorname *</label>
                  <input type="text" name="vorname" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" />
                </div>
                <div>
                  <label class="block text-sm font-bold text-gray-900 mb-2">Nachname *</label>
                  <input type="text" name="nachname" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" />
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-900 mb-2">E-Mail Adresse *</label>
                <input type="email" name="email_from" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" />
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-900 mb-2">Telefonnummer *</label>
                <input 
                  type="tel" 
                  name="telefon" 
                  required
                  pattern="^[\+]?[(]?[0-9]{1,4}[)]?[-\s\.]?[(]?[0-9]{1,4}[)]?[-\s\.]?[0-9]{1,9}$"
                  placeholder="z.B. 0341 1234567 oder +49 341 1234567"
                  title="Bitte geben Sie eine gültige Telefonnummer ein"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" 
                />
              </div>
              
              <!-- PLZ und Ort (Pflicht) -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-bold text-gray-900 mb-2">PLZ *</label>
                  <input 
                    type="text" 
                    name="plz" 
                    required
                    pattern="[0-9]{5}"
                    placeholder="04103"
                    title="Bitte geben Sie eine gültige 5-stellige PLZ ein"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
                  />
                </div>
                <div>
                  <label class="block text-sm font-bold text-gray-900 mb-2">Ort *</label>
                  <input 
                    type="text" 
                    name="ort" 
                    required
                    placeholder="Leipzig"
                    minlength="2"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
                  />
                </div>
              </div>
              
              <!-- Straße und Hausnummer (Optional) -->
              <div class="grid grid-cols-3 gap-6">
                <div class="col-span-2">
                  <label class="block text-sm font-bold text-gray-900 mb-2">Straße (optional)</label>
                  <input 
                    type="text" 
                    name="strasse" 
                    placeholder="Musterstraße"
                    maxlength="100"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
                  />
                </div>
                <div>
                  <label class="block text-sm font-bold text-gray-900 mb-2">Nr. (optional)</label>
                  <input 
                    type="text" 
                    name="hausnummer" 
                    placeholder="12a"
                    pattern="[0-9]{1,5}[a-zA-Z]?"
                    title="z.B. 12 oder 12a"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-900 mb-2">Ihr Anliegen</label>
                <select name="anliegen" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent">
                  <option>Allgemeine Anfrage</option>
                  <option>Beratungstermin PV-Anlage</option>
                  <option>Angebot anfordern</option>
                  <option>Service / Wartung</option>
                  <option>Karriere</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-900 mb-2">Nachricht</label>
                <textarea name="nachricht" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"></textarea>
              </div>

              <div class="flex items-start">
                <input type="checkbox" required id="privacy" name="datenschutz" class="mt-1 mr-3" />
                <label for="privacy" class="text-sm text-gray-600">
                  Ich stimme zu, dass meine Angaben zur Kontaktaufnahme und Zuordnung für eventuelle Rückfragen dauerhaft gespeichert werden. Hinweis: Diese Einwilligung können Sie jederzeit mit Wirkung für die Zukunft widerrufen. Siehe <a href="/datenschutz/" class="underline hover:text-[var(--primary-blue)]">Datenschutzerklärung</a>.
                </label>
              </div>

              <button type="submit" id="submit-button" class="btn-primary w-full py-4 text-lg">
                <span id="button-text">Nachricht absenden</span>
                <span id="button-loading" class="hidden">
                  <svg class="animate-spin h-5 w-5 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO Text Section -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-6">Photovoltaik-Beratung in Leipzig – Persönlich und kompetent</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Sie überlegen, ob sich eine Solaranlage für Sie lohnt? Wir sagen es Ihnen – ehrlich und transparent. Keine Standardantworten, keine Verkaufsmaschen. Wir schauen uns Ihr Dach an, rechnen Ihren Verbrauch durch und zeigen Ihnen konkret, was möglich ist. Kostenlos und unverbindlich.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Viele unserer Kunden kommen mit denselben Fragen: Lohnt sich das überhaupt? Was kostet eine Anlage? Wie lange dauert die Installation? Und: Was passiert, wenn mal was nicht funktioniert? Alles berechtigte Fragen. Und genau dafür sind wir da. Wir nehmen uns Zeit für Sie – am Telefon, per E-Mail oder direkt bei Ihnen vor Ort.
          </p>
          
          <h3 class="text-xl font-bold text-[var(--primary-blue)] mt-8 mb-4">So läuft Ihre Beratung ab</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Schritt 1: Sie schicken uns ein paar Eckdaten – Adresse, Dachfläche, Stromverbrauch. Das reicht für eine erste Einschätzung. Schritt 2: Wir melden uns innerhalb von 24 Stunden und besprechen Ihre Situation. Schritt 3: Wenn Sie möchten, kommen wir vorbei und schauen uns alles vor Ort an. Danach bekommen Sie ein konkretes Angebot – mit Festpreis-Garantie.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Keine versteckten Kosten, keine Überraschungen. Was im Angebot steht, gilt. Und wenn Sie sich dagegen entscheiden? Auch kein Problem. Wir drängen niemanden. Photovoltaik muss sich rechnen – für Sie, nicht für uns.
          </p>
          
          <h3 class="text-xl font-bold text-[var(--primary-blue)] mt-8 mb-4">Warum Sie uns vertrauen können</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Wir sind seit über 15 Jahren in Leipzig aktiv. Über 2.400 Anlagen haben wir installiert – von kleinen Einfamilienhäusern bis zu großen Gewerbehallen. Unsere Kunden bewerten uns mit 4,9 von 5 Sternen. Warum? Weil wir tun, was wir versprechen. Termine halten wir ein. Qualität ist uns wichtig. Und wenn doch mal was schiefgeht? Dann kümmern wir uns sofort darum.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Viele unserer Kunden kommen über Empfehlungen zu uns. Das freut uns besonders. Denn es zeigt: Die Leute sind zufrieden. Und genau das ist unser Anspruch. Nicht der günstigste Preis, sondern das beste Gesamtpaket. Qualität, Service und faire Konditionen.
          </p>
          
          <h3 class="text-xl font-bold text-[var(--primary-blue)] mt-8 mb-4">Häufige Fragen zur Photovoltaik-Beratung</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            <strong>Kostet die Beratung etwas?</strong> Nein. Die erste Beratung ist immer kostenlos. Auch die Vor-Ort-Besichtigung kostet Sie nichts.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            <strong>Wie schnell bekomme ich ein Angebot?</strong> In der Regel innerhalb von 2-3 Werktagen. Wenn es schneller gehen muss, sagen Sie uns Bescheid – wir finden eine Lösung.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            <strong>Muss ich mich sofort entscheiden?</strong> Auf keinen Fall. Nehmen Sie sich Zeit. Vergleichen Sie Angebote. Wir bleiben Ihr Ansprechpartner – auch wenn Sie erst in ein paar Monaten starten wollen.
          </p>
          <p class="text-gray-700 leading-relaxed">
            <strong>Was passiert nach der Bestellung?</strong> Wir kümmern uns um alles: Planung, Genehmigungen, Installation, Anmeldung beim Netzbetreiber. Sie müssen sich um nichts kümmern. Nach 2-3 Tagen ist Ihre Anlage fertig – und Sie produzieren Ihren eigenen Strom.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl font-bold text-[var(--primary-blue)] mb-12 text-center">Häufig gestellte Fragen</h2>
        <div class="max-w-4xl mx-auto space-y-6">
          <details class="bg-gray-50 rounded-lg p-6 group">
            <summary class="font-bold text-lg text-[var(--primary-blue)] cursor-pointer list-none flex justify-between items-center">
              Wie schnell erhalte ich ein Angebot?
              <span class="text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-700 leading-relaxed">Innerhalb von 24 Stunden nach Ihrer Anfrage erhalten Sie ein unverbindliches, individuelles Angebot per E-Mail. Bei dringenden Anfragen rufen wir Sie auch gerne direkt an.</p>
          </details>
          <details class="bg-gray-50 rounded-lg p-6 group">
            <summary class="font-bold text-lg text-[var(--primary-blue)] cursor-pointer list-none flex justify-between items-center">
              Ist die Beratung kostenlos?
              <span class="text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-700 leading-relaxed">Ja, die Erstberatung, Vor-Ort-Besichtigung und Angebotserstellung sind komplett kostenlos und unverbindlich. Sie zahlen erst, wenn Sie sich für eine Installation entscheiden.</p>
          </details>
          <details class="bg-gray-50 rounded-lg p-6 group">
            <summary class="font-bold text-lg text-[var(--primary-blue)] cursor-pointer list-none flex justify-between items-center">
              Wie erreiche ich den Kundenservice?
              <span class="text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-700 leading-relaxed">Telefonisch unter +49-341-98990391 (Mo-Fr 8-18 Uhr), per E-Mail an info@leipzig-photovoltaik.de oder über unser Kontaktformular. Wir antworten innerhalb von 24 Stunden.</p>
          </details>
          <details class="bg-gray-50 rounded-lg p-6 group">
            <summary class="font-bold text-lg text-[var(--primary-blue)] cursor-pointer list-none flex justify-between items-center">
              Bieten Sie auch Wartung und Reparatur an?
              <span class="text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-4 text-gray-700 leading-relaxed">Ja, wir bieten Wartungsverträge, Störungsbehebung, Reparaturen und Anlagenerweiterungen an – auch für Anlagen, die wir nicht installiert haben. Kontaktieren Sie uns für ein individuelles Service-Angebot.</p>
          </details>
        </div>
      </div>
    </section>

  </main>
  <Footer /> />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const buttonText = document.getElementById('button-text') as HTMLSpanElement;
  const buttonLoading = document.getElementById('button-loading') as HTMLSpanElement;
  const successMessage = document.getElementById('success-message') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Hide previous messages
    successMessage.classList.add('hidden');
    errorMessage.classList.add('hidden');
    
    // Show loading state
    submitButton.disabled = true;
    buttonText.classList.add('hidden');
    buttonLoading.classList.remove('hidden');
    
    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });
      
      if (response.ok) {
        // Show success message
        successMessage.classList.remove('hidden');
        form.reset();
        
        // Scroll to success message
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        // Show error message
        errorMessage.classList.remove('hidden');
        errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (error) {
      // Show error message
      errorMessage.classList.remove('hidden');
      errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      // Reset button state
      submitButton.disabled = false;
      buttonText.classList.remove('hidden');
      buttonLoading.classList.add('hidden');
    }
  });
</script>
