---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Service' }
];

const pageTitle = "PV Wartung & Reinigung Leipzig | Solarpark Betreuung";
const pageDescription = "PV Wartung Leipzig ✓ Reinigung & Reparatur ✓ Solarpark Betreuung ✓ 24h Notdienst ✓ Wartungsvertrag ab 99€/Jahr";
---

<Layout title={pageTitle} description={pageDescription}>
  <link rel="canonical" href="https://leipzig-photovoltaik.de/service/" slot="head" />
    <LocalBusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"@type": "ListItem", "position": 2, "name": "Service", "item": "https://leipzig-photovoltaik.de/service/"}]})}/>
<Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <main>
    <!-- Hero Section -->
    <section class="relative bg-[#0D1D37] text-white py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/service-hero.webp" alt="Professionelle Photovoltaik Wartung und Service" class="w-full h-full object-cover opacity-40" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--primary-blue)]/90 to-transparent"></div>
      </div>
      <div class="container-custom mx-auto text-center max-w-4xl relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
          PV Service & Wartung Leipzig – <span class="text-[var(--primary-turquoise)]">Reinigung & Reparatur</span>
        </h1>
        <p class="text-xl text-gray-200 leading-relaxed mb-8">
          Ihre Solaranlage soll 25 Jahre laufen. Damit sie das auch schafft – und dabei ordentlich Strom liefert – braucht sie ab und zu Pflege. Dafür sind wir da.
        </p>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Wartung -->
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all group">
            <div class="w-14 h-14 bg-[var(--primary-blue)]/10 text-[var(--primary-blue)] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--primary-blue)] group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[var(--primary-blue)] mb-4">Wartung & Check</h3>
            <p class="text-gray-600 mb-6">
              Wir schauen uns alles an: Module, Kabel, Wechselrichter. Und finden Probleme, bevor sie richtig teuer werden.
            </p>
            <ul class="space-y-2 text-sm text-gray-500 mb-8">
              <li>• Sichtprüfung der Module</li>
              <li>• Messung der Stränge</li>
              <li>• Prüfung der Wechselrichter</li>
            </ul>
            <a href="#kontakt" class="text-[var(--primary-turquoise)] font-bold hover:underline">Wartung anfragen →</a>
          </div>

          <!-- Reinigung -->
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all group">
            <div class="w-14 h-14 bg-[var(--primary-turquoise)]/10 text-[var(--primary-turquoise)] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--primary-turquoise)] group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[var(--primary-blue)] mb-4">PV-Reinigung</h3>
            <p class="text-gray-600 mb-6">
              Dreck auf den Modulen? Kostet Sie bares Geld – bis zu 20% weniger Ertrag. Wir reinigen mit Reinwasser, ohne Chemie.
            </p>
            <ul class="space-y-2 text-sm text-gray-500 mb-8">
              <li>• Schonendes Reinwasser-Verfahren</li>
              <li>• Ohne Chemie</li>
              <li>• Werterhalt der Module</li>
            </ul>
            <a href="#kontakt" class="text-[var(--primary-turquoise)] font-bold hover:underline">Reinigung buchen →</a>
          </div>

          <!-- Reparatur -->
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all group">
            <div class="w-14 h-14 bg-[var(--primary-yellow)]/10 text-[var(--primary-yellow)] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[var(--primary-yellow)] group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[var(--primary-blue)] mb-4">Reparatur</h3>
            <p class="text-gray-600 mb-6">
              Wechselrichter spinnt? Marder war da? Sturm hat zugeschlagen? Wir kommen und bringen das wieder in Ordnung.
            </p>
            <ul class="space-y-2 text-sm text-gray-500 mb-8">
              <li>• Schnelle Reaktionszeiten</li>
              <li>• Austauschkomponenten</li>
              <li>• Versicherungsgutachten</li>
            </ul>
            <a href="#kontakt" class="text-[var(--primary-turquoise)] font-bold hover:underline">Störung melden →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Clean Section -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1">
            <h2 class="text-3xl font-bold text-[var(--primary-blue)] mb-6">Warum Reinigung so wichtig ist</h2>
            <p class="text-gray-600 mb-6 leading-relaxed">
              "Der Regen macht das schon" – hören wir oft. Stimmt leider nur halb. Der hartnäckige Dreck sitzt an den Rändern und in den Ecken. Da kommt kein Regen hin.
            </p>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Das Problem: Dort entstehen "Hotspots" – Stellen, die sich aufheizen und die Module kaputt machen können. Regelmäßige Reinigung schützt also nicht nur den Ertrag, sondern auch Ihre Anlage.
            </p>
            <div class="bg-white p-6 rounded-lg border-l-4 border-[var(--primary-yellow)] shadow-sm">
              <p class="font-bold text-[var(--primary-blue)]">Unser Tipp:</p>
              <p class="text-sm text-gray-600 mt-1">Lassen Sie Ihre Anlage alle 2-3 Jahre professionell prüfen und bei Bedarf reinigen.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 h-80 bg-gray-200 rounded-xl overflow-hidden relative">
            <img src="/images/service-reinigung.webp" 
                 alt="Professionelle Photovoltaik-Reinigung durch Fachpersonal" 
                 class="w-full h-full object-cover"
                 loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section id="kontakt" class="py-20 bg-white">
      <div class="container-custom mx-auto max-w-2xl">
        <h2 class="text-3xl font-bold text-[var(--primary-blue)] mb-8 text-center">Service-Anfrage stellen</h2>
        
        <form class="space-y-6 bg-gray-50 p-8 rounded-xl border border-gray-100">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-bold text-gray-900 mb-2">Vorname *</label>
              <input type="text" name="vorname" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" />
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-900 mb-2">Nachname *</label>
              <input type="text" name="nachname" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" />
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-bold text-gray-900 mb-2">E-Mail Adresse *</label>
            <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" />
          </div>
          
          <div>
            <label class="block text-sm font-bold text-gray-900 mb-2">Telefon *</label>
            <input 
              type="tel" 
              name="telefon" 
              required
              pattern="^[\+]?[(]?[0-9]{1,4}[)]?[-\s\.]?[(]?[0-9]{1,4}[)]?[-\s\.]?[0-9]{1,9}$"
              placeholder="z.B. 0341 1234567 oder +49 341 1234567"
              title="Bitte geben Sie eine gültige Telefonnummer ein"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent" 
            />
          </div>
          
          <!-- PLZ und Ort (Pflicht) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-bold text-gray-900 mb-2">PLZ *</label>
              <input 
                type="text" 
                name="plz" 
                required
                pattern="[0-9]{5}"
                placeholder="04103"
                title="Bitte geben Sie eine gültige 5-stellige PLZ ein"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-900 mb-2">Ort *</label>
              <input 
                type="text" 
                name="ort" 
                required
                placeholder="Leipzig"
                minlength="2"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
              />
            </div>
          </div>
          
          <!-- Straße und Hausnummer (Optional) -->
          <div class="grid grid-cols-3 gap-6">
            <div class="col-span-2">
              <label class="block text-sm font-bold text-gray-900 mb-2">Straße (optional)</label>
              <input 
                type="text" 
                name="strasse" 
                placeholder="Musterstraße"
                maxlength="100"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-900 mb-2">Nr. (optional)</label>
              <input 
                type="text" 
                name="hausnummer" 
                placeholder="12a"
                pattern="[0-9]{1,5}[a-zA-Z]?"
                title="z.B. 12 oder 12a"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-900 mb-2">Worum geht es?</label>
            <select name="anliegen" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent">
              <option>Wartungstermin vereinbaren</option>
              <option>Reinigung anfragen</option>
              <option>Störung / Reparatur</option>
              <option>Sonstiges</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-900 mb-2">Nachricht</label>
            <textarea name="nachricht" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--primary-turquoise)] focus:border-transparent"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full">Anfrage absenden</button>
        </form>
      </div>
    </section>

  <!-- Verwandte Seiten -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-8 text-center">Weitere Informationen</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/privat/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Photovoltaik für Privat</h3>
            <p class="text-gray-600 text-sm">Solaranlagen für Einfamilienhäuser ab 7.500€</p>
          </a>
          <a href="/stromspeicher/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Stromspeicher</h3>
            <p class="text-gray-600 text-sm">Solarstrom rund um die Uhr nutzen</p>
          </a>
          <a href="/solarmanager/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Solarmanager</h3>
            <p class="text-gray-600 text-sm">Intelligentes Energiemanagement</p>
          </a>
          <a href="/blog/solaranlage-wartung/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Solaranlage Wartung</h3>
            <p class="text-gray-600 text-sm">Tipps für die richtige Wartung Ihrer PV-Anlage</p>
          </a>
          <a href="/blog/wartungstipps-winter/" class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-[var(--primary-blue)] mb-2">Wartungstipps Winter</h3>
            <p class="text-gray-600 text-sm">So bleibt Ihre Solaranlage im Winter leistungsstark</p>
          </a>
        </div>
      </div>
    </section>

    <!-- SEO Textblock -->
    <section class="py-16 bg-white">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-6">Professioneller PV-Service in Leipzig und Umgebung</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Eine Photovoltaikanlage ist eine langfristige Investition, die regelmäßige Wartung und Pflege benötigt, um über Jahrzehnte zuverlässig Strom zu produzieren. Unser PV-Service-Team in Leipzig bietet Ihnen professionelle Wartung, Reinigung und Reparatur für alle gängigen Solaranlagen – unabhängig davon, wer Ihre Anlage installiert hat.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Durch regelmäßige Inspektionen und Reinigungen erhöhen Sie den Ertrag Ihrer PV-Anlage um bis zu 15%. Verschmutzungen durch Staub, Pollen, Vogelkot oder Laub können die Leistung erheblich mindern. Unsere geschulten Techniker reinigen Ihre Module schonend und prüfen gleichzeitig alle Komponenten auf einwandfreie Funktion.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Im Schadensfall sind wir schnell vor Ort: Ob defekte Wechselrichter, beschädigte Module oder Probleme mit dem Monitoring – wir diagnostizieren und beheben Störungen zeitnah, damit Ihre Anlage schnell wieder volle Leistung bringt. Mit unserem Wartungsvertrag profitieren Sie von regelmäßigen Inspektionen, bevorzugter Terminvergabe und attraktiven Konditionen für Ersatzteile und Reparaturen.
          </p>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
