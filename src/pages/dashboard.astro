---
// Unified Dashboard v2.0 - Leads + Analytics + SEO + Admin
// Professionelle Plattform für leipzig-photovoltaik.de
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Dashboard | Leipzig Photovoltaik</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ========== BASE STYLES ========== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; min-height: 100vh; }
    
    /* ========== UTILITY CLASSES ========== */
    .hidden { display: none !important; }
    .flex { display: flex; }
    .grid { display: grid; }
    .items-center { align-items: center; }
    .justify-center { justify-content: center; }
    .justify-between { justify-content: space-between; }
    .justify-around { justify-content: space-around; }
    .flex-col { flex-direction: column; }
    .flex-1 { flex: 1; }
    .gap-2 { gap: 0.5rem; }
    .gap-3 { gap: 0.75rem; }
    .gap-4 { gap: 1rem; }
    .gap-6 { gap: 1.5rem; }
    .text-center { text-align: center; }
    .text-left { text-align: left; }
    .text-right { text-align: right; }
    .font-medium { font-weight: 500; }
    .font-semibold { font-weight: 600; }
    .font-bold { font-weight: 700; }
    .text-xs { font-size: 0.75rem; line-height: 1rem; }
    .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
    .text-lg { font-size: 1.125rem; line-height: 1.75rem; }
    .text-xl { font-size: 1.25rem; line-height: 1.75rem; }
    .text-2xl { font-size: 1.5rem; line-height: 2rem; }
    .text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
    .text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
    .uppercase { text-transform: uppercase; }
    .tracking-wide { letter-spacing: 0.025em; }
    .w-full { width: 100%; }
    .w-8 { width: 2rem; }
    .w-10 { width: 2.5rem; }
    .w-20 { width: 5rem; }
    .w-60 { width: 15rem; }
    .h-full { height: 100%; }
    .h-8 { height: 2rem; }
    .h-10 { height: 2.5rem; }
    .h-20 { height: 5rem; }
    .min-h-screen { min-height: 100vh; }
    .max-w-md { max-width: 28rem; }
    .max-w-4xl { max-width: 56rem; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    .ml-auto { margin-left: auto; }
    .mt-1 { margin-top: 0.25rem; }
    .mt-2 { margin-top: 0.5rem; }
    .mt-4 { margin-top: 1rem; }
    .mt-6 { margin-top: 1.5rem; }
    .mb-2 { margin-bottom: 0.5rem; }
    .mb-4 { margin-bottom: 0.75rem; }
    .mb-6 { margin-bottom: 1.5rem; }
    .mb-8 { margin-bottom: 2rem; }
    .my-3 { margin-top: 0.75rem; margin-bottom: 0.75rem; }
    .p-2 { padding: 0.5rem; }
    .p-3 { padding: 0.75rem; }
    .p-4 { padding: 1rem; }
    .p-6 { padding: 1.5rem; }
    .p-8 { padding: 2rem; }
    .px-2 { padding-left: 0.5rem; padding-right: 0.5rem; }
    .px-3 { padding-left: 0.75rem; padding-right: 0.75rem; }
    .px-4 { padding-left: 1rem; padding-right: 1rem; }
    .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .py-3 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
    .py-4 { padding-top: 1rem; padding-bottom: 1rem; }
    .rounded { border-radius: 0.25rem; }
    .rounded-lg { border-radius: 0.5rem; }
    .rounded-xl { border-radius: 0.75rem; }
    .rounded-2xl { border-radius: 1rem; }
    .rounded-full { border-radius: 9999px; }
    .border { border-width: 1px; border-style: solid; }
    .border-t { border-top-width: 1px; border-top-style: solid; }
    .border-b { border-bottom-width: 1px; border-bottom-style: solid; }
    .border-r { border-right-width: 1px; border-right-style: solid; }
    .shadow-sm { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
    .shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
    .shadow-2xl { box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
    .overflow-hidden { overflow: hidden; }
    .overflow-x-auto { overflow-x: auto; }
    .overflow-y-auto { overflow-y: auto; }
    .transition { transition: all 0.15s ease-in-out; }
    .cursor-pointer { cursor: pointer; }
    .space-y-1 > * + * { margin-top: 0.25rem; }
    .space-y-2 > * + * { margin-top: 0.5rem; }
    .space-y-3 > * + * { margin-top: 0.75rem; }
    .space-y-4 > * + * { margin-top: 1rem; }
    .space-x-2 > * + * { margin-left: 0.5rem; }
    .space-x-3 > * + * { margin-left: 0.75rem; }
    .whitespace-nowrap { white-space: nowrap; }
    .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sticky { position: sticky; }
    .fixed { position: fixed; }
    .absolute { position: absolute; }
    .relative { position: relative; }
    .top-0 { top: 0; }
    .left-0 { left: 0; }
    .right-0 { right: 0; }
    .bottom-0 { bottom: 0; }
    .inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
    .z-30 { z-index: 30; }
    .z-40 { z-index: 40; }
    .z-50 { z-index: 50; }
    
    /* ========== COLORS ========== */
    .bg-white { background-color: #ffffff; }
    .bg-gray-50 { background-color: #f9fafb; }
    .bg-gray-100 { background-color: #f3f4f6; }
    .bg-gray-200 { background-color: #e5e7eb; }
    .bg-gray-800 { background-color: #1f2937; }
    .bg-cyan-100 { background-color: #cffafe; }
    .bg-cyan-500 { background-color: #06b6d4; }
    .bg-blue-600 { background-color: #2563eb; }
    .bg-green-100 { background-color: #dcfce7; }
    .bg-yellow-100 { background-color: #fef9c3; }
    .bg-red-100 { background-color: #fee2e2; }
    .bg-gradient-to-br { background: linear-gradient(to bottom right, var(--tw-gradient-stops)); }
    .bg-gradient-to-r { background: linear-gradient(to right, var(--tw-gradient-stops)); }
    .from-slate-900 { --tw-gradient-from: #0f172a; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(15, 23, 42, 0)); }
    .via-slate-800 { --tw-gradient-stops: var(--tw-gradient-from), #1e293b, var(--tw-gradient-to, rgba(30, 41, 59, 0)); }
    .to-slate-900 { --tw-gradient-to: #0f172a; }
    .from-cyan-500 { --tw-gradient-from: #06b6d4; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(6, 182, 212, 0)); }
    .to-blue-600 { --tw-gradient-to: #2563eb; }
    .text-white { color: #ffffff; }
    .text-gray-400 { color: #9ca3af; }
    .text-gray-500 { color: #6b7280; }
    .text-gray-600 { color: #4b5563; }
    .text-gray-700 { color: #374151; }
    .text-gray-900 { color: #111827; }
    .text-cyan-600 { color: #0891b2; }
    .text-cyan-700 { color: #0e7490; }
    .text-green-600 { color: #16a34a; }
    .text-red-500 { color: #ef4444; }
    .border-gray-100 { border-color: #f3f4f6; }
    .border-gray-200 { border-color: #e5e7eb; }
    .border-gray-300 { border-color: #d1d5db; }
    
    /* ========== HOVER STATES ========== */
    .hover\:bg-gray-200:hover { background-color: #e5e7eb; }
    .hover\:bg-gray-100:hover { background-color: #f3f4f6; }
    .hover\:bg-cyan-600:hover { background-color: #0891b2; }
    .hover\:text-red-500:hover { color: #ef4444; }
    .hover\:opacity-90:hover { opacity: 0.9; }
    
    /* ========== FOCUS STATES ========== */
    .focus\:ring-2:focus { box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.5); }
    .focus\:ring-cyan-500:focus { --tw-ring-color: #06b6d4; }
    .focus\:border-cyan-500:focus { border-color: #06b6d4; }
    .focus\:outline-none:focus { outline: none; }
    
    /* ========== GRID LAYOUTS ========== */
    .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
    .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    
    /* ========== FORM ELEMENTS ========== */
    input, select, textarea {
      font-family: inherit;
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
    input[type="text"], input[type="password"], input[type="email"], input[type="number"], select, textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid #d1d5db;
      border-radius: 0.75rem;
      background-color: #ffffff;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #06b6d4;
      box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
    }
    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }
    
    /* ========== CUSTOM COMPONENT STYLES ========== */
    .trend-up { color: #10b981; }
    .trend-down { color: #ef4444; }
    .trend-stable { color: #6b7280; }
    .sidebar-item.active { background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; }
    .sidebar-item:not(.active):hover { background: #f1f5f9; }
    .status-new { background: #dbeafe; color: #1e40af; }
    .status-contacted { background: #fef3c7; color: #92400e; }
    .status-qualified { background: #e0e7ff; color: #3730a3; }
    .status-proposal { background: #f3e8ff; color: #6b21a8; }
    .status-won { background: #d1fae5; color: #065f46; }
    .status-lost { background: #fee2e2; color: #991b1b; }
    .priority-high { background: #fee2e2; color: #991b1b; }
    .priority-medium { background: #fef3c7; color: #92400e; }
    .priority-low { background: #d1fae5; color: #065f46; }
    
    /* ========== STATUS SELECT DROPDOWN ========== */
    .status-select {
      width: auto;
      min-width: 130px;
      padding: 0.375rem 0.5rem;
      font-size: 0.75rem;
      line-height: 1rem;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .status-select:hover {
      filter: brightness(0.95);
    }
    .status-select:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.3);
    }
    .bg-blue-50 { background-color: #eff6ff; }
    .bg-yellow-50 { background-color: #fefce8; }
    .bg-purple-50 { background-color: #faf5ff; }
    .bg-orange-50 { background-color: #fff7ed; }
    .bg-green-50 { background-color: #f0fdf4; }
    .bg-red-50 { background-color: #fef2f2; }
    .border-blue-200 { border-color: #bfdbfe; }
    .border-yellow-200 { border-color: #fef08a; }
    .border-purple-200 { border-color: #e9d5ff; }
    .border-orange-200 { border-color: #fed7aa; }
    .border-green-200 { border-color: #bbf7d0; }
    .border-red-200 { border-color: #fecaca; }
    .text-blue-700 { color: #1d4ed8; }
    .text-yellow-700 { color: #a16207; }
    .text-purple-700 { color: #7e22ce; }
    .text-orange-700 { color: #c2410c; }
    .text-green-700 { color: #15803d; }
    .text-red-700 { color: #b91c1c; }
    
    /* ========== ANIMATIONS ========== */
    @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
    .slide-in { animation: slideIn 0.3s ease-out; }
    .toast { animation: slideIn 0.3s ease-out; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .animate-spin { animation: spin 1s linear infinite; }
    
    /* ========== LOGIN SCREEN ========== */
    #loginScreen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: linear-gradient(to bottom right, #0f172a, #1e293b, #0f172a);
    }
    .login-card {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      padding: 2rem;
      width: 100%;
      max-width: 28rem;
    }
    .login-logo {
      width: 5rem;
      height: 5rem;
      background: linear-gradient(to bottom right, #06b6d4, #2563eb);
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .login-btn {
      width: 100%;
      background: linear-gradient(to right, #06b6d4, #2563eb);
      color: white;
      padding: 0.75rem;
      border-radius: 0.75rem;
      font-weight: 600;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      transition: opacity 0.15s;
    }
    .login-btn:hover { opacity: 0.9; }
    
    /* ========== SIDEBAR ========== */
    .desktop-sidebar {
      position: fixed;
      left: 0;
      top: 0;
      height: 100%;
      width: 15rem;
      background: white;
      border-right: 1px solid #e5e7eb;
      display: flex;
      flex-direction: column;
      z-index: 40;
    }
    
    /* ========== MOBILE NAV ========== */
    .mobile-bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      border-top: 1px solid #e5e7eb;
      z-index: 40;
      display: flex;
      justify-content: space-around;
      padding: 0.5rem 0;
    }
    
    /* ========== MAIN CONTENT ========== */
    .main-content {
      min-height: 100vh;
    }
    
    /* ========== STAT CARDS ========== */
    .stat-card {
      background: white;
      border-radius: 0.75rem;
      padding: 1rem;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      border: 1px solid #f3f4f6;
    }
    .stat-icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    /* ========== TABLES ========== */
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 0.75rem 1rem; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; color: #6b7280; background: #f9fafb; }
    td { padding: 0.75rem 1rem; border-top: 1px solid #f3f4f6; }
    tbody tr:hover { background: #f9fafb; }
    
    /* ========== MODALS ========== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 50;
      padding: 1rem;
    }
    .modal-content {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      width: 100%;
      max-width: 32rem;
      max-height: 90vh;
      overflow-y: auto;
    }
    
    /* ========== RESPONSIVE ========== */
    @media (max-width: 768px) {
      .desktop-sidebar { display: none !important; }
      .mobile-bottom-nav { display: flex !important; }
      .main-content { margin-left: 0 !important; padding-bottom: 80px; }
      .grid-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .lg\:grid-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sm\:px-6 { padding-left: 1rem; padding-right: 1rem; }
      .lg\:px-8 { padding-left: 1rem; padding-right: 1rem; }
      .sm\:p-6 { padding: 1rem; }
      .lg\:p-8 { padding: 1rem; }
    }
    @media (min-width: 769px) {
      .desktop-sidebar { display: flex !important; }
      .mobile-bottom-nav { display: none !important; }
      .main-content { margin-left: 240px; }
    }
    @media (min-width: 1024px) {
      .lg\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .lg\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .lg\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">
  
  <!-- Login Screen -->
  <div id="loginScreen">
    <div class="login-card">
      <div class="text-center mb-8">
        <div class="login-logo">
          <span style="font-size: 2.25rem;">⚡</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
        <p class="text-gray-500 mt-2">Leipzig Photovoltaik</p>
      </div>
      <form id="loginForm" class="space-y-4">
        <div>
          <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #374151; margin-bottom: 0.5rem;">Passwort</label>
          <input type="password" id="password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="login-btn">
          Anmelden
        </button>
        <p id="loginError" class="text-red-500 text-sm text-center hidden">Falsches Passwort</p>
      </form>
    </div>
  </div>

  <!-- Dashboard Container -->
  <div id="dashboard" class="hidden min-h-screen">
    
    <!-- Desktop Sidebar -->
    <aside class="desktop-sidebar fixed left-0 top-0 h-full w-60 bg-white border-r border-gray-200 flex-col z-40">
      <!-- Logo -->
      <div class="p-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center">
            <span class="text-xl">⚡</span>
          </div>
          <div>
            <h1 class="font-bold text-gray-900">Dashboard</h1>
            <p class="text-xs text-gray-500">v2.0</p>
          </div>
        </div>
      </div>
      
      <!-- Navigation -->
      <nav class="flex-1 p-3 space-y-1">
        <button onclick="showSection('overview')" id="navOverview" class="sidebar-item active w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left transition">
          <span class="text-lg">🏠</span>
          <span class="font-medium">Übersicht</span>
        </button>
        <button onclick="showSection('leads')" id="navLeads" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">👥</span>
          <span class="font-medium">Leads</span>
          <span id="leadsCount" class="ml-auto bg-cyan-100 text-cyan-700 text-xs font-bold px-2 py-0.5 rounded-full">0</span>
        </button>
        <button onclick="showSection('seo')" id="navSeo" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">🔍</span>
          <span class="font-medium">SEO</span>
        </button>
        <button onclick="showSection('analytics')" id="navAnalytics" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">📈</span>
          <span class="font-medium">Analytics</span>
        </button>
        <button onclick="showSection('optimize')" id="navOptimize" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">🤖</span>
          <span class="font-medium">KI-Optimierung</span>
        </button>
        
        <div class="border-t border-gray-200 my-3 pt-3">
          <button onclick="showSection('settings')" id="navSettings" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
            <span class="text-lg">⚙️</span>
            <span class="font-medium">Einstellungen</span>
          </button>
        </div>
      </nav>
      
      <!-- User Info -->
      <div class="p-4 border-t border-gray-200">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
              <span class="text-sm">👤</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Admin</span>
          </div>
          <button onclick="logout()" class="text-gray-400 hover:text-red-500 transition" title="Abmelden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-40 justify-around py-2">
      <button onclick="showSection('overview')" id="mobileNavOverview" class="flex flex-col items-center p-2 text-cyan-600">
        <span class="text-xl">🏠</span>
        <span class="text-xs mt-1">Übersicht</span>
      </button>
      <button onclick="showSection('leads')" id="mobileNavLeads" class="flex flex-col items-center p-2 text-gray-500">
        <span class="text-xl">👥</span>
        <span class="text-xs mt-1">Leads</span>
      </button>
