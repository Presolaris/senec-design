            <p class="text-xs text-gray-500 sm:hidden">${l.email || '-'}</p>
          </td>
          <td class="px-4 py-3 hidden sm:table-cell">
            <p class="text-sm text-gray-600">${l.email || '-'}</p>
            <p class="text-xs text-gray-400">${l.phone || '-'}</p>
