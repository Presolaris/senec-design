  // Quick Status Change - direkt in der Tabelle
  async function quickStatusChange(id, newStatus) {
    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/leads?id=eq.${id}`, {
        method: 'PATCH',
        headers: { 
          'apikey': SUPABASE_ANON_KEY, 
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`, 
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify({ status: newStatus, updated_at: new Date().toISOString() })
      });
      
      if (!response.ok) throw new Error('Update fehlgeschlagen');
      
      // Lokalen State aktualisieren
      const lead = allLeads.find(l => l.id === id);
      const oldStatus = lead ? lead.status : 'unknown';
      if (lead) {
        lead.status = newStatus;
        lead.updated_at = new Date().toISOString();
      }
      
      // LocalStorage aktualisieren
      saveToLocalStorage();
      
      // Aktivität protokollieren
      const statusNames = { 'new': 'Neu', 'contacted': 'Kontaktiert', 'qualified': 'Qualifiziert', 'proposal_sent': 'Angebot gesendet', 'won': 'Gewonnen', 'lost': 'Verloren' };
      logLeadActivity(id, 'status_change', `${statusNames[oldStatus] || oldStatus} → ${statusNames[newStatus]}`);
      
      // Views aktualisieren (Stats, aber nicht die Tabelle neu rendern)
      updateLeadsStats();
      
      // Erfolgs-Toast mit Status-Namen
      showToast(`Status auf "${statusNames[newStatus]}" geändert`, 'success');
      
    } catch (error) {
      console.error('Status-Update Fehler:', error);
      showToast('Fehler beim Speichern des Status', 'error');
      // Bei Fehler: Tabelle neu rendern um alten Status wiederherzustellen
      renderLeadsTable();
    }
  }

  function updateLeadsStats() {
    document.getElementById('leadsStatTotal').textContent = allLeads.length;
    document.getElementById('leadsStatNew').textContent = allLeads.filter(l => l.status === 'new').length;
    document.getElementById('leadsStatInProgress').textContent = allLeads.filter(l => ['contacted', 'qualified', 'proposal_sent'].includes(l.status)).length;
    document.getElementById('leadsStatWon').textContent = allLeads.filter(l => l.status === 'won').length;
  }

  function getStatusSelectClass(status) {
    const classes = {
      'new': 'bg-blue-50 border-blue-200 text-blue-700',
      'contacted': 'bg-yellow-50 border-yellow-200 text-yellow-700',
      'qualified': 'bg-purple-50 border-purple-200 text-purple-700',
      'proposal_sent': 'bg-orange-50 border-orange-200 text-orange-700',
      'won': 'bg-green-50 border-green-200 text-green-700',
      'lost': 'bg-red-50 border-red-200 text-red-700'
    };
    return classes[status] || 'bg-gray-50 border-gray-200 text-gray-700';
  }

  function getStatusClass(status) {
    const classes = { 'new': 'status-new', 'contacted': 'status-contacted', 'qualified': 'status-qualified', 'proposal_sent': 'status-proposal', 'won': 'status-won', 'lost': 'status-lost' };
    return classes[status] || 'bg-gray-100 text-gray-700';
  }

  function formatStatus(status) {
    const map = { 'new': 'Neu', 'contacted': 'Kontaktiert', 'qualified': 'Qualifiziert', 'proposal_sent': 'Angebot', 'won': 'Gewonnen', 'lost': 'Verloren' };
    return map[status] || status;
  }

  function exportCSV() {
    const headers = ['Name', 'Email', 'Telefon', 'Quelle', 'Projekttyp', 'Status', 'Datum'];
    const rows = filteredLeads.map(l => [l.name, l.email, l.phone, l.source, l.project_type, l.status, l.created_at]);
    const csv = [headers.join(','), ...rows.map(r => r.map(v => `"${v || ''}"`).join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `leads_${new Date().toISOString().split('T')[0]}.csv`; a.click();
    showToast('CSV exportiert', 'success');
  }

  // ==================== LEAD DETAIL ====================
  function openLeadDetail(id) {
