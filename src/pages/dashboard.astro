    document.getElementById('leadDetailModal').classList.add('hidden');
    currentLeadId = null;
  }

  // Notizen speichern
  async function saveLeadNotes() {
    if (!currentLeadId) return;
    
    const notes = document.getElementById('leadDetailNotes').value;
    const saveIcon = document.getElementById('notesSaveIcon');
    const saveStatus = document.getElementById('notesSaveStatus');
    
    // UI-Feedback: Speichern läuft
    saveIcon.textContent = '⏳';
    saveStatus.textContent = 'Speichern...';
    
    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/leads?id=eq.${currentLeadId}`, {
        method: 'PATCH',
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify({ 
          notes: notes,
          updated_at: new Date().toISOString() 
        })
      });
      
      if (!response.ok) throw new Error('Speichern fehlgeschlagen');
      
      // Lokalen State aktualisieren
      const lead = allLeads.find(l => l.id === currentLeadId);
      const hadNotes = lead && lead.notes && lead.notes.trim().length > 0;
      if (lead) {
        lead.notes = notes;
        lead.updated_at = new Date().toISOString();
      }
      
      // LocalStorage aktualisieren
      saveToLocalStorage();
      
      // Aktivität protokollieren
      const notePreview = notes.length > 50 ? notes.substring(0, 50) + '...' : notes;
      logLeadActivity(currentLeadId, hadNotes ? 'note_updated' : 'note_added', notePreview || 'Notiz gelöscht');
      
      // Timeline aktualisieren falls sichtbar
      renderActivityTimeline(currentLeadId);
      
      // UI-Feedback: Erfolg
      saveIcon.textContent = '✅';
      saveStatus.textContent = `Gespeichert um ${new Date().toLocaleTimeString('de-DE')}`;
      showToast('Notizen gespeichert', 'success');
      
      // Icon nach 2 Sekunden zurücksetzen
      setTimeout(() => {
        saveIcon.textContent = '💾';
      }, 2000);
      
    } catch (error) {
      console.error('Notizen-Speicher-Fehler:', error);
      saveIcon.textContent = '❌';
      saveStatus.textContent = 'Fehler beim Speichern';
      showToast('Fehler beim Speichern der Notizen', 'error');
      
      // Icon nach 2 Sekunden zurücksetzen
      setTimeout(() => {
        saveIcon.textContent = '💾';
        saveStatus.textContent = '';
      }, 2000);
    }
  }

