  // ==================== UPDATE VIEWS ====================
  function updateAllViews() {
    filteredLeads = [...allLeads];
    filteredKeywords = [...allKeywords];
    
    document.getElementById('leadsCount').textContent = allLeads.filter(l => l.status === 'new').length;
    
    updateOverview();
    updateLeadsView();
    updateSeoView();
    updateAnalyticsView();
    populateOptimizeSelect();
  }

  // ==================== OVERVIEW ====================
  function updateOverview() {
    document.getElementById('statLeadsTotal').textContent = allLeads.length;
    document.getElementById('statLeadsNew').textContent = allLeads.filter(l => l.status === 'new').length;
    document.getElementById('statTop10').textContent = allKeywords.filter(k => k.current_rank && k.current_rank <= 10).length;
    document.getElementById('statKeywordsTotal').textContent = allKeywords.length;
    
    const totalImpressions = allKeywords.reduce((sum, k) => sum + (k.impressions || 0), 0);
    document.getElementById('statImpressions').textContent = totalImpressions.toLocaleString();
    
    const popupShown = allEvents.filter(e => e.event_type === 'popup_shown').length;
    const popupSubmitted = allLeads.filter(l => l.source === 'exit_popup').length;
    const convRate = popupShown > 0 ? ((popupSubmitted / popupShown) * 100).toFixed(1) : '0.0';
    document.getElementById('statConversion').textContent = `${convRate}%`;

    generateAlerts();
    renderRecentLeads();
    renderTopKeywords();
    renderOverviewCharts();
  }

  function generateAlerts() {
    const alerts = [];
    const newLeads = allLeads.filter(l => l.status === 'new').length;
    if (newLeads > 0) alerts.push({ text: `${newLeads} neue Lead(s) warten auf Bearbeitung`, action: "showSection('leads')" });
    
    const highPotential = allKeywords.filter(k => k.current_rank && k.current_rank > 10 && k.current_rank <= 30 && (k.impressions || 0) > 300);
    highPotential.slice(0, 2).forEach(k => {
      alerts.push({ text: `"${k.keyword}" (Pos. ${k.current_rank}) hat hohes Potenzial`, action: "showSection('optimize')" });
    });

    document.getElementById('alertsCount').textContent = alerts.length;
    document.getElementById('alertsList').innerHTML = alerts.length > 0
      ? alerts.map(a => `<div class="flex justify-between items-center p-2 bg-white rounded-lg cursor-pointer hover:bg-amber-50 transition" onclick="${a.action}"><span class="text-sm text-amber-800">${a.text}</span><span class="text-amber-600">→</span></div>`).join('')
      : '<p class="text-sm text-amber-700">✅ Keine dringenden Handlungen</p>';
  }

  function renderRecentLeads() {
    const recent = allLeads.slice(0, 5);
    document.getElementById('recentLeadsList').innerHTML = recent.length > 0
      ? recent.map(l => `<div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100 transition" onclick="openLeadDetail('${l.id}')"><div><p class="font-medium text-sm text-gray-900">${l.name || 'Unbekannt'}</p><p class="text-xs text-gray-500">${l.email || '-'}</p></div><span class="px-2 py-1 text-xs rounded-full ${getStatusClass(l.status)}">${formatStatus(l.status)}</span></div>`).join('')
      : '<p class="text-sm text-gray-500 text-center py-4">Keine Leads</p>';
  }

  function renderTopKeywords() {
    const top = [...allKeywords].filter(k => k.current_rank).sort((a, b) => a.current_rank - b.current_rank).slice(0, 5);
    document.getElementById('topKeywordsList').innerHTML = top.length > 0
      ? top.map(k => `<div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg"><div><p class="font-medium text-sm text-gray-900">${k.keyword}</p><p class="text-xs text-gray-500">${k.target_url}</p></div><span class="font-bold ${k.current_rank <= 10 ? 'text-green-600' : 'text-gray-600'}">#${k.current_rank}</span></div>`).join('')
      : '<p class="text-sm text-gray-500 text-center py-4">Keine Rankings</p>';
  }

  function renderOverviewCharts() {
    if (charts.overviewLeads) charts.overviewLeads.destroy();
    if (charts.overviewRanking) charts.overviewRanking.destroy();

    const last30 = getLast30DaysData(allLeads);
    charts.overviewLeads = new Chart(document.getElementById('overviewLeadsChart'), {
      type: 'line',
      data: { labels: Object.keys(last30), datasets: [{ label: 'Leads', data: Object.values(last30), borderColor: '#0ea5e9', backgroundColor: 'rgba(14, 165, 233, 0.1)', tension: 0.4, fill: true }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    const rankDist = { 'Top 3': 0, 'Top 10': 0, 'Top 20': 0, '20+': 0, 'Neu': 0 };
    allKeywords.forEach(k => {
      if (!k.current_rank) rankDist['Neu']++;
      else if (k.current_rank <= 3) rankDist['Top 3']++;
      else if (k.current_rank <= 10) rankDist['Top 10']++;
      else if (k.current_rank <= 20) rankDist['Top 20']++;
      else rankDist['20+']++;
    });
    charts.overviewRanking = new Chart(document.getElementById('overviewRankingChart'), {
      type: 'doughnut',
      data: { labels: Object.keys(rankDist), datasets: [{ data: Object.values(rankDist), backgroundColor: ['#10b981', '#22c55e', '#84cc16', '#f97316', '#6b7280'] }] },
      options: { responsive: true, maintainAspectRatio: false }
    });
  }

  function getLast30DaysData(leads) {
    const data = {};
    for (let i = 29; i >= 0; i--) {
      const d = new Date(); d.setDate(d.getDate() - i);
      data[d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' })] = 0;
    }
    leads.forEach(l => {
      const key = new Date(l.created_at).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' });
      if (data.hasOwnProperty(key)) data[key]++;
    });
    return data;
  }

  // ==================== LEADS ====================
  function updateLeadsView() {
    document.getElementById('leadsStatTotal').textContent = allLeads.length;
    document.getElementById('leadsStatNew').textContent = allLeads.filter(l => l.status === 'new').length;
    document.getElementById('leadsStatInProgress').textContent = allLeads.filter(l => ['contacted', 'qualified', 'proposal_sent'].includes(l.status)).length;
    document.getElementById('leadsStatWon').textContent = allLeads.filter(l => l.status === 'won').length;
    renderLeadsTable();
  }

  function filterLeads() {
    const status = document.getElementById('filterStatus').value;
    const source = document.getElementById('filterSource').value;
    const project = document.getElementById('filterProject').value;
    const search = document.getElementById('filterSearch').value.toLowerCase();

    filteredLeads = allLeads.filter(l => {
      if (status && l.status !== status) return false;
      if (source && l.source !== source) return false;
      if (project && l.project_type !== project) return false;
      if (search && !`${l.name} ${l.email}`.toLowerCase().includes(search)) return false;
      return true;
    });
    renderLeadsTable();
  }

  function renderLeadsTable() {
    document.getElementById('leadsTableBody').innerHTML = filteredLeads.length > 0
      ? filteredLeads.map(l => `
        <tr class="hover:bg-gray-50 cursor-pointer" onclick="openLeadDetail('${l.id}')">
          <td class="px-4 py-3"><p class="font-medium text-gray-900">${l.name || 'Unbekannt'}</p><p class="text-xs text-gray-500 sm:hidden">${l.email || '-'}</p></td>
          <td class="px-4 py-3 hidden sm:table-cell"><p class="text-sm text-gray-600">${l.email || '-'}</p><p class="text-xs text-gray-400">${l.phone || '-'}</p></td>
          <td class="px-4 py-3 hidden md:table-cell"><span class="px-2 py-1 text-xs rounded-full ${l.source === 'exit_popup' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}">${l.source === 'exit_popup' ? 'Popup' : 'Form'}</span></td>
          <td class="px-4 py-3"><span class="px-2 py-1 text-xs rounded-full ${getStatusClass(l.status)}">${formatStatus(l.status)}</span></td>
          <td class="px-4 py-3 text-sm text-gray-500 hidden lg:table-cell">${new Date(l.created_at).toLocaleDateString('de-DE')}</td>
          <td class="px-4 py-3 text-center"><button onclick="event.stopPropagation(); openLeadDetail('${l.id}')" class="text-cyan-600 hover:text-cyan-800">👁️</button></td>
        </tr>
      `).join('')
      : '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">Keine Leads gefunden</td></tr>';
  }

  function getStatusClass(status) {
    const classes = { 'new': 'status-new', 'contacted': 'status-contacted', 'qualified': 'status-qualified', 'proposal_sent': 'status-proposal', 'won': 'status-won', 'lost': 'status-lost' };
    return classes[status] || 'bg-gray-100 text-gray-700';
  }

  function formatStatus(status) {
    const map = { 'new': 'Neu', 'contacted': 'Kontaktiert', 'qualified': 'Qualifiziert', 'proposal_sent': 'Angebot', 'won': 'Gewonnen', 'lost': 'Verloren' };
    return map[status] || status;
  }

  function exportCSV() {
    const headers = ['Name', 'Email', 'Telefon', 'Quelle', 'Projekttyp', 'Status', 'Datum'];
    const rows = filteredLeads.map(l => [l.name, l.email, l.phone, l.source, l.project_type, l.status, l.created_at]);
    const csv = [headers.join(','), ...rows.map(r => r.map(v => `"${v || ''}"`).join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `leads_${new Date().toISOString().split('T')[0]}.csv`; a.click();
    showToast('CSV exportiert', 'success');
  }

  // ==================== LEAD DETAIL ====================
  function openLeadDetail(id) {
    const lead = allLeads.find(l => l.id === id);
    if (!lead) return;
    currentLeadId = id;

    document.getElementById('leadDetailName').textContent = lead.name || 'Unbekannt';
    document.getElementById('leadDetailDate').textContent = `Erstellt: ${new Date(lead.created_at).toLocaleString('de-DE')}`;
    document.getElementById('leadDetailEmail').textContent = lead.email || '-';
    document.getElementById('leadDetailPhone').textContent = lead.phone || '-';
    document.getElementById('leadDetailSource').textContent = lead.source === 'exit_popup' ? 'Exit-Popup' : 'Multi-Step-Formular';
    document.getElementById('leadDetailProject').textContent = lead.project_type || '-';
    document.getElementById('leadDetailSize').textContent = lead.system_size || '-';
    document.getElementById('leadDetailStatus').innerHTML = `<span class="px-3 py-1 text-sm rounded-full ${getStatusClass(lead.status)}">${formatStatus(lead.status)}</span>`;
    document.getElementById('leadDetailMessage').textContent = lead.message || 'Keine Nachricht';
    document.getElementById('leadDetailNotes').value = lead.notes || '';
    
    document.getElementById('leadDetailEmailBtn').href = `mailto:${lead.email}`;
    document.getElementById('leadDetailPhoneBtn').href = `tel:${lead.phone}`;
    
    document.getElementById('leadDetailModal').classList.remove('hidden');
  }

  function closeLeadDetail() {
    document.getElementById('leadDetailModal').classList.add('hidden');
    currentLeadId = null;
  }

  function openStatusChange() {
    if (!currentLeadId) return;
    document.getElementById('statusLeadId').value = currentLeadId;
    const lead = allLeads.find(l => l.id === currentLeadId);
    if (lead) document.getElementById('newStatus').value = lead.status;
    document.getElementById('statusModal').classList.remove('hidden');
  }

  function closeStatusModal() {
    document.getElementById('statusModal').classList.add('hidden');
  }

  document.getElementById('statusForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const id = document.getElementById('statusLeadId').value;
    const status = document.getElementById('newStatus').value;
    
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/leads?id=eq.${id}`, {
        method: 'PATCH',
        headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ status, updated_at: new Date().toISOString() })
      });
      
      const lead = allLeads.find(l => l.id === id);
      if (lead) lead.status = status;
      saveToLocalStorage();
      updateAllViews();
      showToast('Status aktualisiert', 'success');
    } catch (error) {
      showToast('Fehler beim Speichern', 'error');
    }
    
    closeStatusModal();
    closeLeadDetail();
  });

  // ==================== SEO ====================
  function updateSeoView() {
    document.getElementById('seoStatTotal').textContent = allKeywords.length;
    document.getElementById('seoStatTop10').textContent = allKeywords.filter(k => k.current_rank && k.current_rank <= 10).length;
    document.getElementById('seoStatUp').textContent = allKeywords.filter(k => k.trend === 'up').length;
    document.getElementById('seoStatDown').textContent = allKeywords.filter(k => k.trend === 'down').length;
    renderSeoTable();
  }

  function filterKeywords() {
    const category = document.getElementById('seoFilterCategory').value;
    const priority = document.getElementById('seoFilterPriority').value;
    const trend = document.getElementById('seoFilterTrend').value;
    const search = document.getElementById('seoFilterSearch').value.toLowerCase();

    filteredKeywords = allKeywords.filter(k => {
      if (category && k.category !== category) return false;
      if (priority && k.priority !== priority) return false;
      if (trend && k.trend !== trend) return false;
      if (search && !k.keyword.toLowerCase().includes(search)) return false;
      return true;
    });
    renderSeoTable();
  }

  function renderSeoTable() {
    document.getElementById('seoTableBody').innerHTML = filteredKeywords.length > 0
      ? filteredKeywords.map(k => `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3"><p class="font-medium text-gray-900">${k.keyword}</p><p class="text-xs text-gray-500">${k.target_url}</p></td>
          <td class="px-4 py-3 text-center"><span class="font-bold ${k.current_rank ? (k.current_rank <= 10 ? 'text-green-600' : k.current_rank <= 20 ? 'text-yellow-600' : 'text-gray-600') : 'text-gray-400'}">${k.current_rank || '-'}</span></td>
          <td class="px-4 py-3 text-center">${getTrendIcon(k.trend, k.current_rank, k.previous_rank_7d)}</td>
          <td class="px-4 py-3 text-center text-sm text-gray-600 hidden sm:table-cell">${(k.impressions || 0).toLocaleString()}</td>
          <td class="px-4 py-3 text-center text-sm text-gray-600 hidden md:table-cell">${k.clicks || 0}</td>
          <td class="px-4 py-3 text-center text-sm text-gray-600 hidden lg:table-cell">${k.ctr || 0}%</td>
          <td class="px-4 py-3 text-center"><span class="px-2 py-1 text-xs rounded-full ${getPriorityClass(k.priority)}">${k.priority === 'high' ? 'Hoch' : k.priority === 'medium' ? 'Mittel' : 'Niedrig'}</span></td>
        </tr>
      `).join('')
      : '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">Keine Keywords gefunden</td></tr>';
  }

  function getTrendIcon(trend, curr, prev) {
    if (trend === 'up') return `<span class="trend-up font-bold">↑${prev && curr ? prev - curr : ''}</span>`;
    if (trend === 'down') return `<span class="trend-down font-bold">↓${prev && curr ? curr - prev : ''}</span>`;
    if (trend === 'stable') return `<span class="trend-stable font-bold">→</span>`;
    return `<span class="text-blue-500">🆕</span>`;
  }

  function getPriorityClass(p) {
    return { 'high': 'priority-high', 'medium': 'priority-medium', 'low': 'priority-low' }[p] || 'bg-gray-100 text-gray-700';
  }

  function openAddKeywordModal() { document.getElementById('addKeywordModal').classList.remove('hidden'); }
  function closeAddKeywordModal() { document.getElementById('addKeywordModal').classList.add('hidden'); }

  document.getElementById('addKeywordForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const newKw = {
      id: Date.now().toString(),
      keyword: document.getElementById('newKeyword').value,
      target_url: document.getElementById('newUrl').value,
      category: document.getElementById('newCategory').value,
      priority: document.getElementById('newPriority').value,
      current_rank: null, previous_rank_7d: null, trend: 'new',
      search_volume: 0, clicks: 0, impressions: 0, ctr: 0
    };
    allKeywords.push(newKw);
    saveToLocalStorage();
    updateAllViews();
    closeAddKeywordModal();
    this.reset();
    showToast('Keyword hinzugefügt', 'success');
  });

  // ==================== ANALYTICS ====================
  function updateAnalyticsView() {
    updateFunnel();
    renderAnalyticsCharts();
  }

  function setTimeRange(days) {
    currentTimeRange = days;
    document.querySelectorAll('.time-btn').forEach(btn => {
      btn.classList.remove('bg-cyan-600', 'text-white');
      btn.classList.add('bg-gray-200', 'text-gray-700');
    });
    event.target.classList.add('bg-cyan-600', 'text-white');
    event.target.classList.remove('bg-gray-200', 'text-gray-700');
    updateAnalyticsView();
  }

  function updateFunnel() {
    const cutoff = new Date(); cutoff.setDate(cutoff.getDate() - currentTimeRange);
    const filteredE = currentTimeRange === 999999 ? allEvents : allEvents.filter(e => new Date(e.created_at) >= cutoff);
    const filteredL = currentTimeRange === 999999 ? allLeads : allLeads.filter(l => new Date(l.created_at) >= cutoff);

    const shown = filteredE.filter(e => e.event_type === 'popup_shown').length;
    const leads = filteredL.length;

    document.getElementById('funnelPopupShown').textContent = shown;
    document.getElementById('funnelLeads').textContent = leads;

    const rate = shown > 0 ? ((leads / shown) * 100).toFixed(1) : '0';
    document.getElementById('funnelLeadsBar').style.width = `${Math.min(rate, 100)}%`;
    document.getElementById('funnelLeadsBar').textContent = `${rate}%`;
  }

  function renderAnalyticsCharts() {
    if (charts.analyticsSource) charts.analyticsSource.destroy();
    if (charts.analyticsStatus) charts.analyticsStatus.destroy();

    const cutoff = new Date(); cutoff.setDate(cutoff.getDate() - currentTimeRange);
    const leads = currentTimeRange === 999999 ? allLeads : allLeads.filter(l => new Date(l.created_at) >= cutoff);

    const sourceData = {};
    leads.forEach(l => { sourceData[l.source || 'unknown'] = (sourceData[l.source || 'unknown'] || 0) + 1; });
    charts.analyticsSource = new Chart(document.getElementById('analyticsSourceChart'), {
      type: 'pie',
      data: { labels: Object.keys(sourceData).map(s => s === 'exit_popup' ? 'Exit-Popup' : 'Multi-Step'), datasets: [{ data: Object.values(sourceData), backgroundColor: ['#8b5cf6', '#0ea5e9'] }] },
      options: { responsive: true, maintainAspectRatio: false }
    });

    const statusData = {};
    leads.forEach(l => { statusData[l.status || 'unknown'] = (statusData[l.status || 'unknown'] || 0) + 1; });
    charts.analyticsStatus = new Chart(document.getElementById('analyticsStatusChart'), {
      type: 'bar',
      data: { labels: Object.keys(statusData).map(formatStatus), datasets: [{ label: 'Leads', data: Object.values(statusData), backgroundColor: '#0ea5e9' }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
  }

  // ==================== OPTIMIZE ====================
  function populateOptimizeSelect() {
    document.getElementById('optimizeKeywordSelect').innerHTML = '<option value="">Keyword auswählen...</option>' + allKeywords.map(k => `<option value="${k.id}">${k.keyword} (Pos. ${k.current_rank || '-'})</option>`).join('');
  }

  function generateOptimization() {
    const id = document.getElementById('optimizeKeywordSelect').value;
    const kw = allKeywords.find(k => k.id === id);
    if (!kw) { showToast('Bitte Keyword auswählen', 'error'); return; }

    document.getElementById('optimizationAnalysis').innerHTML = `
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
        <div class="bg-gray-50 p-3 rounded-lg"><p class="text-xs text-gray-500">Keyword</p><p class="font-semibold">${kw.keyword}</p></div>
        <div class="bg-gray-50 p-3 rounded-lg"><p class="text-xs text-gray-500">Position</p><p class="font-semibold ${kw.current_rank && kw.current_rank <= 10 ? 'text-green-600' : 'text-orange-600'}">${kw.current_rank || '-'}</p></div>
        <div class="bg-gray-50 p-3 rounded-lg"><p class="text-xs text-gray-500">Impressionen</p><p class="font-semibold">${(kw.impressions || 0).toLocaleString()}</p></div>
        <div class="bg-gray-50 p-3 rounded-lg"><p class="text-xs text-gray-500">CTR</p><p class="font-semibold">${kw.ctr || 0}%</p></div>
      </div>
      <div class="bg-amber-50 p-4 rounded-lg">
        <h4 class="font-semibold text-amber-800 mb-2">⚡ Empfehlungen</h4>
        <ul class="list-disc list-inside text-sm text-amber-700 space-y-1">
          ${kw.current_rank && kw.current_rank > 10 ? '<li>Position verbessern: Content erweitern, Backlinks aufbauen</li>' : ''}
          ${kw.ctr < 3 ? '<li>CTR verbessern: Meta-Title und Description optimieren</li>' : ''}
          ${!kw.current_rank ? '<li>Noch nicht gerankt: Dedizierte Landingpage erstellen</li>' : ''}
          <li>Interne Verlinkung von relevanten Seiten hinzufügen</li>
        </ul>
      </div>
    `;

    document.getElementById('autooptimizePrompt').textContent = `Du bist ein SEO-Experte. Optimiere die Seite für "${kw.keyword}".

AKTUELLE SITUATION:
- Website: leipzig-photovoltaik.de
- Ziel-URL: ${kw.target_url}
- Ranking: Position ${kw.current_rank || 'nicht gerankt'}
- Impressionen: ${kw.impressions || 0}
- CTR: ${kw.ctr || 0}%

AUFGABEN:
1. Optimierter Meta-Title (max. 60 Zeichen)
2. Optimierte Meta-Description (max. 155 Zeichen)
3. H1-Überschrift mit Keyword
4. 3 H2-Überschriften
5. Einleitungstext (100-150 Wörter)
6. 5 interne Verlinkungsmöglichkeiten`;

    document.getElementById('optimizationResults').classList.remove('hidden');
    showToast('Analyse generiert', 'success');
  }

  function copyPrompt() {
    navigator.clipboard.writeText(document.getElementById('autooptimizePrompt').textContent);
    showToast('Prompt kopiert', 'success');
  }

  // ==================== NAVIGATION ====================
  function showSection(section) {
    document.querySelectorAll('.section').forEach(s => s.classList.add('hidden'));
    document.getElementById(`section${section.charAt(0).toUpperCase() + section.slice(1)}`).classList.remove('hidden');

    document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
    const navBtn = document.getElementById(`nav${section.charAt(0).toUpperCase() + section.slice(1)}`);
    if (navBtn) navBtn.classList.add('active');

    document.querySelectorAll('[id^="mobileNav"]').forEach(i => i.classList.remove('text-cyan-600'));
    document.querySelectorAll('[id^="mobileNav"]').forEach(i => i.classList.add('text-gray-500'));
    const mobileBtn = document.getElementById(`mobileNav${section.charAt(0).toUpperCase() + section.slice(1)}`);
    if (mobileBtn) { mobileBtn.classList.add('text-cyan-600'); mobileBtn.classList.remove('text-gray-500'); }

    const titles = { overview: 'Übersicht', leads: 'Leads', seo: 'SEO Keywords', analytics: 'Analytics', optimize: 'KI-Optimierung', settings: 'Einstellungen' };
    document.getElementById('pageTitle').textContent = titles[section] || section;
  }

  // ==================== MODALS ====================
  function showGuide() { document.getElementById('guideModal').classList.remove('hidden'); }
  function closeGuide() { document.getElementById('guideModal').classList.add('hidden'); }

  // ==================== TOAST ====================
  function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast px-4 py-3 rounded-lg shadow-lg text-sm font-medium ${type === 'success' ? 'bg-green-600 text-white' : type === 'error' ? 'bg-red-600 text-white' : 'bg-gray-800 text-white'}`;
    toast.textContent = message;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }
</script>

</body>
</html>
