  function generateAlerts() {
    const alerts = [];
    
    // New leads alert
    const newLeads = allLeads.filter(l => l.status === 'new').length;
    if (newLeads > 0) {
      alerts.push({ type: 'lead', text: `${newLeads} neue Lead(s) warten auf Bearbeitung`, action: "showMainTab('leads')" });
    }

    // High potential keywords
    const highPotential = allKeywords.filter(k => k.current_rank && k.current_rank > 10 && k.current_rank <= 30 && (k.impressions || k.search_volume) > 300);
    highPotential.forEach(k => {
      alerts.push({ type: 'seo', text: `"${k.keyword}" (Pos. ${k.current_rank}) hat hohes Potenzial - ${k.impressions || k.search_volume} Impressionen`, action: "showMainTab('optimize')" });
    });

    // Low CTR keywords
    const lowCtr = allKeywords.filter(k => k.current_rank && k.current_rank <= 10 && k.ctr < 2);
    lowCtr.forEach(k => {
      alerts.push({ type: 'seo', text: `"${k.keyword}" (Pos. ${k.current_rank}) hat niedrige CTR (${k.ctr}%) - Meta-Description optimieren`, action: "showMainTab('optimize')" });
    });

    document.getElementById('alertsList').innerHTML = alerts.length > 0
      ? alerts.map(a => `
        <div class="flex justify-between items-center p-2 bg-white rounded-lg cursor-pointer hover:bg-amber-50 transition" onclick="${a.action}">
          <span class="text-sm text-amber-800">${a.type === 'lead' ? '👥' : '🔍'} ${a.text}</span>
          <span class="text-amber-600">→</span>
        </div>
      `).join('')
      : '<p class="text-sm text-amber-700">✅ Keine dringenden Handlungen erforderlich</p>';
  }

  function renderOverviewCharts() {
    // Destroy existing charts
    if (charts.overviewLeads) charts.overviewLeads.destroy();
    if (charts.overviewRanking) charts.overviewRanking.destroy();

    // Leads over time
    const last30Days = getLast30DaysData(allLeads);
    charts.overviewLeads = new Chart(document.getElementById('overviewLeadsChart'), {
      type: 'line',
      data: {
        labels: Object.keys(last30Days),
        datasets: [{ label: 'Leads', data: Object.values(last30Days), borderColor: '#0ea5e9', backgroundColor: 'rgba(14, 165, 233, 0.1)', tension: 0.4, fill: true }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    // Ranking distribution
    const rankingDist = { 'Top 3': 0, 'Top 10': 0, 'Top 20': 0, 'Top 50': 0, '50+': 0, 'Nicht gerankt': 0 };
    allKeywords.forEach(k => {
      if (!k.current_rank) rankingDist['Nicht gerankt']++;
      else if (k.current_rank <= 3) rankingDist['Top 3']++;
      else if (k.current_rank <= 10) rankingDist['Top 10']++;
      else if (k.current_rank <= 20) rankingDist['Top 20']++;
      else if (k.current_rank <= 50) rankingDist['Top 50']++;
      else rankingDist['50+']++;
    });
    charts.overviewRanking = new Chart(document.getElementById('overviewRankingChart'), {
      type: 'doughnut',
      data: {
        labels: Object.keys(rankingDist),
        datasets: [{ data: Object.values(rankingDist), backgroundColor: ['#10b981', '#22c55e', '#84cc16', '#eab308', '#f97316', '#6b7280'] }]
      },
      options: { responsive: true }
    });
  }

  function getLast30DaysData(leads) {
    const data = {};
    const now = new Date();
    for (let i = 29; i >= 0; i--) {
      const date = new Date(now);
      date.setDate(date.getDate() - i);
      const key = date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' });
      data[key] = 0;
    }
    leads.forEach(l => {
      const date = new Date(l.created_at).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' });
      if (data.hasOwnProperty(date)) data[date]++;
    });
    return data;
  }

  // ==================== LEADS TAB ====================
  function filterLeads() {
    const status = document.getElementById('leadsFilterStatus').value;
    const source = document.getElementById('leadsFilterSource').value;
    const project = document.getElementById('leadsFilterProject').value;
    const search = document.getElementById('leadsFilterSearch').value.toLowerCase();

    filteredLeads = allLeads.filter(l => {
      if (status && l.status !== status) return false;
      if (source && l.source !== source) return false;
      if (project && l.project_type !== project) return false;
      if (search && !`${l.name} ${l.email}`.toLowerCase().includes(search)) return false;
      return true;
    });

    updateLeadsTable();
  }

  function updateLeadsTable() {
    document.getElementById('leadsTableBody').innerHTML = filteredLeads.length > 0
      ? filteredLeads.map(l => `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <p class="font-medium text-gray-900">${l.name || 'Unbekannt'}</p>
          </td>
          <td class="px-4 py-3">
            <p class="text-sm text-gray-600">${l.email || '-'}</p>
            <p class="text-xs text-gray-400">${l.phone || '-'}</p>
          </td>
          <td class="px-4 py-3">
            <span class="px-2 py-1 text-xs rounded-full ${l.source === 'exit_popup' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}">
              ${l.source === 'exit_popup' ? 'Exit-Popup' : 'Multi-Step'}
            </span>
          </td>
          <td class="px-4 py-3">
            <span class="text-sm text-gray-600">${l.project_type || '-'}</span>
          </td>
          <td class="px-4 py-3">
            <span class="px-2 py-1 text-xs rounded-full ${getStatusColor(l.status)}">${formatStatus(l.status)}</span>
          </td>
          <td class="px-4 py-3 text-sm text-gray-500">
            ${new Date(l.created_at).toLocaleDateString('de-DE')}
          </td>
          <td class="px-4 py-3 text-center">
            <button onclick="openUpdateStatusModal('${l.id}', '${l.name}')" class="text-cyan-600 hover:text-cyan-800">✏️</button>
          </td>
        </tr>
      `).join('')
      : '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">Keine Leads gefunden</td></tr>';
  }

  function getStatusColor(status) {
    const colors = {
      'new': 'bg-cyan-100 text-cyan-700',
      'contacted': 'bg-yellow-100 text-yellow-700',
      'qualified': 'bg-blue-100 text-blue-700',
      'proposal_sent': 'bg-purple-100 text-purple-700',
      'won': 'bg-green-100 text-green-700',
      'lost': 'bg-red-100 text-red-700'
    };
    return colors[status] || 'bg-gray-100 text-gray-700';
  }

  function formatStatus(status) {
    const map = { 'new': 'Neu', 'contacted': 'Kontaktiert', 'qualified': 'Qualifiziert', 'proposal_sent': 'Angebot', 'won': 'Gewonnen', 'lost': 'Verloren' };
    return map[status] || status;
  }

  function exportLeadsCSV() {
    const headers = ['ID', 'Name', 'Email', 'Telefon', 'Quelle', 'Projekttyp', 'Status', 'Erstellt'];
    const rows = filteredLeads.map(l => [l.id, l.name, l.email, l.phone, l.source, l.project_type, l.status, l.created_at]);
    const csv = [headers.join(','), ...rows.map(r => r.map(v => `"${v || ''}"`).join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `leads_export_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
  }

  // ==================== SEO TAB ====================
  function filterKeywords() {
    const category = document.getElementById('seoFilterCategory').value;
    const priority = document.getElementById('seoFilterPriority').value;
    const trend = document.getElementById('seoFilterTrend').value;
    const search = document.getElementById('seoFilterSearch').value.toLowerCase();

    filteredKeywords = allKeywords.filter(k => {
      if (category && k.category !== category) return false;
      if (priority && k.priority !== priority) return false;
      if (trend && k.trend !== trend) return false;
      if (search && !k.keyword.toLowerCase().includes(search)) return false;
      return true;
    });

    updateSeoTable();
    updateSeoStats();
  }

  function updateSeoStats() {
    document.getElementById('seoStatTotal').textContent = filteredKeywords.length;
    document.getElementById('seoStatTop10').textContent = filteredKeywords.filter(k => k.current_rank && k.current_rank <= 10).length;
    document.getElementById('seoStatUp').textContent = filteredKeywords.filter(k => k.trend === 'up').length;
    document.getElementById('seoStatDown').textContent = filteredKeywords.filter(k => k.trend === 'down').length;
  }

  function updateSeoTable() {
    updateSeoStats();
    document.getElementById('seoTableBody').innerHTML = filteredKeywords.length > 0
      ? filteredKeywords.map(k => `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <p class="font-medium text-gray-900">${k.keyword}</p>
            <p class="text-xs text-gray-500">${k.category}</p>
          </td>
          <td class="px-4 py-3">
            <a href="https://leipzig-photovoltaik.de${k.target_url}" target="_blank" class="text-cyan-600 hover:underline text-sm">${k.target_url}</a>
          </td>
          <td class="px-4 py-3 text-center">
            <span class="font-bold ${k.current_rank ? (k.current_rank <= 10 ? 'text-green-600' : k.current_rank <= 20 ? 'text-yellow-600' : 'text-gray-600') : 'text-gray-400'}">
              ${k.current_rank || '-'}
            </span>
          </td>
          <td class="px-4 py-3 text-center">
            ${getTrendIcon(k.trend, k.current_rank, k.previous_rank_7d)}
          </td>
          <td class="px-4 py-3 text-center text-sm text-gray-600">${(k.impressions || k.search_volume || 0).toLocaleString()}</td>
          <td class="px-4 py-3 text-center text-sm text-gray-600">${k.clicks || 0}</td>
          <td class="px-4 py-3 text-center text-sm text-gray-600">${k.ctr || 0}%</td>
          <td class="px-4 py-3 text-center">
            <span class="px-2 py-1 text-xs rounded-full ${getPriorityColor(k.priority)}">${k.priority === 'high' ? 'Hoch' : k.priority === 'medium' ? 'Mittel' : 'Niedrig'}</span>
          </td>
          <td class="px-4 py-3 text-center">
            <button onclick="openGoogleSearch('${encodeURIComponent(k.keyword)}')" class="text-gray-400 hover:text-green-600" title="In Google suchen">🔍</button>
          </td>
        </tr>
      `).join('')
      : '<tr><td colspan="9" class="px-4 py-8 text-center text-gray-500">Keine Keywords gefunden</td></tr>';
  }

  function getTrendIcon(trend, currentRank, previousRank) {
    if (trend === 'up') {
      const diff = previousRank && currentRank ? previousRank - currentRank : 0;
      return `<span class="trend-up font-bold">↑${diff > 0 ? diff : ''}</span>`;
    } else if (trend === 'down') {
      const diff = previousRank && currentRank ? currentRank - previousRank : 0;
      return `<span class="trend-down font-bold">↓${diff > 0 ? diff : ''}</span>`;
    } else if (trend === 'stable') {
      return `<span class="trend-stable font-bold">→</span>`;
    } else {
      return `<span class="text-blue-500">🆕</span>`;
    }
  }

  function getPriorityColor(priority) {
    const colors = { 'high': 'bg-red-100 text-red-700', 'medium': 'bg-yellow-100 text-yellow-700', 'low': 'bg-green-100 text-green-700' };
    return colors[priority] || 'bg-gray-100 text-gray-700';
  }

  function openGoogleSearch(keyword) {
    window.open(`https://www.google.de/search?q=${keyword}`, '_blank');
  }

  // ==================== ANALYTICS TAB ====================
  function setTimeRange(days) {
    currentTimeRange = days;
    document.querySelectorAll('.time-btn').forEach(btn => {
      btn.classList.remove('bg-cyan-600', 'text-white');
      btn.classList.add('bg-gray-200', 'text-gray-700');
    });
    event.target.classList.remove('bg-gray-200', 'text-gray-700');
    event.target.classList.add('bg-cyan-600', 'text-white');
    updateAnalytics();
  }

  function updateAnalytics() {
    const cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - currentTimeRange);
    
    const filteredL = currentTimeRange === 999999 ? allLeads : allLeads.filter(l => new Date(l.created_at) >= cutoff);
    const filteredE = currentTimeRange === 999999 ? allEvents : allEvents.filter(e => new Date(e.created_at) >= cutoff);

    // Funnel
    const popupShown = filteredE.filter(e => e.event_type === 'popup_shown').length;
    const popupSubmitted = filteredL.filter(l => l.source === 'exit_popup').length;
    const formCompleted = filteredL.filter(l => l.source === 'multi_step_form').length;
    const formStarted = formCompleted; // Approximation

    document.getElementById('funnelPopupShown').textContent = popupShown;
    document.getElementById('funnelPopupSubmitted').textContent = popupSubmitted;
    document.getElementById('funnelFormStarted').textContent = formStarted;
    document.getElementById('funnelFormCompleted').textContent = formCompleted;

    const popupRate = popupShown > 0 ? ((popupSubmitted / popupShown) * 100).toFixed(1) : '0';
    document.getElementById('funnelPopupSubmittedBar').style.width = `${popupRate}%`;
    document.getElementById('funnelPopupSubmittedBar').textContent = `${popupRate}%`;

    // Charts
    renderAnalyticsCharts(filteredL);
  }

  function renderAnalyticsCharts(leads) {
    if (charts.analyticsSource) charts.analyticsSource.destroy();
    if (charts.analyticsStatus) charts.analyticsStatus.destroy();

    // Source chart
    const sourceData = {};
    leads.forEach(l => { sourceData[l.source || 'unknown'] = (sourceData[l.source || 'unknown'] || 0) + 1; });
    charts.analyticsSource = new Chart(document.getElementById('analyticsSourceChart'), {
      type: 'pie',
      data: {
        labels: Object.keys(sourceData).map(s => s === 'exit_popup' ? 'Exit-Popup' : s === 'multi_step_form' ? 'Multi-Step' : s),
        datasets: [{ data: Object.values(sourceData), backgroundColor: ['#8b5cf6', '#0ea5e9', '#10b981'] }]
      },
      options: { responsive: true }
    });

    // Status chart
    const statusData = {};
    leads.forEach(l => { statusData[l.status || 'unknown'] = (statusData[l.status || 'unknown'] || 0) + 1; });
    charts.analyticsStatus = new Chart(document.getElementById('analyticsStatusChart'), {
      type: 'bar',
      data: {
        labels: Object.keys(statusData).map(formatStatus),
        datasets: [{ label: 'Leads', data: Object.values(statusData), backgroundColor: '#0ea5e9' }]
      },
      options: { responsive: true, plugins: { legend: { display: false } } }
    });
  }

  // ==================== KI-OPTIMIERUNG TAB ====================
  function populateOptimizeSelect() {
    const select = document.getElementById('optimizeKeywordSelect');
    select.innerHTML = allKeywords.map(k => `<option value="${k.id}">${k.keyword} (Pos. ${k.current_rank || '-'})</option>`).join('');
  }

  function generateOptimization() {
    const keywordId = document.getElementById('optimizeKeywordSelect').value;
    const keyword = allKeywords.find(k => k.id === keywordId);
    if (!keyword) return;

    // Analysis
    const analysis = `
      <div class="space-y-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-gray-50 p-3 rounded-lg">
            <p class="text-xs text-gray-500">Keyword</p>
            <p class="font-semibold">${keyword.keyword}</p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg">
            <p class="text-xs text-gray-500">Position</p>
            <p class="font-semibold ${keyword.current_rank && keyword.current_rank <= 10 ? 'text-green-600' : 'text-orange-600'}">${keyword.current_rank || 'Nicht gerankt'}</p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg">
            <p class="text-xs text-gray-500">Impressionen</p>
            <p class="font-semibold">${(keyword.impressions || keyword.search_volume || 0).toLocaleString()}</p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg">
            <p class="text-xs text-gray-500">CTR</p>
            <p class="font-semibold ${keyword.ctr >= 3 ? 'text-green-600' : 'text-orange-600'}">${keyword.ctr || 0}%</p>
          </div>
        </div>
        <div class="bg-amber-50 p-4 rounded-lg">
          <h4 class="font-semibold text-amber-800 mb-2">⚡ Schnelle Empfehlungen</h4>
          <ul class="list-disc list-inside text-sm text-amber-700 space-y-1">
            ${keyword.current_rank && keyword.current_rank > 10 ? '<li>Position verbessern: Mehr Backlinks aufbauen, Content erweitern</li>' : ''}
            ${keyword.ctr < 3 ? '<li>CTR verbessern: Meta-Title und Description optimieren</li>' : ''}
            ${!keyword.current_rank ? '<li>Noch nicht gerankt: Dedizierte Landingpage erstellen</li>' : ''}
            <li>Interne Verlinkung von relevanten Seiten hinzufügen</li>
            <li>Keyword in H1, H2 und ersten 100 Wörtern verwenden</li>
          </ul>
        </div>
      </div>
    `;
    document.getElementById('optimizationAnalysis').innerHTML = analysis;

    // Autooptimize Prompt
    const prompt = `Du bist ein SEO-Experte. Analysiere und optimiere die folgende Seite für das Keyword "${keyword.keyword}".

AKTUELLE SITUATION:
- Website: leipzig-photovoltaik.de
- Ziel-URL: ${keyword.target_url}
- Aktuelles Ranking: Position ${keyword.current_rank || 'nicht gerankt'}
- Suchvolumen: ${keyword.search_volume || 'unbekannt'} Suchen/Monat
- CTR: ${keyword.ctr || 0}%
- Branche: Photovoltaik / Solaranlagen in Leipzig

AUFGABEN:
1. Schreibe einen optimierten Meta-Title (max. 60 Zeichen) mit dem Keyword am Anfang
2. Schreibe eine optimierte Meta-Description (max. 155 Zeichen) mit Call-to-Action
3. Schreibe eine H1-Überschrift mit dem Keyword
4. Erstelle 3 H2-Überschriften für wichtige Abschnitte
5. Schreibe einen optimierten Einleitungstext (100-150 Wörter) mit dem Keyword in den ersten 50 Wörtern
6. Liste 5 interne Verlinkungsmöglichkeiten auf (von welchen Seiten zu dieser Seite verlinkt werden sollte)
7. Gib 3 konkrete Verbesserungsvorschläge für besseres Ranking

FORMAT: Strukturiert mit klaren Überschriften, direkt kopierbar für die Implementierung.`;

    document.getElementById('autooptimizePrompt').textContent = prompt;
    document.getElementById('optimizationResults').classList.remove('hidden');
  }

  function copyPrompt() {
    const prompt = document.getElementById('autooptimizePrompt').textContent;
    navigator.clipboard.writeText(prompt);
    alert('Prompt kopiert!');
  }

  // ==================== MODALS ====================
  function openAddKeywordModal() {
    document.getElementById('addKeywordModal').classList.remove('hidden');
  }

  function closeAddKeywordModal() {
    document.getElementById('addKeywordModal').classList.add('hidden');
  }

  document.getElementById('addKeywordForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const newKeyword = {
      id: Date.now().toString(),
      keyword: document.getElementById('newKeyword').value,
      target_url: document.getElementById('newUrl').value,
      category: document.getElementById('newCategory').value,
      priority: document.getElementById('newPriority').value,
      search_volume: parseInt(document.getElementById('newVolume').value) || 0,
      current_rank: parseInt(document.getElementById('newPosition').value) || null,
      previous_rank_7d: null,
      trend: 'new',
      clicks: 0,
      impressions: 0,
      ctr: 0
    };
    allKeywords.push(newKeyword);
    saveToLocalStorage();
    updateAllViews();
    closeAddKeywordModal();
    this.reset();
  });

  function openUpdateStatusModal(id, name) {
    document.getElementById('updateLeadId').value = id;
    document.getElementById('updateLeadName').textContent = name;
    document.getElementById('updateStatusModal').classList.remove('hidden');
  }

  function closeUpdateStatusModal() {
    document.getElementById('updateStatusModal').classList.add('hidden');
  }

  document.getElementById('updateStatusForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const id = document.getElementById('updateLeadId').value;
    const status = document.getElementById('updateStatus').value;
    
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/leads?id=eq.${id}`, {
        method: 'PATCH',
        headers: {
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ status, updated_at: new Date().toISOString() })
      });
      
      // Update local data
      const lead = allLeads.find(l => l.id === id);
      if (lead) lead.status = status;
      saveToLocalStorage();
      updateAllViews();
    } catch (error) {
      console.error('Error updating status:', error);
    }
    
    closeUpdateStatusModal();
  });

  function showGuide() {
    document.getElementById('guideModal').classList.remove('hidden');
  }

  function closeGuide() {
    document.getElementById('guideModal').classList.add('hidden');
  }

  // ==================== TAB NAVIGATION ====================
  function showMainTab(tab) {
    // Hide all tabs
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.main-tab').forEach(el => {
      el.classList.remove('border-cyan-500', 'text-cyan-600');
      el.classList.add('border-transparent', 'text-gray-500');
    });

    // Show selected tab
    document.getElementById(`content${tab.charAt(0).toUpperCase() + tab.slice(1)}`).classList.remove('hidden');
    document.getElementById(`mainTab${tab.charAt(0).toUpperCase() + tab.slice(1)}`).classList.add('border-cyan-500', 'text-cyan-600');
    document.getElementById(`mainTab${tab.charAt(0).toUpperCase() + tab.slice(1)}`).classList.remove('border-transparent', 'text-gray-500');
  }
</script>

</body>
</html>
