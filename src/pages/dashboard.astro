---
// Unified Dashboard v2.0 - Leads + Analytics + SEO + Admin
// Professionelle Plattform für leipzig-photovoltaik.de
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Dashboard | Leipzig Photovoltaik</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .trend-up { color: #10b981; }
    .trend-down { color: #ef4444; }
    .trend-stable { color: #6b7280; }
    .sidebar-item.active { background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white; }
    .sidebar-item:not(.active):hover { background: #f1f5f9; }
    .status-new { background: #dbeafe; color: #1e40af; }
    .status-contacted { background: #fef3c7; color: #92400e; }
    .status-qualified { background: #e0e7ff; color: #3730a3; }
    .status-proposal { background: #f3e8ff; color: #6b21a8; }
    .status-won { background: #d1fae5; color: #065f46; }
    .status-lost { background: #fee2e2; color: #991b1b; }
    .priority-high { background: #fee2e2; color: #991b1b; }
    .priority-medium { background: #fef3c7; color: #92400e; }
    .priority-low { background: #d1fae5; color: #065f46; }
    @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
    .slide-in { animation: slideIn 0.3s ease-out; }
    .toast { animation: slideIn 0.3s ease-out; }
    @media (max-width: 768px) {
      .desktop-sidebar { display: none; }
      .mobile-bottom-nav { display: flex; }
      .main-content { margin-left: 0; padding-bottom: 80px; }
    }
    @media (min-width: 769px) {
      .desktop-sidebar { display: flex; }
      .mobile-bottom-nav { display: none; }
      .main-content { margin-left: 240px; }
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">
  
  <!-- Login Screen -->
  <div id="loginScreen" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-md">
      <div class="text-center mb-8">
        <div class="w-20 h-20 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
          <span class="text-4xl">⚡</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
        <p class="text-gray-500 mt-2">Leipzig Photovoltaik</p>
      </div>
      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Passwort</label>
          <input type="password" id="password" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition" placeholder="••••••••" required>
        </div>
        <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white py-3 rounded-xl font-semibold hover:opacity-90 transition shadow-lg">
          Anmelden
        </button>
        <p id="loginError" class="text-red-500 text-sm text-center hidden">Falsches Passwort</p>
      </form>
    </div>
  </div>

  <!-- Dashboard Container -->
  <div id="dashboard" class="hidden min-h-screen">
    
    <!-- Desktop Sidebar -->
    <aside class="desktop-sidebar fixed left-0 top-0 h-full w-60 bg-white border-r border-gray-200 flex-col z-40">
      <!-- Logo -->
      <div class="p-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center">
            <span class="text-xl">⚡</span>
          </div>
          <div>
            <h1 class="font-bold text-gray-900">Dashboard</h1>
            <p class="text-xs text-gray-500">v2.0</p>
          </div>
        </div>
      </div>
      
      <!-- Navigation -->
      <nav class="flex-1 p-3 space-y-1">
        <button onclick="showSection('overview')" id="navOverview" class="sidebar-item active w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left transition">
          <span class="text-lg">🏠</span>
          <span class="font-medium">Übersicht</span>
        </button>
        <button onclick="showSection('leads')" id="navLeads" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">👥</span>
          <span class="font-medium">Leads</span>
          <span id="leadsCount" class="ml-auto bg-cyan-100 text-cyan-700 text-xs font-bold px-2 py-0.5 rounded-full">0</span>
        </button>
        <button onclick="showSection('seo')" id="navSeo" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">🔍</span>
          <span class="font-medium">SEO</span>
        </button>
        <button onclick="showSection('analytics')" id="navAnalytics" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">📈</span>
          <span class="font-medium">Analytics</span>
        </button>
        <button onclick="showSection('optimize')" id="navOptimize" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
          <span class="text-lg">🤖</span>
          <span class="font-medium">KI-Optimierung</span>
        </button>
        
        <div class="border-t border-gray-200 my-3 pt-3">
          <button onclick="showSection('settings')" id="navSettings" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 transition">
            <span class="text-lg">⚙️</span>
            <span class="font-medium">Einstellungen</span>
          </button>
        </div>
      </nav>
      
      <!-- User Info -->
      <div class="p-4 border-t border-gray-200">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
              <span class="text-sm">👤</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Admin</span>
          </div>
          <button onclick="logout()" class="text-gray-400 hover:text-red-500 transition" title="Abmelden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-40 justify-around py-2">
      <button onclick="showSection('overview')" id="mobileNavOverview" class="flex flex-col items-center p-2 text-cyan-600">
        <span class="text-xl">🏠</span>
        <span class="text-xs mt-1">Übersicht</span>
      </button>
      <button onclick="showSection('leads')" id="mobileNavLeads" class="flex flex-col items-center p-2 text-gray-500">
        <span class="text-xl">👥</span>
        <span class="text-xs mt-1">Leads</span>
      </button>
      <button onclick="showSection('seo')" id="mobileNavSeo" class="flex flex-col items-center p-2 text-gray-500">
        <span class="text-xl">🔍</span>
        <span class="text-xs mt-1">SEO</span>
      </button>
      <button onclick="showSection('analytics')" id="mobileNavAnalytics" class="flex flex-col items-center p-2 text-gray-500">
        <span class="text-xl">📈</span>
        <span class="text-xs mt-1">Analytics</span>
      </button>
      <button onclick="showSection('settings')" id="mobileNavSettings" class="flex flex-col items-center p-2 text-gray-500">
        <span class="text-xl">⚙️</span>
        <span class="text-xs mt-1">Mehr</span>
      </button>
    </nav>

    <!-- Main Content -->
    <main class="main-content min-h-screen">
      <!-- Top Bar -->
      <header class="bg-white border-b border-gray-200 sticky top-0 z-30">
        <div class="px-4 sm:px-6 lg:px-8 py-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 id="pageTitle" class="text-xl font-bold text-gray-900">Übersicht</h2>
              <p id="lastUpdate" class="text-xs text-gray-500">Letztes Update: -</p>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="refreshAllData()" id="refreshBtn" class="p-2 bg-gray-100 rounded-lg hover:bg-gray-200 transition" title="Aktualisieren">
                <span id="refreshIcon">🔄</span>
              </button>
              <button onclick="showGuide()" class="p-2 bg-gray-100 rounded-lg hover:bg-gray-200 transition" title="Hilfe">
                <span>❓</span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Content Sections -->
      <div class="p-4 sm:p-6 lg:p-8">
        
        <!-- ==================== ÜBERSICHT ==================== -->
        <section id="sectionOverview" class="section">
          <!-- Quick Stats -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">Leads Gesamt</p>
                  <p id="statLeadsTotal" class="text-2xl font-bold text-gray-900 mt-1">0</p>
                </div>
                <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                  <span class="text-xl">👥</span>
                </div>
              </div>
              <p class="text-xs text-gray-500 mt-2"><span id="statLeadsNew" class="text-cyan-600 font-semibold">0</span> neue diese Woche</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">Conversion</p>
                  <p id="statConversion" class="text-2xl font-bold text-green-600 mt-1">0%</p>
                </div>
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                  <span class="text-xl">📈</span>
                </div>
              </div>
              <p class="text-xs text-gray-500 mt-2">Exit-Popup → Lead</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">Top 10 Keywords</p>
                  <p id="statTop10" class="text-2xl font-bold text-blue-600 mt-1">0</p>
                </div>
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                  <span class="text-xl">🏆</span>
                </div>
              </div>
              <p class="text-xs text-gray-500 mt-2">von <span id="statKeywordsTotal">0</span> Keywords</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">Impressionen</p>
                  <p id="statImpressions" class="text-2xl font-bold text-purple-600 mt-1">0</p>
                </div>
                <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                  <span class="text-xl">👁️</span>
                </div>
              </div>
              <p class="text-xs text-gray-500 mt-2">Google Suche (30 Tage)</p>
            </div>
          </div>

          <!-- Alerts -->
          <div id="alertsContainer" class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-xl p-4 mb-6 border border-amber-200">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-semibold text-amber-800 flex items-center gap-2">
                <span>⚡</span> Handlungsempfehlungen
              </h3>
              <span id="alertsCount" class="bg-amber-200 text-amber-800 text-xs font-bold px-2 py-1 rounded-full">0</span>
            </div>
            <div id="alertsList" class="space-y-2">
              <p class="text-sm text-amber-700">Lade...</p>
            </div>
          </div>

          <!-- Two Column Layout -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <!-- Recent Leads -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100">
              <div class="p-4 border-b border-gray-100 flex justify-between items-center">
                <h3 class="font-semibold text-gray-900">Neueste Leads</h3>
                <button onclick="showSection('leads')" class="text-xs text-cyan-600 hover:underline">Alle anzeigen →</button>
              </div>
              <div id="recentLeadsList" class="p-4 space-y-3 max-h-80 overflow-y-auto">
                <p class="text-sm text-gray-500 text-center py-4">Lade...</p>
              </div>
            </div>

            <!-- Top Keywords -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100">
              <div class="p-4 border-b border-gray-100 flex justify-between items-center">
                <h3 class="font-semibold text-gray-900">Top Keywords</h3>
                <button onclick="showSection('seo')" class="text-xs text-cyan-600 hover:underline">Alle anzeigen →</button>
              </div>
              <div id="topKeywordsList" class="p-4 space-y-3 max-h-80 overflow-y-auto">
                <p class="text-sm text-gray-500 text-center py-4">Lade...</p>
              </div>
            </div>
          </div>

          <!-- Charts -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
              <h3 class="font-semibold text-gray-900 mb-4">Leads (letzte 30 Tage)</h3>
              <div class="h-64">
                <canvas id="overviewLeadsChart"></canvas>
              </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
              <h3 class="font-semibold text-gray-900 mb-4">Ranking-Verteilung</h3>
              <div class="h-64">
                <canvas id="overviewRankingChart"></canvas>
              </div>
            </div>
          </div>
        </section>

        <!-- ==================== LEADS ==================== -->
        <section id="sectionLeads" class="section hidden">
          <!-- Stats Row -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-gray-900" id="leadsStatTotal">0</p>
              <p class="text-xs text-gray-500">Gesamt</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-cyan-600" id="leadsStatNew">0</p>
              <p class="text-xs text-gray-500">Neu</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-yellow-600" id="leadsStatInProgress">0</p>
              <p class="text-xs text-gray-500">In Bearbeitung</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-green-600" id="leadsStatWon">0</p>
              <p class="text-xs text-gray-500">Gewonnen</p>
            </div>
          </div>

          <!-- Filters & Actions -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
            <div class="flex flex-col lg:flex-row lg:items-center gap-4">
              <div class="flex-1 grid grid-cols-2 sm:grid-cols-4 gap-3">
                <select id="filterStatus" onchange="filterLeads()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
                  <option value="">Alle Status</option>
                  <option value="new">Neu</option>
                  <option value="contacted">Kontaktiert</option>
                  <option value="qualified">Qualifiziert</option>
                  <option value="proposal_sent">Angebot</option>
                  <option value="won">Gewonnen</option>
                  <option value="lost">Verloren</option>
                </select>
                <select id="filterSource" onchange="filterLeads()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
                  <option value="">Alle Quellen</option>
                  <option value="exit_popup">Exit-Popup</option>
                  <option value="multi_step_form">Multi-Step</option>
                </select>
                <select id="filterProject" onchange="filterLeads()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
                  <option value="">Alle Projekte</option>
                  <option value="privat">Privat</option>
                  <option value="gewerbe">Gewerbe</option>
                </select>
                <input type="text" id="filterSearch" onkeyup="filterLeads()" placeholder="Suche..." class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
              </div>
              <div class="flex gap-2">
                <button onclick="exportCSV()" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition flex items-center gap-2">
                  <span>📥</span> CSV
                </button>
              </div>
            </div>
          </div>

          <!-- Leads Grid/List -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Lead</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase hidden sm:table-cell">Kontakt</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase hidden md:table-cell">Quelle</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase hidden lg:table-cell">Datum</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Aktionen</th>
                  </tr>
                </thead>
                <tbody id="leadsTableBody" class="divide-y divide-gray-100">
                  <tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">Lade...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ==================== SEO ==================== -->
        <section id="sectionSeo" class="section hidden">
          <!-- SEO Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-gray-900" id="seoStatTotal">0</p>
              <p class="text-xs text-gray-500">Keywords</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-green-600" id="seoStatTop10">0</p>
              <p class="text-xs text-gray-500">Top 10</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-emerald-600" id="seoStatUp">0</p>
              <p class="text-xs text-gray-500">↑ Gestiegen</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 text-center">
              <p class="text-2xl font-bold text-red-600" id="seoStatDown">0</p>
              <p class="text-xs text-gray-500">↓ Gefallen</p>
            </div>
          </div>

          <!-- Filters -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
            <div class="flex flex-col lg:flex-row lg:items-center gap-4">
              <div class="flex-1 grid grid-cols-2 sm:grid-cols-4 gap-3">
                <select id="seoFilterCategory" onchange="filterKeywords()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
                  <option value="">Alle Kategorien</option>
                  <option value="standort">Standort</option>
                  <option value="produkt">Produkt</option>
                  <option value="ratgeber">Ratgeber</option>
                  <option value="brand">Brand</option>
                </select>
                <select id="seoFilterPriority" onchange="filterKeywords()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
                  <option value="">Alle Prioritäten</option>
                  <option value="high">Hoch</option>
                  <option value="medium">Mittel</option>
                  <option value="low">Niedrig</option>
                </select>
                <select id="seoFilterTrend" onchange="filterKeywords()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
                  <option value="">Alle Trends</option>
                  <option value="up">↑ Gestiegen</option>
                  <option value="down">↓ Gefallen</option>
                  <option value="stable">→ Stabil</option>
                  <option value="new">🆕 Neu</option>
                </select>
                <input type="text" id="seoFilterSearch" onkeyup="filterKeywords()" placeholder="Keyword suchen..." class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
              </div>
              <button onclick="openAddKeywordModal()" class="px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-medium hover:bg-cyan-700 transition">
                + Keyword
              </button>
            </div>
          </div>

          <!-- Keywords Table -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Keyword</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Position</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Trend</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase hidden sm:table-cell">Impressionen</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase hidden md:table-cell">Klicks</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase hidden lg:table-cell">CTR</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Priorität</th>
                  </tr>
                </thead>
