<script is:inline>
  // ==================== CONFIG ====================
  const PASSWORD = 'leipzig2026';
  const SUPABASE_URL = 'https://jodqplzftabmqnsxdbfk.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpvZHFwbHpmdGFibXFuc3hkYmZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzgzNTI1NzQsImV4cCI6MjA1MzkyODU3NH0.hqPr0n-SCLfCPXCkJPFB_pL3VBcmJCpnQxziL5M0s0k';
  
  // Refresh-Einstellungen (aus LocalStorage laden oder Default)
  let AUTO_REFRESH_HOURS = parseInt(localStorage.getItem('dashboard_refreshInterval') || '24');
  let AUTO_REFRESH_ENABLED = localStorage.getItem('dashboard_autoRefresh') !== 'false';

  // ==================== STATE ====================
  let allLeads = [];
  let filteredLeads = [];
  let allKeywords = [];
  let filteredKeywords = [];
  let allEvents = [];
  let currentTimeRange = 7;
  let charts = {};
  let currentLeadId = null;

  // ==================== INIT ====================
  document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    if (document.getElementById('password').value === PASSWORD) {
      sessionStorage.setItem('dashboard_auth', 'true');
      showDashboard();
    } else {
      document.getElementById('loginError').classList.remove('hidden');
    }
  });

  if (sessionStorage.getItem('dashboard_auth') === 'true') showDashboard();

  // Keyboard shortcuts
  document.addEventListener('keydown', function(e) {
    if (document.getElementById('dashboard').classList.contains('hidden')) return;
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
    
    switch(e.key) {
      case '1': showSection('overview'); break;
      case '2': showSection('leads'); break;
      case '3': showSection('seo'); break;
      case '4': showSection('analytics'); break;
      case 'r': case 'R': refreshAllData(); break;
      case '?': showGuide(); break;
    }
  });

  function showDashboard() {
    document.getElementById('loginScreen').classList.add('hidden');
    document.getElementById('dashboard').classList.remove('hidden');
    initializeDashboard();
  }

  function logout() {
    sessionStorage.removeItem('dashboard_auth');
    location.reload();
  }

  async function initializeDashboard() {
    // Search Console Daten laden
    await loadSearchConsoleData();
    
    // Refresh-Einstellungen initialisieren
    initRefreshSettings();
    
    const lastUpdate = localStorage.getItem('dashboard_lastUpdate');
    const needsRefresh = AUTO_REFRESH_ENABLED && (!lastUpdate || (Date.now() - parseInt(lastUpdate)) > (AUTO_REFRESH_HOURS * 60 * 60 * 1000));
    
    if (needsRefresh) {
      await refreshAllData();
      // Timestamps für alle Bereiche setzen
      const now = Date.now().toString();
      localStorage.setItem('dashboard_lastUpdate_leads', now);
      localStorage.setItem('dashboard_lastUpdate_seo', now);
      localStorage.setItem('dashboard_lastUpdate_analytics', now);
    } else {
      loadFromLocalStorage();
    }
    // Immer Update-Anzeige und Timestamps aktualisieren
    updateLastUpdateDisplay();
    updateSectionTimestamps();
  }

  // ==================== DATA ====================
  async function refreshAllData() {
    const icon = document.getElementById('refreshIcon');
    icon.textContent = '⏳';
    
    try {
      const [leadsRes, eventsRes] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/leads?select=*&order=created_at.desc`, {
          headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        }),
        fetch(`${SUPABASE_URL}/rest/v1/exit_popup_events?select=*&order=created_at.desc`, {
          headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        })
      ]);
      
      allLeads = leadsRes.ok ? await leadsRes.json() : [];
      allEvents = eventsRes.ok ? await eventsRes.json() : [];
      // Search Console Daten laden falls noch nicht geschehen
      if (!searchConsoleData) await loadSearchConsoleData();
      allKeywords = getKeywordsData();
      
      saveToLocalStorage();
      updateAllViews();
      updateLastUpdateDisplay();
      showToast('Daten aktualisiert', 'success');
    } catch (error) {
      console.error('Error:', error);
      loadFromLocalStorage();
      showToast('Fehler beim Laden', 'error');
    } finally {
      // Immer Timestamp aktualisieren, auch bei Fehlern
      localStorage.setItem('dashboard_lastUpdate', Date.now().toString());
      updateLastUpdateDisplay();
      icon.textContent = '🔄';
    }
  }

  function loadFromLocalStorage() {
    allLeads = JSON.parse(localStorage.getItem('dashboard_leads') || '[]');
    allEvents = JSON.parse(localStorage.getItem('dashboard_events') || '[]');
    allKeywords = JSON.parse(localStorage.getItem('dashboard_keywords') || 'null') || getKeywordsData();
    updateAllViews();
  }

  function saveToLocalStorage() {
    localStorage.setItem('dashboard_leads', JSON.stringify(allLeads));
    localStorage.setItem('dashboard_events', JSON.stringify(allEvents));
    localStorage.setItem('dashboard_keywords', JSON.stringify(allKeywords));
    localStorage.setItem('dashboard_lastUpdate', Date.now().toString());
  }

  // ==================== AKTIVITÄTSPROTOKOLL ====================
  let leadActivities = JSON.parse(localStorage.getItem('dashboard_lead_activities') || '{}');

  function logLeadActivity(leadId, type, details) {
    if (!leadId) return;
    
    const activity = {
      id: Date.now().toString(),
      type: type, // 'status_change', 'note_added', 'note_updated', 'created'
      details: details,
      timestamp: new Date().toISOString(),
      displayTime: new Date().toLocaleString('de-DE', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      })
    };
    
    if (!leadActivities[leadId]) {
      leadActivities[leadId] = [];
    }
    
    leadActivities[leadId].unshift(activity); // Neueste zuerst
    
    // Maximal 50 Aktivitäten pro Lead speichern
    if (leadActivities[leadId].length > 50) {
      leadActivities[leadId] = leadActivities[leadId].slice(0, 50);
    }
    
    localStorage.setItem('dashboard_lead_activities', JSON.stringify(leadActivities));
  }

  function getLeadActivities(leadId) {
    return leadActivities[leadId] || [];
  }

  function getActivityIcon(type) {
    switch(type) {
      case 'status_change': return '🔄';
      case 'note_added': return '📝';
      case 'note_updated': return '✏️';
      case 'created': return '✨';
      default: return '📌';
    }
  }

  function getActivityLabel(type) {
    switch(type) {
      case 'status_change': return 'Status geändert';
      case 'note_added': return 'Notiz hinzugefügt';
      case 'note_updated': return 'Notiz aktualisiert';
      case 'created': return 'Lead erstellt';
      default: return 'Aktivität';
    }
  }

  function renderActivityTimeline(leadId) {
    const activities = getLeadActivities(leadId);
    const container = document.getElementById('leadActivityTimeline');
    
    if (!container) return;
    
    if (activities.length === 0) {
      container.innerHTML = '<p style="color: #9ca3af; font-size: 0.875rem; text-align: center; padding: 1rem;">Noch keine Aktivitäten</p>';
      return;
    }
    
    container.innerHTML = activities.map(act => `
      <div style="display: flex; gap: 0.75rem; padding: 0.75rem 0; border-bottom: 1px solid #f3f4f6;">
        <div style="font-size: 1.25rem;">${getActivityIcon(act.type)}</div>
        <div style="flex: 1; min-width: 0;">
          <div style="font-weight: 500; color: #374151; font-size: 0.875rem;">${getActivityLabel(act.type)}</div>
          <div style="color: #6b7280; font-size: 0.75rem; margin-top: 0.125rem;">${act.details || ''}</div>
          <div style="color: #9ca3af; font-size: 0.625rem; margin-top: 0.25rem;">${act.displayTime}</div>
        </div>
      </div>
    `).join('');
  }

  function updateLastUpdateDisplay() {
    const ts = localStorage.getItem('dashboard_lastUpdate');
    if (ts) {
      document.getElementById('lastUpdate').textContent = `Letztes Update: ${new Date(parseInt(ts)).toLocaleString('de-DE')}`;
    }
  }

  function clearCache() {
    localStorage.removeItem('dashboard_leads');
    localStorage.removeItem('dashboard_events');
    localStorage.removeItem('dashboard_keywords');
    localStorage.removeItem('dashboard_lastUpdate');
    localStorage.removeItem('dashboard_lastUpdate_leads');
    localStorage.removeItem('dashboard_lastUpdate_seo');
    localStorage.removeItem('dashboard_lastUpdate_analytics');
    showToast('Cache geleert', 'success');
    refreshAllData();
  }

  // ==================== ZENTRALE REFRESH-STEUERUNG ====================
  function setRefreshInterval(hours) {
    AUTO_REFRESH_HOURS = hours;
    localStorage.setItem('dashboard_refreshInterval', hours.toString());
    
    // UI aktualisieren
    document.querySelectorAll('.interval-btn').forEach(btn => {
      btn.classList.remove('border-cyan-500', 'bg-cyan-50', 'text-cyan-700', 'font-medium');
      btn.classList.add('border-gray-300');
    });
    const activeBtn = document.getElementById(`interval${hours}`);
    if (activeBtn) {
      activeBtn.classList.remove('border-gray-300');
      activeBtn.classList.add('border-cyan-500', 'bg-cyan-50', 'text-cyan-700', 'font-medium');
    }
    
    showToast(`Refresh-Intervall auf ${hours}h gesetzt`, 'success');
  }

  function toggleAutoRefresh() {
    AUTO_REFRESH_ENABLED = !AUTO_REFRESH_ENABLED;
    localStorage.setItem('dashboard_autoRefresh', AUTO_REFRESH_ENABLED.toString());
    
    const toggle = document.getElementById('autoRefreshToggle');
    const dot = document.getElementById('autoRefreshDot');
    
    if (AUTO_REFRESH_ENABLED) {
      toggle.classList.remove('bg-gray-300');
      toggle.classList.add('bg-cyan-500');
      dot.classList.remove('left-1');
      dot.classList.add('right-1');
      showToast('Auto-Refresh aktiviert', 'success');
    } else {
      toggle.classList.remove('bg-cyan-500');
      toggle.classList.add('bg-gray-300');
      dot.classList.remove('right-1');
      dot.classList.add('left-1');
      showToast('Auto-Refresh deaktiviert', 'info');
    }
  }

  async function refreshSection(section) {
    const now = Date.now();
    
    if (section === 'all') {
      await refreshAllData();
      localStorage.setItem('dashboard_lastUpdate_leads', now.toString());
      localStorage.setItem('dashboard_lastUpdate_seo', now.toString());
      localStorage.setItem('dashboard_lastUpdate_analytics', now.toString());
    } else if (section === 'leads') {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/leads?select=*&order=created_at.desc`, {
          headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        });
        allLeads = res.ok ? await res.json() : [];
        localStorage.setItem('dashboard_leads', JSON.stringify(allLeads));
        localStorage.setItem('dashboard_lastUpdate_leads', now.toString());
        updateAllViews();
        showToast('Leads aktualisiert', 'success');
      } catch (e) {
        showToast('Fehler beim Laden der Leads', 'error');
      }
    } else if (section === 'seo') {
      // Search Console Daten laden falls noch nicht geschehen
      if (!searchConsoleData) await loadSearchConsoleData();
      allKeywords = getKeywordsData();
      localStorage.setItem('dashboard_keywords', JSON.stringify(allKeywords));
      localStorage.setItem('dashboard_lastUpdate_seo', now.toString());
      updateAllViews();
      showToast('SEO-Daten aktualisiert', 'success');
    } else if (section === 'analytics') {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/exit_popup_events?select=*&order=created_at.desc`, {
          headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        });
        allEvents = res.ok ? await res.json() : [];
        localStorage.setItem('dashboard_events', JSON.stringify(allEvents));
        localStorage.setItem('dashboard_lastUpdate_analytics', now.toString());
        updateAllViews();
        showToast('Analytics aktualisiert', 'success');
      } catch (e) {
        showToast('Fehler beim Laden der Analytics', 'error');
      }
    }
    
    updateSectionTimestamps();
  }

  function updateSectionTimestamps() {
    const formatTime = (ts) => ts ? new Date(parseInt(ts)).toLocaleString('de-DE', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '-';
    
    document.getElementById('lastRefreshLeads').textContent = formatTime(localStorage.getItem('dashboard_lastUpdate_leads'));
    document.getElementById('lastRefreshSeo').textContent = formatTime(localStorage.getItem('dashboard_lastUpdate_seo'));
    document.getElementById('lastRefreshAnalytics').textContent = formatTime(localStorage.getItem('dashboard_lastUpdate_analytics'));
  }

  function initRefreshSettings() {
    // Intervall-Button aktivieren
    const currentInterval = parseInt(localStorage.getItem('dashboard_refreshInterval') || '24');
    setRefreshInterval(currentInterval);
    
    // Auto-Refresh Toggle setzen
    const toggle = document.getElementById('autoRefreshToggle');
    const dot = document.getElementById('autoRefreshDot');
    if (!AUTO_REFRESH_ENABLED) {
      toggle.classList.remove('bg-cyan-500');
      toggle.classList.add('bg-gray-300');
      dot.classList.remove('right-1');
      dot.classList.add('left-1');
    }
    
    // Timestamps aktualisieren
    updateSectionTimestamps();
  }

  // Google Search Console Daten aus JSON-Datei laden
  let searchConsoleData = null;
  
  async function loadSearchConsoleData() {
    try {
      const response = await fetch('/data/search-console-data.json');
      if (response.ok) {
        searchConsoleData = await response.json();
        console.log('✅ Search Console Daten geladen:', searchConsoleData.total_keywords, 'Keywords');
        return true;
      }
    } catch (e) {
      console.warn('Search Console Daten nicht verfügbar:', e);
    }
    return false;
  }
  
  function getKeywordsData() {
    // Wenn Search Console Daten vorhanden, diese verwenden
    if (searchConsoleData && searchConsoleData.keywords) {
      return searchConsoleData.keywords.map((k, i) => ({
        id: String(i + 1),
        keyword: k.keyword,
        target_url: k.target_url || '/',
        current_rank: k.current_rank,
        previous_rank_7d: k.previous_rank_7d,
        trend: k.trend || 'stable',
        search_volume: k.impressions || 0,
        clicks: k.clicks || 0,
        impressions: k.impressions || 0,
        ctr: k.ctr || 0,
        category: k.category || 'allgemein',
        priority: k.priority || 'medium'
      }));
    }
    
    // Fallback: Statische Demo-Daten
    return [
      { id: '1', keyword: 'photovoltaik leipzig', target_url: '/', current_rank: 10, previous_rank_7d: 12, trend: 'up', search_volume: 2151, clicks: 14, impressions: 2151, ctr: 0.7, category: 'standort', priority: 'high' },
      { id: '2', keyword: 'presolaris', target_url: '/', current_rank: 2, previous_rank_7d: 2, trend: 'stable', search_volume: 80, clicks: 8, impressions: 80, ctr: 10, category: 'brand', priority: 'medium' },
      { id: '3', keyword: 'pv leipzig', target_url: '/', current_rank: 4, previous_rank_7d: 5, trend: 'up', search_volume: 262, clicks: 2, impressions: 262, ctr: 0.8, category: 'standort', priority: 'high' },
    ];
  }

  // ==================== UPDATE VIEWS ====================
  function updateAllViews() {
    filteredLeads = [...allLeads];
    filteredKeywords = [...allKeywords];
    
    document.getElementById('leadsCount').textContent = allLeads.filter(l => l.status === 'new').length;
    
    updateOverview();
    updateLeadsView();
    updateSeoView();
    updateAnalyticsView();
    populateOptimizeSelect();
