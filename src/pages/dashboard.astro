---
// Unified Dashboard - Leads + Analytics + SEO
// Maximale Automatisierung für leipzig-photovoltaik.de
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Dashboard | Leipzig Photovoltaik</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .trend-up { color: #10b981; }
    .trend-down { color: #ef4444; }
    .trend-stable { color: #6b7280; }
    .tab-active { border-color: #0ea5e9; color: #0ea5e9; background: #f0f9ff; }
    .card-highlight { animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.4); } 50% { box-shadow: 0 0 0 10px rgba(14, 165, 233, 0); } }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  
  <!-- Login Screen -->
  <div id="loginScreen" class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md">
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">📊</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Unified Dashboard</h1>
        <p class="text-gray-500 mt-2">Leads • Analytics • SEO</p>
      </div>
      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Passwort</label>
          <input type="password" id="password" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition" placeholder="Passwort eingeben" required>
        </div>
        <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white py-3 rounded-xl font-semibold hover:opacity-90 transition">
          Anmelden
        </button>
        <p id="loginError" class="text-red-500 text-sm text-center hidden">Falsches Passwort</p>
      </form>
    </div>
  </div>

  <!-- Dashboard -->
  <div id="dashboard" class="hidden">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center">
              <span class="text-xl">📊</span>
            </div>
            <div>
              <h1 class="text-xl font-bold text-gray-900">Unified Dashboard</h1>
              <p class="text-xs text-gray-500">leipzig-photovoltaik.de</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <div id="lastUpdate" class="text-xs text-gray-400 mr-2">
              Letztes Update: -
            </div>
            <button onclick="refreshAllData()" class="px-3 py-2 bg-cyan-50 text-cyan-700 rounded-lg hover:bg-cyan-100 transition text-sm flex items-center gap-1">
              <span id="refreshIcon">🔄</span> Aktualisieren
            </button>
            <button onclick="showGuide()" class="px-3 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition text-sm">
              📖 Hilfe
            </button>
            <button onclick="logout()" class="px-3 py-2 bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition text-sm">
              Abmelden
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Navigation Tabs -->
    <div class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex overflow-x-auto -mb-px">
          <button onclick="showMainTab('overview')" id="mainTabOverview" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-cyan-500 text-cyan-600 whitespace-nowrap">
            🏠 Übersicht
          </button>
          <button onclick="showMainTab('leads')" id="mainTabLeads" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
            👥 Leads
          </button>
          <button onclick="showMainTab('seo')" id="mainTabSeo" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
            🔍 SEO Keywords
          </button>
          <button onclick="showMainTab('analytics')" id="mainTabAnalytics" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
            📈 Analytics
          </button>
          <button onclick="showMainTab('optimize')" id="mainTabOptimize" class="main-tab px-6 py-4 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
            🤖 KI-Optimierung
          </button>
        </nav>
      </div>
    </div>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      
      <!-- ==================== ÜBERSICHT TAB ==================== -->
      <div id="contentOverview" class="tab-content">
        <!-- Quick Stats Row -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6">
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Leads (Gesamt)</p>
            <p id="overviewLeadsTotal" class="text-2xl font-bold text-gray-900 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Leads (Neu)</p>
            <p id="overviewLeadsNew" class="text-2xl font-bold text-cyan-600 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Keywords</p>
            <p id="overviewKeywords" class="text-2xl font-bold text-gray-900 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Top 10 Rankings</p>
            <p id="overviewTop10" class="text-2xl font-bold text-green-600 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Conversion Rate</p>
            <p id="overviewConversion" class="text-2xl font-bold text-blue-600 mt-1">0%</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Impressionen</p>
            <p id="overviewImpressions" class="text-2xl font-bold text-purple-600 mt-1">0</p>
          </div>
        </div>

        <!-- Alerts & Recommendations -->
        <div id="alertsSection" class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-xl p-4 mb-6 border border-amber-200">
          <h3 class="font-semibold text-amber-800 mb-3 flex items-center gap-2">
            <span>⚡</span> Handlungsempfehlungen
          </h3>
          <div id="alertsList" class="space-y-2">
            <!-- Dynamisch befüllt -->
          </div>
        </div>

        <!-- Two Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
          <!-- Recent Leads -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-semibold text-gray-900">Neueste Leads</h3>
              <button onclick="showMainTab('leads')" class="text-xs text-cyan-600 hover:underline">Alle anzeigen →</button>
            </div>
            <div id="recentLeadsList" class="space-y-3">
              <!-- Dynamisch befüllt -->
            </div>
          </div>

          <!-- Top Keywords -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-semibold text-gray-900">Top Keywords</h3>
              <button onclick="showMainTab('seo')" class="text-xs text-cyan-600 hover:underline">Alle anzeigen →</button>
            </div>
            <div id="topKeywordsList" class="space-y-3">
              <!-- Dynamisch befüllt -->
            </div>
          </div>
        </div>

        <!-- Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <h3 class="font-semibold text-gray-900 mb-4">Leads über Zeit (30 Tage)</h3>
            <canvas id="overviewLeadsChart" height="200"></canvas>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <h3 class="font-semibold text-gray-900 mb-4">Ranking-Verteilung</h3>
            <canvas id="overviewRankingChart" height="200"></canvas>
          </div>
        </div>
      </div>

      <!-- ==================== LEADS TAB ==================== -->
      <div id="contentLeads" class="tab-content hidden">
        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Status</label>
              <select id="leadsFilterStatus" onchange="filterLeads()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Status</option>
                <option value="new">Neu</option>
                <option value="contacted">Kontaktiert</option>
                <option value="qualified">Qualifiziert</option>
                <option value="proposal_sent">Angebot gesendet</option>
                <option value="won">Gewonnen</option>
                <option value="lost">Verloren</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Quelle</label>
              <select id="leadsFilterSource" onchange="filterLeads()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Quellen</option>
                <option value="exit_popup">Exit-Popup</option>
                <option value="multi_step_form">Multi-Step-Form</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Projekttyp</label>
              <select id="leadsFilterProject" onchange="filterLeads()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle Typen</option>
                <option value="privat">Privat</option>
                <option value="gewerbe">Gewerbe</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Suche</label>
              <input type="text" id="leadsFilterSearch" onkeyup="filterLeads()" placeholder="Name, Email..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div class="flex items-end">
              <button onclick="exportLeadsCSV()" class="w-full px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition">
                📥 CSV Export
              </button>
            </div>
          </div>
        </div>

        <!-- Leads Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[800px]">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Name</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Kontakt</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Quelle</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Projekt</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Datum</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Aktionen</th>
                </tr>
              </thead>
              <tbody id="leadsTableBody" class="divide-y divide-gray-100">
                <!-- Dynamisch befüllt -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ==================== SEO TAB ==================== -->
      <div id="contentSeo" class="tab-content hidden">
        <!-- SEO Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Gesamt Keywords</p>
            <p id="seoStatTotal" class="text-2xl font-bold text-gray-900 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Top 10</p>
            <p id="seoStatTop10" class="text-2xl font-bold text-green-600 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Verbessert ↑</p>
            <p id="seoStatUp" class="text-2xl font-bold text-emerald-600 mt-1">0</p>
          </div>
          <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500">Verschlechtert ↓</p>
            <p id="seoStatDown" class="text-2xl font-bold text-red-600 mt-1">0</p>
          </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Kategorie</label>
              <select id="seoFilterCategory" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle</option>
                <option value="standort">Standort</option>
                <option value="produkt">Produkt</option>
                <option value="ratgeber">Ratgeber</option>
                <option value="brand">Brand</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Priorität</label>
              <select id="seoFilterPriority" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle</option>
                <option value="high">Hoch</option>
                <option value="medium">Mittel</option>
                <option value="low">Niedrig</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Trend</label>
              <select id="seoFilterTrend" onchange="filterKeywords()" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">Alle</option>
                <option value="up">↑ Gestiegen</option>
                <option value="down">↓ Gefallen</option>
                <option value="stable">→ Stabil</option>
                <option value="new">🆕 Neu</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Suche</label>
              <input type="text" id="seoFilterSearch" onkeyup="filterKeywords()" placeholder="Keyword..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div class="flex items-end">
              <button onclick="openAddKeywordModal()" class="w-full px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-medium hover:bg-cyan-700 transition">
                + Keyword
              </button>
            </div>
          </div>
        </div>

        <!-- Keywords Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[900px]">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Keyword</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">URL</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Position</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Trend</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Impressionen</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Klicks</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">CTR</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Priorität</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Aktionen</th>
                </tr>
              </thead>
              <tbody id="seoTableBody" class="divide-y divide-gray-100">
                <!-- Dynamisch befüllt -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ==================== ANALYTICS TAB ==================== -->
      <div id="contentAnalytics" class="tab-content hidden">
        <!-- Time Filter -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
          <div class="flex flex-wrap gap-2">
            <button onclick="setTimeRange(7)" class="time-btn px-4 py-2 bg-cyan-600 text-white rounded-lg text-sm font-medium" data-days="7">7 Tage</button>
            <button onclick="setTimeRange(30)" class="time-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-sm font-medium" data-days="30">30 Tage</button>
            <button onclick="setTimeRange(90)" class="time-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-sm font-medium" data-days="90">90 Tage</button>
            <button onclick="setTimeRange(999999)" class="time-btn px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-sm font-medium" data-days="all">Alle</button>
          </div>
        </div>

        <!-- Conversion Funnel -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
          <h3 class="font-semibold text-gray-900 mb-4">Conversion Funnel</h3>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="text-sm text-gray-600">Exit-Popup angezeigt</span>
                <span id="funnelPopupShown" class="text-sm font-bold">0</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-6">
                <div id="funnelPopupShownBar" class="bg-blue-500 h-6 rounded-full flex items-center justify-end pr-2 text-white text-xs font-semibold" style="width: 100%">100%</div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="text-sm text-gray-600">Exit-Popup abgeschickt</span>
                <span id="funnelPopupSubmitted" class="text-sm font-bold">0</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-6">
                <div id="funnelPopupSubmittedBar" class="bg-green-500 h-6 rounded-full flex items-center justify-end pr-2 text-white text-xs font-semibold" style="width: 0%">0%</div>
              </div>
            </div>
            <div class="pt-4 border-t border-gray-200">
              <div class="flex justify-between items-center mb-1">
                <span class="text-sm text-gray-600">Multi-Step-Form gestartet</span>
                <span id="funnelFormStarted" class="text-sm font-bold">0</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-6">
                <div id="funnelFormStartedBar" class="bg-blue-500 h-6 rounded-full flex items-center justify-end pr-2 text-white text-xs font-semibold" style="width: 100%">100%</div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="text-sm text-gray-600">Multi-Step-Form abgeschlossen</span>
                <span id="funnelFormCompleted" class="text-sm font-bold">0</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-6">
                <div id="funnelFormCompletedBar" class="bg-green-500 h-6 rounded-full flex items-center justify-end pr-2 text-white text-xs font-semibold" style="width: 0%">0%</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Charts -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <h3 class="font-semibold text-gray-900 mb-4">Leads nach Quelle</h3>
            <canvas id="analyticsSourceChart" height="250"></canvas>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <h3 class="font-semibold text-gray-900 mb-4">Leads nach Status</h3>
            <canvas id="analyticsStatusChart" height="250"></canvas>
          </div>
        </div>
      </div>

      <!-- ==================== KI-OPTIMIERUNG TAB ==================== -->
      <div id="contentOptimize" class="tab-content hidden">
        <!-- Keyword Selection -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
          <h3 class="font-semibold text-gray-900 mb-4">Keyword für Optimierung auswählen</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Keyword</label>
              <select id="optimizeKeywordSelect" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
                <!-- Dynamisch befüllt -->
              </select>
            </div>
            <div class="flex items-end">
              <button onclick="generateOptimization()" class="w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-lg font-semibold hover:opacity-90 transition">
                🤖 KI-Analyse starten
              </button>
            </div>
          </div>
        </div>

        <!-- Optimization Results -->
        <div id="optimizationResults" class="hidden">
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
            <h3 class="font-semibold text-gray-900 mb-4">📊 Analyse-Ergebnis</h3>
            <div id="optimizationAnalysis" class="prose max-w-none">
              <!-- Dynamisch befüllt -->
            </div>
          </div>

          <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl p-6 border border-purple-200">
            <h3 class="font-semibold text-purple-900 mb-4 flex items-center gap-2">
              <span>🚀</span> Autooptimize-Prompt
            </h3>
