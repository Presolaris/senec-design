---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SolarCalculator from '../components/SolarCalculator';
import MultiStepForm from '../components/MultiStepForm.astro';
// import GoogleReviews from '../components/GoogleReviews.astro'; // Deaktiviert für Performance

// Images would normally be imported or referenced directly
const heroImage = "/images/hero-home.png";
---

<Layout title="Photovoltaik Leipzig | Solaranlage vom Fachbetrieb" description="Photovoltaik Leipzig ➤ Ihr lokaler Fachbetrieb für Solaranlagen ✓ Bis 80% Stromkosten sparen ✓ Kostenlose Beratung ☎ 0341 98 99 03 91">
  <LocalBusinessSchema />
  <Header />
  
  <main>
    <!-- Hero + Stats Combined Section -->
    <section class="relative bg-gray-900 text-white overflow-hidden min-h-screen flex flex-col justify-between">
      <div class="absolute inset-0 z-0">
        <img src="/images/hero-home.png" alt="Photovoltaik Leipzig - Solaranlage auf Hausdach in Leipzig" class="w-full h-full object-cover opacity-40" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent"></div>
      </div>
      
      <!-- Hero Content -->
      <div class="relative z-10 pt-10 pb-0 md:pt-20 md:pb-0">
        <div class="container-custom mx-auto">
          <div class="max-w-3xl">
            <span class="text-[var(--senec-yellow)] font-bold tracking-wider uppercase mb-4 block">Photovoltaik Leipzig</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Photovoltaik Leipzig – <br/>
              <span class="text-[var(--senec-turquoise)]">Ihre Solaranlage vom Fachbetrieb</span>
            </h1>
            <p class="text-xl text-gray-300 mb-8 leading-relaxed">
              Produzieren Sie Ihren eigenen Strom, senken Sie Ihre Energiekosten um bis zu 80% und machen Sie sich unabhängig von steigenden Strompreisen.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#rechner" class="btn-primary">
                Kostenloses Angebot anfordern
              </a>
              <a href="/kontakt" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-gray-900 text-center">
                Beratungstermin buchen
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Section -->
      <div class="relative z-10 py-6 bg-[#0D1D37] border-t border-gray-700">
        <div class="container-custom mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-700">
            <div class="p-4">
              <div class="text-4xl font-bold text-[var(--senec-yellow)] mb-2">Bis 80%</div>
              <div class="text-gray-300">Stromkosten sparen</div>
            </div>
            <div class="p-4">
              <div class="text-4xl font-bold text-[var(--senec-turquoise)] mb-2">Ab 11.500€</div>
              <div class="text-gray-300">Komplettsystem inkl. Speicher</div>
            </div>
            <div class="p-4">
              <div class="text-4xl font-bold text-white mb-2">25+ Jahre</div>
              <div class="text-gray-300">Leistungsgarantie</div>
            </div>
          </div>
          
          <!-- Scroll Indicator -->
          <div class="flex justify-center mt-8">
            <a href="#rechner" class="text-[var(--senec-turquoise)] hover:text-white transition-colors duration-300 animate-bounce">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Solar Calculator Section (Full Width) -->
    <section id="rechner" class="py-20 bg-gray-50">
      <div class="container-custom mx-auto mb-12 text-center">
         <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-4">Photovoltaik in Leipzig – Lohnt sich eine Solaranlage für Sie?</h2>
         <p class="text-lg text-gray-600 max-w-3xl mx-auto">Finden Sie es in wenigen Sekunden heraus. Unser Rechner gibt Ihnen eine erste Einschätzung zu Ertrag und Autarkie.</p>
      </div>
      
      <div class="w-full px-4 md:px-0 max-w-[90%] mx-auto">
        <SolarCalculator client:idle />
      </div>
    </section>

    <!-- Products Section (Split Screen) -->
    <section id="produkte">
      <!-- PV System -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden">
          <picture>
            <source srcset="/images/installation.webp" type="image/webp">
            <source srcset="/images/installation.png" type="image/png">
            <img src="/images/installation.webp" 
                 alt="PV Installation" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 width="1226"
                 height="1143"
                 loading="lazy">
          </picture>
        </div>
        <div class="bg-white p-12 md:p-20 flex flex-col justify-center">
          <h3 class="text-2xl md:text-3xl font-bold text-[var(--senec-blue)] mb-6">Photovoltaik-Anlagen</h3>
          <p class="text-gray-600 mb-8 leading-relaxed">
            Hochleistungsmodule, die auch bei schwachem Licht maximale Erträge liefern. 
            Perfekt abgestimmt auf Ihr Dach und Ihren Energiebedarf. Wir setzen auf Qualität, 
            die Jahrzehnte hält.
          </p>
          <a href="/privat" class="text-[var(--senec-turquoise)] font-bold uppercase tracking-wider hover:text-[var(--senec-blue)] transition-colors flex items-center gap-2">
            Mehr erfahren 
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          </div>
      </div>

      <!-- Solarmanager -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-[var(--senec-blue)] p-12 md:p-20 flex flex-col justify-center order-2 md:order-1 text-white">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">Solarmanager</h3>
          <p class="text-gray-100 mb-8 leading-relaxed">
            Intelligentes Energiemanagement für maximale Unabhängigkeit. Steuern Sie Photovoltaik, 
            Stromspeicher, Wallbox und Wärmepumpe zentral – für bis zu 30% mehr Eigenverbrauch und 
            bis zu 500€ Stromkosten-Ersparnis pro Jahr.
          </p>
          <a href="/solarmanager" class="text-white font-bold uppercase tracking-wider hover:text-[var(--senec-yellow)] transition-colors flex items-center gap-2">
            Energiemanagement entdecken
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden order-1 md:order-2">
          <picture>
            <source srcset="/images/solarmanager-hero.webp" type="image/webp">
            <img src="/images/solarmanager-hero.webp" 
                 alt="Solarmanager App - Intelligentes Energiemanagement" 
                 class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                 loading="lazy">
          </picture>
        </div>
      </div>

      <!-- Stromspeicher -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden">
          <picture>
            <source srcset="/images/battery-storage.webp" type="image/webp">
            <source srcset="/images/battery-storage.png" type="image/png">
            <img src="/images/battery-storage.webp" 
                 alt="Stromspeicher" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 width="1226"
                 height="1143"
                 loading="lazy">
          </picture>
        </div>
        <div class="bg-white p-12 md:p-20 flex flex-col justify-center">
          <h3 class="text-2xl md:text-3xl font-bold text-[var(--senec-blue)] mb-6">Stromspeicher</h3>
          <p class="text-gray-600 mb-8 leading-relaxed">
            Machen Sie sich unabhängig von steigenden Strompreisen. Speichern Sie Ihren 
            Sonnenstrom für die Nacht oder bewölkte Tage. Unsere Speicherlösungen sind 
            intelligent, langlebig und modular erweiterbar.
          </p>
          <a href="/stromspeicher" class="text-[var(--senec-turquoise)] font-bold uppercase tracking-wider hover:text-[var(--senec-blue)] transition-colors flex items-center gap-2">
            Speicher entdecken
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Wallbox -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-[var(--senec-blue)] p-12 md:p-20 flex flex-col justify-center order-2 md:order-1 text-white">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">E-Mobilität</h3>
          <p class="text-gray-100 mb-8 leading-relaxed">
            Tanken Sie Sonne. Mit einer eigenen Wallbox laden Sie Ihr E-Auto bequem, 
            schnell und kostengünstig mit dem eigenen Solarstrom. Intelligentes 
            Lademanagement inklusive.
          </p>
          <a href="/wallbox" class="text-white font-bold uppercase tracking-wider hover:text-[var(--senec-yellow)] transition-colors flex items-center gap-2">
            Ladelösungen
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden order-1 md:order-2">
          <picture>
            <source srcset="/images/wallbox.webp" type="image/webp">
            <source srcset="/images/wallbox.png" type="image/png">
            <img src="/images/wallbox.webp" 
                 alt="Wallbox E-Auto" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 width="1226"
                 height="1143"
                 loading="lazy">
          </picture>
        </div>
      </div>
    </section>

    <!-- Solarmanager Teaser -->
    <section class="py-24 bg-white relative overflow-hidden">
      <div class="container-custom mx-auto relative z-10 text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 text-[var(--senec-blue)]">Solaranlage Leipzig – Alles im Blick mit dem Solarmanager</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-10 leading-relaxed">
          Mit dem Solarmanager haben Sie Ihre Energieflüsse jederzeit unter Kontrolle. 
          Optimieren Sie Ihren Eigenverbrauch und steuern Sie Ihre Geräte intelligent.
        </p>
        <a href="/solarmanager" class="btn-primary inline-flex items-center gap-2">
          Mehr erfahren
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <!-- CTA / Contact Section with Multi-Step Form -->
    <section id="kontakt" class="py-12 sm:py-16 md:py-24 bg-[#0a1628] w-full overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <!-- 2-Column Layout: Benefits Left, Form Right -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-start w-full">
          
          <!-- Left Column: Header & Benefits -->
          <div class="text-left">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-8 leading-tight">Photovoltaik Leipzig – Jetzt kostenlos beraten lassen</h2>
            <p class="text-xl text-gray-300 mb-12 leading-relaxed">
              Lassen Sie uns gemeinsam herausfinden, wie viel Sie sparen können. Fordern Sie jetzt Ihr unverbindliches Angebot an oder vereinbaren Sie einen Beratungstermin.
            </p>
            
            <!-- Benefits -->
            <div class="space-y-6">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-[#f5c518] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="font-bold text-white mb-2 text-lg">Kostenlose Wirtschaftlichkeitsberechnung</h3>
                  <p class="text-gray-300 text-base">Individuell für Ihr Dach und Ihren Verbrauch.</p>
                </div>
              </div>
              <div class="flex items-start">
                <svg class="w-6 h-6 text-[#f5c518] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="font-bold text-white mb-2 text-lg">Festpreis-Garantie</h3>
                  <p class="text-gray-300 text-base">Keine versteckten Kosten. Alles inklusive.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Multi-Step Form -->
          <MultiStepForm />
        </div>
      </div>
    </section>

    <!-- SEO Einleitungstext -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--senec-blue)] mb-6">Photovoltaik Leipzig – Ihr Partner für Solaranlagen in der Region</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Als führender Photovoltaik-Anbieter in Leipzig planen und installieren wir maßgeschneiderte Solaranlagen für Privathaushalte und Gewerbebetriebe. Mit über 2.400 realisierten Projekten in Leipzig und Umgebung sind wir Ihr erfahrener Partner für die Energiewende. Unsere zertifizierten Fachleute begleiten Sie von der ersten Beratung über die Planung bis zur schlüsselfertigen Installation Ihrer PV-Anlage.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Eine Photovoltaikanlage in Leipzig lohnt sich: Mit durchschnittlich 1.600 Sonnenstunden pro Jahr bietet die Region ideale Bedingungen für die Solarstromerzeugung. Kombiniert mit einem <a href="/stromspeicher" class="text-[var(--senec-turquoise)] hover:underline">Stromspeicher</a> und intelligentem <a href="/solarmanager" class="text-[var(--senec-turquoise)] hover:underline">Energiemanagement</a> erreichen Sie bis zu 80% Eigenverbrauch und senken Ihre Stromkosten nachhaltig.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Profitieren Sie von attraktiven Förderprogrammen und unserer Festpreis-Garantie. Ob <a href="/privat" class="text-[var(--senec-turquoise)] hover:underline">Solaranlage fürs Eigenheim</a>, <a href="/gewerbe" class="text-[var(--senec-turquoise)] hover:underline">PV-Anlage für Ihr Unternehmen</a> oder <a href="/wallbox" class="text-[var(--senec-turquoise)] hover:underline">Wallbox für Ihr E-Auto</a> – wir bieten Ihnen alles aus einer Hand. Fordern Sie jetzt Ihr kostenloses Angebot an und starten Sie Ihre persönliche Energiewende in Leipzig.
          </p>
        </div>
      </div>
    </section>

    <!-- Interne Verlinkung -->
    <section class="py-12 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-2xl font-bold text-[var(--senec-blue)] mb-8 text-center">Unsere Leistungen in Leipzig</h2>
        <div class="grid md:grid-cols-5 gap-4">
          <a href="/privat" class="bg-gray-50 p-6 rounded-lg hover:bg-gray-100 transition-colors text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Privatkunden</h3>
            <p class="text-gray-600 text-sm">Solaranlagen für Eigenheime</p>
          </a>
          <a href="/gewerbe" class="bg-gray-50 p-6 rounded-lg hover:bg-gray-100 transition-colors text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Gewerbekunden</h3>
            <p class="text-gray-600 text-sm">PV für Unternehmen</p>
          </a>
          <a href="/service" class="bg-gray-50 p-6 rounded-lg hover:bg-gray-100 transition-colors text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Service</h3>
            <p class="text-gray-600 text-sm">Wartung & Reparatur</p>
          </a>
          <a href="/referenzen" class="bg-gray-50 p-6 rounded-lg hover:bg-gray-100 transition-colors text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">Referenzen</h3>
            <p class="text-gray-600 text-sm">Über 2.400 Projekte</p>
          </a>
          <a href="/faq" class="bg-gray-50 p-6 rounded-lg hover:bg-gray-100 transition-colors text-center">
            <h3 class="font-bold text-[var(--senec-blue)] mb-2">FAQ</h3>
            <p class="text-gray-600 text-sm">Häufige Fragen</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <!-- Google Reviews Widget deaktiviert für Performance (Google Maps API zu schwer) -->
  
  <Footer />
</Layout>
