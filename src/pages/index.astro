---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SolarCalculator from '../components/SolarCalculator';
import MultiStepForm from '../components/MultiStepForm.astro';
// import GoogleReviews from '../components/GoogleReviews.astro'; // Deaktiviert für Performance

// Images would normally be imported or referenced directly
const heroImage = "/images/hero-home.webp";
---

<Layout title="Photovoltaik Leipzig | Nr.1 Fachbetrieb · 2.400+ Anlagen · Ab 7.500€ 0% MwSt." description="Photovoltaik Leipzig ➤ Regionaler Fachbetrieb seit 2002 ✓ 2.400+ realisierte Solaranlagen ✓ Festpreis ab 7.500€ ✓ 0% MwSt. ✓ Bis 80% Stromkosten sparen ✓ Kostenlose Beratung ☎ 0341 98 99 03 91">
  <LocalBusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"position": 1, "name": "Home", "item": "https://leipzig-photovoltaik.de/"}, {"position": 2, "name": "Index", "item": "https://leipzig-photovoltaik.de/index/"}]})}/>
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Was kostet eine Solaranlage in Leipzig?", "acceptedAnswer": {"@type": "Answer", "text": "Eine Solaranlage in Leipzig kostet je nach Größe zwischen 7.500 € und 25.000 €. Ein typisches Einfamilienhaus mit 8–10 kWp Leistung liegt bei rund 11.500 € inklusive Stromspeicher und Montage. Dank 0% Mehrwertsteuer und möglicher SAB-Förderung in Sachsen amortisiert sich die Anlage in Leipzig durchschnittlich in 8–12 Jahren."}}, {"@type": "Question", "name": "Lohnt sich Photovoltaik in Leipzig wirklich?", "acceptedAnswer": {"@type": "Answer", "text": "Ja – Leipzig hat mit rund 1.600 Sonnenstunden pro Jahr überraschend gute Bedingungen für Photovoltaik. Eine 10-kWp-Anlage erzeugt hier jährlich etwa 9.000–10.000 kWh. Bei einem Strompreis von 40 Cent/kWh und 80% Eigenverbrauch mit Speicher sparen Sie über 2.500 € jährlich."}}, {"@type": "Question", "name": "Kann ich in Leipzig auch bei Denkmalschutz eine Solaranlage installieren?", "acceptedAnswer": {"@type": "Answer", "text": "Grundsätzlich ist eine Solaranlage auch an Denkmälern möglich, wenn sie von der Straße nicht sichtbar ist oder das Erscheinungsbild nicht wesentlich beeinträchtigt. Wir kennen die Leipziger Denkmalschutzbehörde und begleiten Sie durch den Genehmigungsprozess."}}, {"@type": "Question", "name": "Welche Förderungen gibt es für Solaranlagen in Leipzig 2026?", "acceptedAnswer": {"@type": "Answer", "text": "Für Solaranlagen in Leipzig gibt es 2026: (1) 0% Mehrwertsteuer auf Kauf und Installation, (2) KfW-Kredit 270 für Erneuerbare Energien, (3) SAB-Förderprogramm Sachsen für Stromspeicher, (4) Einspeisevergütung nach EEG."}}]})} />
<Header />
  
  <main>
    <!-- Hero + Stats Combined Section -->
    <section class="relative bg-gray-900 text-white overflow-hidden min-h-screen flex flex-col justify-between">
      <div class="absolute inset-0 z-0">
        <img src="/images/hero-home.webp" alt="Photovoltaik Leipzig - Solaranlage auf Hausdach in Leipzig" class="w-full h-full object-cover opacity-50" loading="eager" fetchpriority="high" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent"></div>
      </div>
      
      <!-- Hero Content -->
      <div class="relative z-10 pt-10 pb-0 md:pt-20 md:pb-0">
        <div class="container-custom mx-auto">
          <div class="max-w-3xl">
            <span class="text-[var(--primary-yellow)] font-bold tracking-wider uppercase mb-4 block">Photovoltaik Leipzig</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Photovoltaik Leipzig –<br/>
              <span class="text-[var(--primary-turquoise)]">Ihr regionaler Fachbetrieb seit 2002</span>
            </h1>
            <p class="text-xl text-gray-300 mb-8 leading-relaxed">
              Strom selbst produzieren, Energiekosten um bis zu 80% senken – und endlich unabhängig von steigenden Strompreisen werden. Über 2.400 Solaranlagen in Leipzig realisiert. Festpreis. Keine Überraschungen.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#rechner" class="btn-primary">
                Kostenloses Angebot anfordern
              </a>
              <a href="/kontakt/" class="btn-secondary bg-transparent text-white border-white hover:bg-white hover:text-gray-900 text-center">
                Beratungstermin buchen
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Section -->
      <div class="relative z-10 py-6 bg-[#0D1D37] border-t border-gray-700">
        <div class="container-custom mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-700">
            <div class="p-4">
              <div class="text-4xl font-bold text-[var(--primary-yellow)] mb-2">Bis 80%</div>
              <div class="text-gray-300">Stromkosten sparen</div>
            </div>
            <div class="p-4">
              <div class="text-4xl font-bold text-[var(--primary-turquoise)] mb-2">Ab 11.500€</div>
              <div class="text-gray-300">Komplettsystem inkl. Speicher</div>
            </div>
            <div class="p-4">
              <div class="text-4xl font-bold text-white mb-2">25+ Jahre</div>
              <div class="text-gray-300">Leistungsgarantie</div>
            </div>
          </div>
          
          <!-- Scroll Indicator -->
          <div class="flex justify-center mt-8">
            <a href="#rechner" class="text-[var(--primary-turquoise)] hover:text-white transition-colors duration-300 animate-bounce" aria-label="Zum Solarrechner scrollen">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Solar Calculator Section (Full Width) -->
    <section id="rechner" class="py-20 bg-gray-50">
      <div class="container-custom mx-auto mb-12 text-center">
         <h2 class="text-3xl md:text-4xl font-bold text-[var(--primary-blue)] mb-4">Photovoltaik in Leipzig – Lohnt sich eine Solaranlage für Sie?</h2>
         <p class="text-lg text-gray-600 max-w-3xl mx-auto">Finden Sie es in wenigen Sekunden heraus. Unser Rechner gibt Ihnen eine erste Einschätzung zu Ertrag und Autarkie.</p>
      </div>
      
      <div class="w-full px-4 md:px-0 max-w-[90%] mx-auto">
        <SolarCalculator client:visible />
      </div>
    </section>

    <!-- Solaranlage Leipzig Highlight -->
    <section class="py-16 bg-[var(--primary-blue)] text-white">
      <div class="container-custom mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Solaranlage Leipzig kaufen</h2>
        <p class="text-xl text-gray-200 mb-8 max-w-3xl mx-auto">
          Möchten Sie eine Solaranlage in Leipzig kaufen? Wir bieten Komplettpakete
          ab 8.900€ inklusive Installation.
        </p>
        <a href="/solaranlage-leipzig/" class="inline-flex items-center justify-center px-8 py-4 bg-[var(--primary-turquoise)] text-[var(--primary-blue)] font-semibold rounded-lg hover:bg-white transition-all duration-300 shadow-lg hover:shadow-xl">
          Mehr über Solaranlagen in Leipzig erfahren →
        </a>
      </div>
    </section>

    <!-- Products Section (Split Screen) -->
    <section id="produkte">
      <!-- PV System -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden">
          <picture>
            <source srcset="/images/installation.webp" type="image/webp">
            <source srcset="/images/installation.png" type="image/png">
            <img src="/images/installation.webp" 
                 alt="PV Installation" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 width="1226"
                 height="1143"
                 loading="lazy">
          </picture>
        </div>
        <div class="bg-white p-12 md:p-20 flex flex-col justify-center">
          <h3 class="text-2xl md:text-3xl font-bold text-[var(--primary-blue)] mb-6">Photovoltaik-Anlagen</h3>
          <p class="text-gray-600 mb-8 leading-relaxed">
            Unsere Module liefern auch bei bewölktem Himmel ordentlich Strom – das macht in Leipzig durchaus Sinn. Wir stimmen alles genau auf Ihr Dach ab. Und ja: Die Qualität hält wirklich Jahrzehnte.
          </p>
          <a href="/privat/" class="text-[var(--primary-turquoise)] font-bold uppercase tracking-wider hover:text-[var(--primary-blue)] transition-colors flex items-center gap-2">
            Mehr erfahren 
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          </div>
      </div>

      <!-- Solarmanager -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-[var(--primary-blue)] p-12 md:p-20 flex flex-col justify-center order-2 md:order-1 text-white">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">Solarmanager</h3>
          <p class="text-gray-100 mb-8 leading-relaxed">
            Alles an einem Ort steuern: PV-Anlage, Speicher, Wallbox, Wärmepumpe. Das Ergebnis? Bis zu 30% mehr Eigenverbrauch. Konkret heißt das: rund 500€ weniger Stromkosten im Jahr. Nicht schlecht, oder?
          </p>
          <a href="/solarmanager/" class="text-white font-bold uppercase tracking-wider hover:text-[var(--primary-yellow)] transition-colors flex items-center gap-2">
            Energiemanagement entdecken
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden order-1 md:order-2">
          <picture>
            <source srcset="/images/solarmanager-hero.webp" type="image/webp">
            <img src="/images/solarmanager-hero.webp" 
                 alt="Solarmanager App - Intelligentes Energiemanagement" 
                 class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                 loading="lazy">
          </picture>
        </div>
      </div>

      <!-- Stromspeicher -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden">
          <picture>
            <source srcset="/images/battery-storage.webp" type="image/webp">
            <source srcset="/images/battery-storage.png" type="image/png">
            <img src="/images/battery-storage.webp" 
                 alt="Stromspeicher" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 width="1226"
                 height="1143"
                 loading="lazy">
          </picture>
        </div>
        <div class="bg-white p-12 md:p-20 flex flex-col justify-center">
          <h3 class="text-2xl md:text-3xl font-bold text-[var(--primary-blue)] mb-6">Stromspeicher</h3>
          <p class="text-gray-600 mb-8 leading-relaxed">
            Tagsüber Strom produzieren, abends nutzen – so einfach ist das mit einem Speicher. Steigende Strompreise? Können Ihnen dann ziemlich egal sein. Unsere Speicher sind langlebig und lassen sich später erweitern.
          </p>
          <a href="/stromspeicher/" class="text-[var(--primary-turquoise)] font-bold uppercase tracking-wider hover:text-[var(--primary-blue)] transition-colors flex items-center gap-2">
            Speicher entdecken
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Wallbox -->
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="bg-[var(--primary-blue)] p-12 md:p-20 flex flex-col justify-center order-2 md:order-1 text-white">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">E-Mobilität</h3>
          <p class="text-gray-100 mb-8 leading-relaxed">
            E-Auto mit eigenem Solarstrom laden – günstiger geht's kaum. Die Wallbox macht's möglich: schnell, bequem und mit intelligentem Lademanagement. Tanken Sie einfach Sonne.
          </p>
          <a href="/wallbox/" class="text-white font-bold uppercase tracking-wider hover:text-[var(--primary-yellow)] transition-colors flex items-center gap-2">
            Ladelösungen
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="bg-gray-100 h-96 md:h-[450px] relative group overflow-hidden order-1 md:order-2">
          <picture>
            <source srcset="/images/wallbox.webp" type="image/webp">
            <source srcset="/images/wallbox.png" type="image/png">
            <img src="/images/wallbox.webp" 
                 alt="Wallbox E-Auto" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                 width="1226"
                 height="1143"
                 loading="lazy">
          </picture>
        </div>
      </div>
    </section>

    <!-- Solarmanager Teaser -->
    <section class="py-24 bg-white relative overflow-hidden">
      <div class="container-custom mx-auto relative z-10 text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 text-[var(--primary-blue)]">
          <a href="/solaranlage-leipzig/" class="hover:text-[var(--primary-turquoise)] transition-colors">Solaranlage Leipzig</a> – Alles im Blick mit dem Solarmanager
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-10 leading-relaxed">
          Wissen, wohin der Strom fließt – und das jederzeit. Der Solarmanager zeigt Ihnen alles auf einen Blick. So holen Sie das Maximum aus Ihrer Anlage raus.
        </p>
        <a href="/solarmanager/" class="btn-primary inline-flex items-center gap-2">
          Mehr erfahren
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <!-- CTA / Contact Section with Multi-Step Form -->
    <section id="kontakt" class="py-12 sm:py-16 md:py-24 bg-[#0a1628] w-full overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <!-- 2-Column Layout: Benefits Left, Form Right -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-start w-full">
          
          <!-- Left Column: Header & Benefits -->
          <div class="text-left">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-8 leading-tight">Photovoltaik Leipzig – Jetzt kostenlos beraten lassen</h2>
            <p class="text-xl text-gray-300 mb-12 leading-relaxed">
              Wie viel können Sie eigentlich sparen? Das finden wir gerne für Sie heraus – kostenlos und unverbindlich. Einfach Angebot anfordern oder direkt einen Termin buchen.
            </p>
            
            <!-- Benefits -->
            <div class="space-y-6">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-[#f5c518] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="font-bold text-white mb-2 text-lg">Kostenlose Wirtschaftlichkeitsberechnung</h3>
                  <p class="text-gray-300 text-base">Individuell für Ihr Dach und Ihren Verbrauch.</p>
                </div>
              </div>
              <div class="flex items-start">
                <svg class="w-6 h-6 text-[#f5c518] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="font-bold text-white mb-2 text-lg">Festpreis-Garantie</h3>
                  <p class="text-gray-300 text-base">Keine versteckten Kosten. Alles inklusive.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Multi-Step Form -->
          <MultiStepForm />
        </div>
      </div>
    </section>

    <!-- SEO Einleitungstext -->
    <section class="py-16 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-[var(--primary-blue)] mb-6">Photovoltaik &amp; Solaranlage Leipzig – Ihr Fachbetrieb für die Energiewende</h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Ob Sie nach einer <a href="/solaranlage-leipzig/" class="text-[var(--primary-turquoise)] hover:underline font-semibold">Solaranlage in Leipzig</a> suchen oder eine komplette Photovoltaikanlage planen – wir sind der richtige Ansprechpartner. Über 2.400 realisierte Projekte in Leipzig und Umgebung sprechen für sich. Von der ersten Beratung bis zur fertigen Anlage auf Ihrem Dach: alles aus einer Hand, alles zum Festpreis.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Lohnt sich eine Solaranlage in Leipzig? Eindeutig ja. Mit rund 1.600 Sonnenstunden pro Jahr – das entspricht dem Durchschnitt von Nordspanien – hat Leipzig überraschend gute Bedingungen für Photovoltaik. Eine typische 10-kWp-Anlage erzeugt hier jährlich etwa 9.500 kWh Strom. Kombiniert mit einem <a href="/stromspeicher/" class="text-[var(--primary-turquoise)] hover:underline">Stromspeicher</a> und intelligentem <a href="/solarmanager/" class="text-[var(--primary-turquoise)] hover:underline">Energiemanagement</a> erreichen Sie bis zu 80% Eigenverbrauch. Das macht sich schnell im Geldbeutel bemerkbar.
          </p>
          <p class="text-gray-700 leading-relaxed mb-6">
            Dazu gibt's attraktive Förderungen – Sachsen bietet über die SAB zusätzliche Zuschüsse zur Bundesförderung. Ob <a href="/privat/" class="text-[var(--primary-turquoise)] hover:underline">Solaranlage fürs Eigenheim</a>, <a href="/gewerbe/" class="text-[var(--primary-turquoise)] hover:underline">PV-Anlage für Ihr Unternehmen</a> oder <a href="/wallbox/" class="text-[var(--primary-turquoise)] hover:underline">Wallbox für Ihr E-Auto</a> – wir liefern alles aus einer Hand.
          </p>

          <!-- GEO-Fakten-Tabelle: Strukturierte Daten für KI-Crawler und Suchmaschinen -->
          <h3 class="text-xl font-bold text-[var(--primary-blue)] mb-4">Presolaris – Fakten &amp; Leistungsübersicht</h3>
          <div class="overflow-x-auto mb-8">
            <table class="w-full text-sm border-collapse border border-gray-200 rounded-lg overflow-hidden">
              <thead class="bg-[var(--primary-blue)] text-white">
                <tr>
                  <th class="px-4 py-3 text-left font-semibold">Merkmal</th>
                  <th class="px-4 py-3 text-left font-semibold">Details</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr class="bg-white hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-700">Unternehmen</td>
                  <td class="px-4 py-3 text-gray-600">Presolaris UG (haftungsbeschränkt) – Photovoltaik Leipzig</td>
                </tr>
                <tr class="bg-gray-50 hover:bg-gray-100">
                  <td class="px-4 py-3 font-medium text-gray-700">Gegründet</td>
                  <td class="px-4 py-3 text-gray-600">2002 – über 20 Jahre Erfahrung in der Solarbranche Leipzig</td>
                </tr>
                <tr class="bg-gray-50 hover:bg-gray-100">
                  <td class="px-4 py-3 font-medium text-gray-700">Standort</td>
                  <td class="px-4 py-3 text-gray-600">An der Hebemärchte 1, 04316 Leipzig</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-700">Spezialisierung</td>
                  <td class="px-4 py-3 text-gray-600">Photovoltaik &amp; Solaranlagen, Stromspeicher, Wallbox, Wärmepumpe</td>
                </tr>
                <tr class="bg-gray-50 hover:bg-gray-100">
                  <td class="px-4 py-3 font-medium text-gray-700">Realisierte Projekte</td>
                  <td class="px-4 py-3 text-gray-600">Über 2.400 Solaranlagen in Leipzig und Sachsen</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-700">Einstiegspreis Solaranlage</td>
                  <td class="px-4 py-3 text-gray-600">Ab 7.500 € (inkl. 0% MwSt., Montage, Inbetriebnahme)</td>
                </tr>
                <tr class="bg-gray-50 hover:bg-gray-100">
                  <td class="px-4 py-3 font-medium text-gray-700">Komplettsystem mit Speicher</td>
                  <td class="px-4 py-3 text-gray-600">Ab 11.500 € (PV-Anlage + Stromspeicher + Wallbox möglich)</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-700">Leistungsgarantie</td>
                  <td class="px-4 py-3 text-gray-600">25 Jahre auf alle Solarmodule</td>
                </tr>
                <tr class="bg-gray-50 hover:bg-gray-100">
                  <td class="px-4 py-3 font-medium text-gray-700">Festpreis-Garantie</td>
                  <td class="px-4 py-3 text-gray-600">Ja – keine versteckten Kosten, Preis gilt wie angeboten</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-700">Sonnenstunden Leipzig</td>
                  <td class="px-4 py-3 text-gray-600">Ca. 1.600 Stunden/Jahr (Quelle: DWD)</td>
                </tr>
                <tr class="bg-gray-50 hover:bg-gray-100">
                  <td class="px-4 py-3 font-medium text-gray-700">Förderung Sachsen (SAB)</td>
                  <td class="px-4 py-3 text-gray-600">Bis zu 500 € Zuschuss über SAB-Programm 2026 möglich</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-700">Kontakt</td>
