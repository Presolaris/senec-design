---
import Layout from '../layouts/Layout.astro';
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Solarmanager' }
];
---

<Layout 
  title="Solarmanager Leipzig | Intelligentes Energiemanagement | Presolaris" 
  description="Optimieren Sie Ihren Eigenverbrauch mit dem Solarmanager. Intelligente Steuerung für Photovoltaik, Stromspeicher, Wallbox und Wärmepumpe. Jetzt in Leipzig beraten lassen!">
    <LocalBusinessSchema />
  <Header />
  <Breadcrumb items={breadcrumbItems} />
  
  <!-- Schema.org BreadcrumbList strukturierte Daten -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://leipzig-photovoltaik.de/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Solarmanager",
        "item": "https://leipzig-photovoltaik.de/solarmanager"
      }
    ]
  }
  </script>
  
  <main>
    <!-- Hero Section mit neuem Bild -->
    <section class="relative bg-gradient-to-br from-[#0D1D37] via-[#1a2f4d] to-[#0D1D37] text-white py-24 md:py-32 overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0 bg-[url('/images/grid-pattern.svg')] bg-repeat"></div>
      </div>
      
      <div class="container-custom mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h1 class="text-4xl md:text-6xl font-bold mb-6">Solarmanager</h1>
            <p class="text-2xl md:text-3xl text-[var(--senec-turquoise)] mb-6 font-medium">
              Eigenverbrauch optimieren
            </p>
            <p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed">
              Intelligentes Energiemanagement für maximale Unabhängigkeit. Steuern Sie Photovoltaik, Stromspeicher, Wallbox und Wärmepumpe zentral – für bis zu 30% mehr Eigenverbrauch.
            </p>
            <a href="/#kontakt" class="btn-accent inline-block">
              Jetzt Beratung anfordern
            </a>
          </div>
          <div class="relative">
            <img 
              src="/images/solarmanager-hero.webp" 
              alt="Solarmanager App auf Smartphone mit Energiefluss-Dashboard" 
              class="w-full max-w-md mx-auto drop-shadow-2xl"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Intro mit Dashboard-Bild -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="order-2 lg:order-1">
            <img 
              src="/images/solarmanager-dashboard.webp" 
              alt="Solarmanager Dashboard mit Echtzeit-Metriken" 
              class="w-full rounded-lg shadow-lg"
              loading="lazy"
            />
          </div>
          <div class="order-1 lg:order-2">
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-6">Energie intelligent nutzen</h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
              Der Solarmanager verbindet Ihre Photovoltaikanlage, den Stromspeicher, die Wallbox 
              und weitere Verbraucher wie Wärmepumpen oder Heizstäbe zu einem intelligenten Gesamtsystem.
            </p>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
              <strong class="text-[var(--senec-blue)]">Das Ziel:</strong> Maximaler Eigenverbrauch und minimale Stromkosten. 
              Durch intelligente Steuerung nutzen Sie bis zu 80% Ihres selbst produzierten Solarstroms direkt im Haushalt.
            </p>
            <div class="bg-[var(--senec-turquoise)] bg-opacity-10 border-l-4 border-[var(--senec-turquoise)] p-6 rounded">
              <p class="text-lg font-semibold text-[var(--senec-blue)]">
                ✓ Bis zu 30% mehr Eigenverbrauch<br>
                ✓ Bis zu 500€ Stromkosten-Ersparnis pro Jahr<br>
                ✓ Echtzeit-Monitoring per App
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wie funktioniert's - Infografik -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] text-center mb-12">Wie funktioniert der Solarmanager?</h2>
        <div class="max-w-5xl mx-auto">
          <img 
            src="/images/solarmanager-infographic.webp" 
            alt="Infografik: Wie funktioniert Solarmanager - Produktion, Verteilung, Optimierung" 
            class="w-full"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 max-w-5xl mx-auto">
          <div class="text-center">
            <div class="bg-[var(--senec-yellow)] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-white">1</span>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Produktion</h3>
            <p class="text-gray-600">
              Ihre Solaranlage erzeugt Strom aus Sonnenlicht. Der Solarmanager erfasst die aktuelle Produktion in Echtzeit.
            </p>
          </div>
          <div class="text-center">
            <div class="bg-[var(--senec-turquoise)] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-white">2</span>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Verteilung</h3>
            <p class="text-gray-600">
              Der Solarmanager verteilt den Strom intelligent an Verbraucher, Speicher und E-Auto – je nach Bedarf und Verfügbarkeit.
            </p>
          </div>
          <div class="text-center">
            <div class="bg-[var(--senec-orange)] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-white">3</span>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Optimierung</h3>
            <p class="text-gray-600">
              Maximierte Einsparungen durch reduzierten Netzbezug und optimale Nutzung des Solarstroms. Bis zu 500€ Ersparnis pro Jahr.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Vergleich: Mit vs. Ohne Solarmanager -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] text-center mb-12">Der Unterschied ist messbar</h2>
        <div class="max-w-5xl mx-auto">
          <img 
            src="/images/solarmanager-comparison.webp" 
            alt="Vergleich: Ohne vs. Mit Solarmanager - Stromkosten-Ersparnis visualisiert" 
            class="w-full rounded-lg shadow-lg"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 max-w-4xl mx-auto">
          <div class="bg-red-50 border-2 border-red-200 p-8 rounded-lg">
            <h3 class="text-2xl font-bold text-red-700 mb-4">❌ Ohne Solarmanager</h3>
            <ul class="space-y-3 text-gray-700">
              <li>• Viel Solarstrom wird ins Netz eingespeist (geringe Vergütung)</li>
              <li>• Verbraucher laufen unkoordiniert</li>
              <li>• Hoher Netzbezug in Spitzenzeiten</li>
              <li>• Eigenverbrauch nur 30-40%</li>
              <li>• Stromkosten: ~200€/Monat</li>
            </ul>
          </div>
          <div class="bg-green-50 border-2 border-green-200 p-8 rounded-lg">
            <h3 class="text-2xl font-bold text-green-700 mb-4">✅ Mit Solarmanager</h3>
            <ul class="space-y-3 text-gray-700">
              <li>• Solarstrom wird intelligent im Haus genutzt</li>
              <li>• Verbraucher schalten bei Überschuss automatisch</li>
              <li>• Minimaler Netzbezug durch Speicher-Optimierung</li>
              <li>• Eigenverbrauch bis zu 70-80%</li>
              <li>• Stromkosten: ~80€/Monat <strong class="text-green-700">(Ersparnis: 120€/Monat)</strong></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] text-center mb-16">Funktionen im Überblick</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Feature 1 -->
          <div class="bg-white p-8 shadow-sm border-t-4 border-[var(--senec-orange)] hover:shadow-md transition-shadow">
            <div class="text-[var(--senec-orange)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Visualisierung</h3>
            <p class="text-gray-600">
              Echtzeit-Daten zu Produktion, Verbrauch und Einspeisung. Übersichtlich aufbereitet in App und Web-Portal.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="bg-white p-8 shadow-sm border-t-4 border-[var(--senec-turquoise)] hover:shadow-md transition-shadow">
            <div class="text-[var(--senec-turquoise)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Optimierung</h3>
            <p class="text-gray-600">
              Automatische Verteilung des Solarstroms an die Verbraucher, wenn die Sonne scheint. Erhöht Ihren Autarkiegrad signifikant.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="bg-white p-8 shadow-sm border-t-4 border-[var(--senec-yellow)] hover:shadow-md transition-shadow">
            <div class="text-[var(--senec-yellow)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Gerätesteuerung</h3>
            <p class="text-gray-600">
              Intelligente Ansteuerung von Wärmepumpen, Heizstäben und Klimaanlagen über standardisierte Schnittstellen.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="bg-white p-8 shadow-sm border-t-4 border-[var(--senec-blue)] hover:shadow-md transition-shadow">
            <div class="text-[var(--senec-blue)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Prognosebasiert</h3>
            <p class="text-gray-600">
              Berücksichtigt Wetterprognosen für vorausschauendes Laden des Speichers und Steuern der Verbraucher.
            </p>
          </div>

          <!-- Feature 5 -->
          <div class="bg-white p-8 shadow-sm border-t-4 border-[var(--senec-orange)] hover:shadow-md transition-shadow">
            <div class="text-[var(--senec-orange)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Einfachheit</h3>
            <p class="text-gray-600">
              Intuitive Bedienung und Einrichtung. Keine komplexen Programmierkenntnisse erforderlich.
            </p>
          </div>

          <!-- Feature 6 -->
          <div class="bg-white p-8 shadow-sm border-t-4 border-[var(--senec-turquoise)] hover:shadow-md transition-shadow">
            <div class="text-[var(--senec-turquoise)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">Cloud-basiert</h3>
            <p class="text-gray-600">
              Zugriff von überall per App oder Browser. Automatische Updates und Backups inklusive.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- App-Mockups -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] text-center mb-12">Alles im Blick – per App</h2>
        <div class="max-w-5xl mx-auto">
          <img 
            src="/images/solarmanager-app-mockup.webp" 
            alt="Solarmanager App Screenshots - Dashboard, Gerätesteuerung, Statistiken" 
            class="w-full"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 max-w-4xl mx-auto text-center">
          <div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">📊 Live-Dashboard</h3>
            <p class="text-gray-600">
              Sehen Sie in Echtzeit, wie viel Strom produziert, verbraucht und gespeichert wird.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">🎛️ Gerätesteuerung</h3>
            <p class="text-gray-600">
              Schalten Sie Verbraucher manuell oder automatisch bei Solarüberschuss.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[var(--senec-blue)] mb-3">📈 Statistiken</h3>
            <p class="text-gray-600">
              Verfolgen Sie Ihre Einsparungen, CO₂-Reduktion und Autarkie-Entwicklung.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Hardware -->
    <section class="py-20 bg-gray-50">
      <div class="container-custom mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] mb-6">Kompakte Hardware</h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
              Das Solarmanager-Gateway ist die zentrale Steuereinheit Ihres Energiemanagements. 
              Kompakt, leise und energieeffizient – einfach an Ihren Router anschließen und loslegen.
            </p>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span><strong>Plug & Play:</strong> Einfache Installation ohne Fachkenntnisse</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span><strong>Kompakt:</strong> Nur 15 x 10 cm, passt überall hin</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-[var(--senec-turquoise)] mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span><strong>Sicher:</strong> Verschlüsselte Datenübertragung</span>
              </li>
            </ul>
          </div>
          <div class="text-center">
            <img 
              src="/images/solarmanager-hardware.webp" 
              alt="Solarmanager Gateway Hardware - Kompaktes Energiemanagement-Gerät" 
              class="w-full max-w-md mx-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Compatible Devices -->
    <section class="py-20 bg-white">
      <div class="container-custom mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--senec-blue)] text-center mb-12">Kompatibilität</h2>
        <p class="text-lg text-gray-600 text-center mb-12 max-w-3xl mx-auto">
          Der Solarmanager ist mit über 200 Geräten und Herstellern kompatibel. 
          Egal ob Fronius, SMA, SENEC oder Kostal – wir integrieren Ihr System nahtlos.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div class="p-6 bg-gray-50 rounded-lg hover:shadow-md transition-shadow">
            <div class="text-4xl mb-3">⚡</div>
            <h4 class="font-bold text-lg mb-2">Wechselrichter</h4>
            <p class="text-sm text-gray-500">Fronius, SMA, Kostal, SolarEdge, Sungrow, Huawei u.v.m.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-lg hover:shadow-md transition-shadow">
            <div class="text-4xl mb-3">🔥</div>
            <h4 class="font-bold text-lg mb-2">Wärmepumpen</h4>
            <p class="text-sm text-gray-500">Stiebel Eltron, Vaillant, Viessmann, Bosch, IDM u.v.m.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-lg hover:shadow-md transition-shadow">
            <div class="text-4xl mb-3">🚗</div>
            <h4 class="font-bold text-lg mb-2">Ladestationen</h4>
            <p class="text-sm text-gray-500">KEBA, Mennekes, ABL, go-e, Easee, Zaptec u.v.m.</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-lg hover:shadow-md transition-shadow">
            <div class="text-4xl mb-3">🏠</div>
            <h4 class="font-bold text-lg mb-2">Smart Home</h4>
            <p class="text-sm text-gray-500">Shelly, myStrom, Philips Hue, Tado u.v.m.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gradient-to-br from-[var(--senec-blue)] to-[#1a2f4d] text-white text-center">
      <div class="container-custom mx-auto max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Starten Sie jetzt in die Zukunft</h2>
        <p class="text-xl text-gray-300 mb-10">
          Machen Sie Ihr Zuhause smart und effizient. Wir beraten Sie gerne zur Integration des Solarmanagers in Ihr System – kostenlos und unverbindlich.
        </p>
        <a href="/#kontakt" class="btn-accent inline-block text-lg px-8 py-4">
          Jetzt kostenlose Beratung anfordern
        </a>
        <p class="text-sm text-gray-400 mt-6">
          ✓ Vor-Ort-Beratung in Leipzig • ✓ Individuelle Systemanalyse • ✓ Professionelle Installation
        </p>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
